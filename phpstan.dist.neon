parameters:
    level: 6
    paths:
        - src/
        - tests/
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # ── Entities ─────────────────────────────────────────────────────────
        # Doctrine assigns $id via reflection — PHPStan cannot detect it
        - identifier: property.unusedType
          path: src/Entity/*

        # ── Controllers & Security ────────────────────────────────────────────
        # Symfony's getUser() returns UserInterface, but in this app it is always App\Entity\User.
        # Fixing every call site with assert() is out of scope; suppress argument.type globally.
        - identifier: argument.type
          path: src/Controller/*
        - identifier: argument.type
          path: src/Security/*
        # method.notFound on UserInterface (getTeams, getPlayerProfile, etc.) — same reason
        - identifier: method.notFound
          path: src/Controller/*
        - identifier: method.notFound
          path: src/Security/*

        # ── Repositories ─────────────────────────────────────────────────────
        # Auto-generated @method stubs in Doctrine repositories use untyped arrays
        - identifier: missingType.iterableValue
          path: src/Repository/*
        - identifier: missingType.generics
          path: src/Repository/*
        - identifier: missingType.return
          path: src/Repository/*
        - identifier: missingType.parameter
          path: src/Repository/*

        # ── Controllers – missing iterable types ──────────────────────────────
        - identifier: missingType.iterableValue
          path: src/Controller/*

        # ── DTO ──────────────────────────────────────────────────────────────
        - identifier: missingType.iterableValue
          path: src/Dto/*



        # ── offsetAccess sur résultats DQL mixtes (Doctrine scalaire+entité) ───
        # DQL avec scalaires retourne mixed[] — PHPStan ne peut pas typer $row[0]/$row['key']
        - identifier: offsetAccess.notFound
          path: src/Controller/ForumController.php
        - identifier: offsetAccess.notFound
          path: src/Controller/AdminController.php

        - identifier: method.unused
          path: src/Controller/AdminController.php

        # ── Always-true / always-false from PHPDoc types ─────────────────────
        - identifier: booleanNot.alwaysFalse
          path: src/Controller/*
        - identifier: identical.alwaysTrue
          path: src/Controller/*

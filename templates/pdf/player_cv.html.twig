<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Gamer CV — {{ user.pseudo }}</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        @page {
            margin: 0;
            size: A4 portrait;
        }

        body {
            font-family: "DejaVu Sans", sans-serif;
            background: #070810;
            color: #ffffff;
            font-size: 13px;
            line-height: 1.3;
        }

        /* ==============================
           FULL-PAGE CONTAINER
           ============================== */
        .cv-page {
            width: 210mm;
            height: 297mm;
            position: relative;
            overflow: hidden;
            background: #070810;
        }

        /* ==============================
           BACKGROUND IMAGE
           ============================== */
        .bg-img {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            object-fit: cover;
            opacity: 1;
            z-index: 0;
        }

        /* Dark overlay on BOTTOM half so widgets are readable */
        .bg-overlay {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 70%;
            background: linear-gradient(to bottom, transparent 0%, rgba(5,6,14,0.96) 30%);
            z-index: 1;
        }

        /* ==============================
           CONTENT LAYER
           ============================== */
        .content {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 2;
            display: block;
            padding: 0;
        }

        /* ==============================
           HEADER (top-left over image)
           ============================== */
        .header {
            position: absolute;
            top: 220px;   /* pushed down to clear game logo + breathing room */
            left: 70px;
            width: 80%;   /* keep right side free for character art */
        }

        .player-row {
            margin-bottom: 6px;
        }
        .pseudo {
            font-size: 40px;
            font-weight: bold;
            display: inline-block;
            vertical-align: middle;
        }
        .badge {
            display: inline-block;
            vertical-align: middle;
            background: rgba(0,255,157,0.15);
            border: 1px solid rgba(0,255,157,0.4);
            color: #00ff9d;
            font-size: 10px;
            padding: 3px 10px;
            border-radius: 20px;
            margin-left: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .rank-line {
            font-size: 20px;
            color: #00ff9d;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 8px;
        }
        .meta-line {
            font-size: 15px;
            color: rgba(255,255,255,0.5);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .meta-sep { margin: 0 8px; color: rgba(255,255,255,0.2); }

        /* ==============================
           WIDGETS AREA (below fold)
           ============================== */
        .widgets {
            position: absolute;
            top: 500px;   /* start below header + character visible zone */
            left: 25px;
            right: 25px;
            bottom: 35px; /* leave footer space */
        }

        /* ---- Generic Widget ---- */
        .widget {
            background: rgba(7,8,16,0.82);
            border: 1px solid rgba(255,255,255,0.09);
            border-radius: 7px;
            padding: 18px 20px;
        }
        .widget-title {
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: rgba(255,255,255,0.65);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding-bottom: 9px;
            margin-bottom: 14px;
        }

        /* ---- Performance Analytics ---- */
        .analytics-row {
            display: table;
            width: 100%;
            table-layout: fixed;
            margin-bottom: 14px;
        }
        .analytics-col {
            display: table-cell;
            text-align: left;
            vertical-align: top;
            padding-right: 8px;
        }
        .a-label {
            font-size: 16px;
            color: rgba(255,255,255,0.45);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }
        .a-value { font-size: 26px; font-weight: bold; }
        .green  { color: #00ff9d; }
        .orange { color: #f0a03a; }

        /* ---- Middle row (Tactical + Specialized) ---- */
        .mid-row {
            display: table;
            width: 100%;
            table-layout: fixed;
            border-spacing: 12px 0;
            margin: 0 -12px;
            margin-bottom: 12px;
        }
        .mid-left  { display: table-cell; width: 57%; vertical-align: top; }
        .mid-right { display: table-cell; width: 41%; vertical-align: top; }

        /* Progress bars */
        .prog-item { margin-bottom: 12px; }
        .prog-label { font-size: 16px; text-transform: uppercase; color: rgba(255,255,255,0.5); letter-spacing: 1px; margin-bottom: 5px; }
        .prog-bg { background: rgba(255,255,255,0.1); height: 6px; border-radius: 3px; }
        .prog-fill { height: 100%; background: linear-gradient(to right, #00ff9d, #00cc7a); border-radius: 3px; }

        .scouting {
            margin-top: 12px;
            padding: 12px 14px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 5px;
            font-style: italic;
            font-size: 13px;
            color: rgba(255,255,255,0.7);
            line-height: 1.6;
        }

        /* Specialized */
        .spec-row { display: table; width: 100%; }
        .spec-cell { display: table-cell; width: 50%; vertical-align: top; }
        .spec-val { font-size: 32px; font-weight: bold; color: #f0a03a; margin-top: 4px; }
        .spec-name { font-size: 20px; font-weight: bold; margin-top: 4px; }

        /* ---- Recent Engagement ---- */
        .recent-table { width: 100%; border-collapse: collapse; }
        .recent-table th {
            text-align: left;
            font-size: 16px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.35);
            padding: 7px 10px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .recent-table td {
            padding: 11px 10px;
            font-size: 18px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        /* ==============================
           FOOTER
           ============================== */
        .footer {
            position: absolute;
            bottom: 10px;
            left: 25px;
            right: 25px;
            font-size: 10px;
            color: rgba(255,255,255,0.35);
            text-align: center;
            border-top: 1px solid rgba(255,255,255,0.07);
            padding-top: 6px;
        }

    </style>
</head>
<body>

<div class="cv-page">

    {# ── BACKGROUND ── #}
    {% if base64Bg %}
    <img class="bg-img" src="{{ base64Bg }}" alt="">
    {% endif %}
    <div class="bg-overlay"></div>

    <div class="content">

        {# ══════════════════════════════
           1. HEADER
           ══════════════════════════════ #}
        <div class="header">
            <div class="player-row">
                <span class="pseudo">{{ user.pseudo|upper }}</span>
                <span class="badge">{{ cvData.perf.overallRating }}</span>
            </div>
            <div class="rank-line">
                {{ cvData.rank.tier ?? 'UNRANKED' }} — PERFORMANCE ANALYSIS
            </div>
            <div class="meta-line">
                <span>Region {{ cvData.user.region }}</span>
                <span class="meta-sep">|</span>
                <span>{{ cvData.user.email }}</span>
                <span class="meta-sep">|</span>
                <span>{{ cvData.user.mainRole }}</span>
            </div>
        </div>

        {# ══════════════════════════════
           WIDGETS
           ══════════════════════════════ #}
        <div class="widgets">

            {# ── 2. PERFORMANCE ANALYTICS ── #}
            <div class="widget" style="margin-bottom: 12px;">
                <div class="widget-title">Performance Analytics</div>
                <div class="analytics-row">
                    <div class="analytics-col">
                        <div class="a-label">Performance Score</div>
                        <div class="a-value green">{{ cvData.perf.performanceScore }}/100</div>
                    </div>
                    <div class="analytics-col">
                        <div class="a-label">Win Rate</div>
                        <div class="a-value">{{ cvData.perf.winRate }}%</div>
                    </div>
                    <div class="analytics-col">
                        <div class="a-label">{{ game == 'cs2' ? 'K/D Ratio' : 'Average KDA' }}</div>
                        <div class="a-value">{{ cvData.perf.avgKda }}</div>
                    </div>
                    <div class="analytics-col">
                        <div class="a-label">Classification</div>
                        <div class="a-value green">{{ cvData.perf.performanceIndicator|upper }}</div>
                    </div>
                    <div class="analytics-col">
                        <div class="a-label">Sample Size</div>
                        <div class="a-value">{{ cvData.perf.matchCount }} Games</div>
                    </div>
                </div>
            </div>

            {# ── 3. TACTICAL PROFILE + SPECIALIZED METRICS ── #}
            <div class="mid-row">

                {# Left: Tactical Profile #}
                <div class="mid-left">
                    <div class="widget">
                        <div class="widget-title">Tactical Profile</div>

                        {% set mechanics = cvData.perf.avgKda > 3 ? 92 : 75 %}
                        {% set gamesense = cvData.perf.winRate > 55 ? 88 : 68 %}
                        {% set impact = (cvData.perf.advancedMetrics.avgDamage|default(0) > 20000) or (cvData.perf.advancedMetrics.avgAcs|default(0) > 220) ? 90 : 72 %}

                        <div class="prog-item">
                            <div class="prog-label">Mechanics</div>
                            <div class="prog-bg"><div class="prog-fill" style="width:{{ mechanics }}%;"></div></div>
                        </div>
                        <div class="prog-item">
                            <div class="prog-label">Game Sense</div>
                            <div class="prog-bg"><div class="prog-fill" style="width:{{ gamesense }}%;"></div></div>
                        </div>
                        <div class="prog-item">
                            <div class="prog-label">Impact</div>
                            <div class="prog-bg"><div class="prog-fill" style="width:{{ impact }}%;"></div></div>
                        </div>

                        <div class="scouting">{{ cvData.summary }}</div>
                    </div>
                </div>

                {# Right: Specialized Metrics #}
                <div class="mid-right">
                    <div class="widget">
                        <div class="widget-title">Specialized Metrics</div>
                        <div class="spec-row">
                            <div class="spec-cell">
                                <div class="a-label">Primary {{ game == 'lol' ? 'Champ' : (game == 'valorant' ? 'Agent' : 'Role') }}</div>
                                <div class="spec-name">{{ cvData.perf.mostPlayed.name }}</div>
                            </div>
                            <div class="spec-cell">
                                <div class="a-label">
                                    {% if game == 'lol' %}Avg CS/Min
                                    {% elseif game == 'valorant' %}Avg ACS
                                    {% else %}HS Rate{% endif %}
                                </div>
                                <div class="spec-val">
                                    {% if game == 'lol' %}{{ cvData.perf.advancedMetrics.avgCsMin|default('0') }}
                                    {% elseif game == 'valorant' %}{{ cvData.perf.advancedMetrics.avgAcs|default('0') }}
                                    {% else %}{{ cvData.perf.advancedMetrics.hsPercent|default('0') }}%{% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>{# /mid-row #}

            {# ── 4. RECENT ENGAGEMENT ── #}
            {% if cvData.perf.recentMatches %}
            <div class="widget">
                <div class="widget-title">Recent Engagement</div>
                <table class="recent-table">
                    <thead>
                        <tr>
                            <th style="width:18%;">Result</th>
                            <th style="width:42%;">Comp</th>
                            <th style="width:40%;">K/D/A</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for match in cvData.perf.recentMatches|slice(0,5) %}
                        <tr>
                            <td style="color:{{ match.win ? '#00ff9d' : '#ff4655' }};font-weight:bold;">
                                {{ match.win ? 'WIN' : 'LOSS' }}
                            </td>
                            <td>{{ game == 'valorant' ? match.agent : match.championName }}</td>
                            <td>{{ match.kills }}/{{ match.deaths }}{% if game != 'cs2' %}/{{ match.assists }}{% endif %}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}

        </div>{# /widgets #}

        {# ══════════════════════════════
           FOOTER
           ══════════════════════════════ #}
        <div class="footer">
            TEAMCRAFT • RECRUITMENT DOSSIER
            &nbsp;&nbsp;•&nbsp;&nbsp; Generated {{ generationDate|date('d/m/Y H:i') }}
            &nbsp;&nbsp;•&nbsp;&nbsp; ID {{ user.id }}
        </div>

    </div>{# /content #}
</div>{# /cv-page #}

</body>
</html>

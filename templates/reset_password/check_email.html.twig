{% extends 'frontoffice/base.html.twig' %}

{% block body %}
<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card bg-dark text-white text-center shadow-lg p-5" style="width: 100%; max-width: 500px; border: 1px solid #333;">
        <div class="mb-4">
            <i class="fas fa-paper-plane fa-3x text-primary"></i>
        </div>
        <h3>Email envoyé !</h3>
        <p class="mt-3">Si un compte existe pour cet email, vous recevrez un lien d'ici quelques instants.</p>
        <p class="text-warning small">Note : Le lien expire dans 1 heure.</p>
        <a href="{{ path('app_login') }}" class="btn btn-outline-light mt-3">Retour à l'accueil</a>
    </div>
</div>
{% endblock %}
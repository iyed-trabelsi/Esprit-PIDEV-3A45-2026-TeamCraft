<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TEAMCRAFT{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/logo.png') }}">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <style>
            :root {
                --tc-bg-dark: #0f0f12;
                --tc-bg-card: #1a1a1f;
                --tc-bg-input: #252530;
                --tc-cyan: #0ea5e9;
                --tc-cyan-hover: #38bdf8;
                --tc-neon-green: #22c55e;
                --tc-text: #f1f5f9;
                --tc-text-muted: #94a3b8;
                --tc-border: #334155;
            }
            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--tc-bg-dark);
                color: var(--tc-text);
                min-height: 100vh;
            }
            .font-display { font-family: 'Orbitron', sans-serif; }
            .btn-tc-primary {
                background: var(--tc-cyan);
                border: none;
                color: #fff;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                padding: 0.75rem 1.5rem;
                border-radius: 0.5rem;
                box-shadow: 0 0 20px rgba(14, 165, 233, 0.35);
            }
            .btn-tc-primary:hover {
                background: var(--tc-cyan-hover);
                color: #fff;
                box-shadow: 0 0 25px rgba(14, 165, 233, 0.5);
            }
            .btn-tc-outline {
                background: transparent;
                border: 2px solid var(--tc-text);
                color: var(--tc-text);
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                padding: 0.75rem 1.5rem;
                border-radius: 0.5rem;
            }
            .btn-tc-outline:hover {
                background: rgba(255,255,255,0.1);
                color: var(--tc-text);
                border-color: var(--tc-text);
            }
            .form-tc .form-control, .form-tc .form-select {
                background: var(--tc-bg-input);
                border: 1px solid var(--tc-border);
                color: var(--tc-text);
                border-radius: 0.5rem;
                padding: 0.75rem 1rem;
            }
            .form-tc .form-control::placeholder { color: var(--tc-text-muted); }
            .form-tc .form-control:focus, .form-tc .form-select:focus {
                background: var(--tc-bg-input);
                border-color: var(--tc-cyan);
                color: var(--tc-text);
                box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2);
            }
            .form-tc label { color: var(--tc-text-muted); font-weight: 500; }
            .card-tc {
                background: var(--tc-bg-card);
                border: 1px solid var(--tc-border);
                border-radius: 0.75rem;
                box-shadow: 0 0 30px rgba(34, 197, 94, 0.08);
            }
            .navbar-tc .nav-link { color: var(--tc-text) !important; font-weight: 500; }
            .navbar-tc .nav-link:hover { color: var(--tc-cyan) !important; }
            .brand-text { font-family: 'Orbitron', sans-serif; font-weight: 700; color: var(--tc-text); letter-spacing: 0.1em; }
        </style>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100 {% block body_class %}{% endblock %}">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show mb-0 rounded-0 border-0" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        {% block scripts %}{% endblock %}
    </body>
</html>

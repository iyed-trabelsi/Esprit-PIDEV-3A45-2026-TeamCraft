{% extends 'frontoffice/base.html.twig' %}

{% block title %}Log In - TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="position-relative flex-grow-1 d-flex align-items-center py-5" style="min-height: calc(100vh - 80px);">
        <div class="container position-relative z-1">
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-5">
                    <div class="card card-tc p-4 p-md-5">
                        <h2 class="text-center fw-bold mb-4 text-white">Log In</h2>

                        {# --- AFFICHAGE DU MESSAGE DE SUCCÈS --- #}
                        {% for message in app.flashes('reset_password_success') %}
                            <div class="alert alert-success border-0 shadow-sm text-center mb-4">
                                <i class="fas fa-check-circle me-2"></i> {{ message }}
                            </div>
                        {% endfor %}
                        {# -------------------------------------- #}

                        <form method="post" class="form-tc" action="{{ path('app_login') }}">
                            {% if error %}
                                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            {% endif %}
                            <div class="mb-3">
                                <label for="email" class="form-label">Email Address</label>
                                <input type="email" name="_username" id="email" class="form-control" placeholder="you@example.com" value="{{ last_username }}" required autofocus>
                            </div>

                            <div class="mb-4">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" name="_password" id="password" class="form-control" placeholder="••••••••" required>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="form-check">
                                    <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
                                    <label class="form-check-label text-white-50" for="_remember_me">Rester connecté</label>
                                </div>
                                <a href="{{ path('app_forgot_password_request') }}" class="small text-decoration-none">Mot de passe oublié ?</a>
                            </div>

                            <hr class="my-4 border-secondary opacity-25">

                            <a href="{{ path('connect_google_start') }}" class="google-btn-full mb-4">
                                <div class="google-content">
                                    <img src="https://fonts.gstatic.com/s/i/productlogos/googleg/v6/24px.svg" alt="Google logo" class="google-logo">
                                    <span class="google-text">Continue with Google</span>
                                </div>
                            </a>    

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                            <button type="submit" class="btn btn-tc-primary w-100 py-3 fw-bold">Log In</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% extends 'frontoffice/base.html.twig' %}

{% block title %}Create Team - TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1 d-flex flex-column justify-content-center">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card bg-dark border-0 shadow-lg text-white" style="border-radius: 1rem; background: #1a1a1a;">
                    <div class="card-body p-5">
                        <div class="text-center mb-5">
                            <h1 class="h2 fw-bold mb-2 text-white">Create Team</h1>
                            <p class="text-white-50">Create your esports team and start competing</p>
                        </div>

                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                            {% if form.vars.submitted and not form.vars.valid %}
                                <div class="alert alert-danger mb-4" role="alert">
                                    <strong>Veuillez corriger les erreurs ci-dessous.</strong>
                                    {{ form_errors(form) }}
                                </div>
                            {% endif %}
                            
                            <!-- Team Logo -->
                            <div class="mb-4 text-center">
                                <label class="form-label d-block mb-3 text-white-50">Team Logo</label>
                                <div class="position-relative d-inline-block">
                                    <div class="rounded-circle overflow-hidden border border-2 border-primary d-flex align-items-center justify-content-center bg-black" style="width: 120px; height: 120px;" id="logoPreviewContainer">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-camera text-secondary" viewBox="0 0 16 16" id="defaultLogoIcon">
                                            <path d="M15 12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h1.172a3 3 0 0 0 2.12-.879l.83-.828A1 1 0 0 1 6.827 3h2.344a1 1 0 0 1 .707.293l.828.828A3 3 0 0 0 12.828 5H14a1 1 0 0 1 1 1v6zM2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4H2z"/>
                                            <path d="M8 11a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5zm0 1a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM3 6.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0z"/>
                                        </svg>
                                        <img src="" alt="Team Logo" class="w-100 h-100 object-fit-cover d-none" id="logoPreview">
                                    </div>
                                    <button type="button" class="btn btn-sm btn-primary rounded-circle position-absolute bottom-0 end-0 shadow-sm" style="width: 32px; height: 32px; padding: 0;" onclick="document.getElementById('team_logo').click();">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                          <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708l-3-3zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                        </svg>
                                    </button>
                                </div>
                                {{ form_widget(form.logo, {'attr': {'class': 'd-none', 'id': 'team_logo'}}) }}
                                <div class="text-danger mt-1">{{ form_errors(form.logo) }}</div>
                            </div>

                            <!-- Team Name -->
                            <div class="mb-4">
                                {{ form_label(form.name, null, {'label_attr': {'class': 'form-label text-white'}}) }}
                                {{ form_widget(form.name, {'attr': {'class': 'form-control bg-black text-white border-secondary', 'required': true, 'placeholder': "Entrez le nom de l'équipe"}}) }}
                                <div class="text-danger mt-1">{{ form_errors(form.name) }}</div>
                            </div>

                            <!-- Games Played -->
                            <div class="mb-5">
                                {{ form_label(form.games, null, {'label_attr': {'class': 'form-label text-white mb-3'}}) }}
                                <div class="row g-2">
                                    {% for choice in form.games %}
                                        <div class="col-6">
                                            <div class="form-check p-0">
                                                {{ form_widget(choice, {'attr': {'class': 'btn-check game-checkbox'}}) }}
                                                <label class="btn btn-outline-secondary w-100 text-start text-white border-secondary d-flex justify-content-between align-items-center" for="{{ choice.vars.id }}">
                                                    {{ choice.vars.label }}
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-lg opacity-0 check-icon" viewBox="0 0 16 16">
                                                      <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022Z"/>
                                                    </svg>
                                                </label>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                <div class="text-danger mt-1">{{ form_errors(form.games) }}</div>
                            </div>

                            <!-- Buttons -->
                            <div class="d-grid gap-3 d-md-flex justify-content-md-between align-items-center">
                                <a href="{{ path('app_teams') }}" class="btn btn-outline-danger px-4">Cancel</a>
                                <button type="submit" class="btn btn-success px-5 fw-bold">Create Team</button>
                            </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}

    <style>
        .form-check .btn-outline-secondary:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: #6c757d;
        }
        .form-check .btn-check:checked + .btn-outline-secondary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        .form-check .btn-check:checked + .btn-outline-secondary .check-icon {
            opacity: 1 !important;
        }
        .text-danger ul {
            list-style: none;
            padding-left: 0;
            margin-bottom: 0;
            display: block;
        }
        .text-danger li {
            font-size: 0.875rem;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const teamLogoInput = document.getElementById('team_logo');
            const logoPreview = document.getElementById('logoPreview');
            const defaultLogoIcon = document.getElementById('defaultLogoIcon');

            // Image Preview Logic
            if (teamLogoInput) {
                teamLogoInput.addEventListener('change', function(event) {
                    const file = event.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            logoPreview.src = e.target.result;
                            logoPreview.classList.remove('d-none');
                            defaultLogoIcon.classList.add('d-none');
                        }
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>

{% endblock %}
{% extends 'frontoffice/base.html.twig' %}

{% block title %}🔴 LIVE — {{ team.name }} | TeamCraft{% endblock %}

{% block stylesheets %}
<style>
    .live-page-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #0a0a0f;
    }

    /* ── Header ── */
    .live-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        background: rgba(10,10,15,0.95);
        border-bottom: 1px solid #1e293b;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .live-header .team-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #dc2626;
        color: white;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        padding: 0.3rem 0.75rem;
        border-radius: 4px;
        animation: livePulse 2s infinite;
    }

    .live-badge .live-dot {
        width: 6px;
        height: 6px;
        background: white;
        border-radius: 50%;
        animation: dotBlink 1.2s infinite;
    }

    @keyframes livePulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(220,38,38,0.6); }
        50%       { box-shadow: 0 0 0 6px rgba(220,38,38,0); }
    }

    @keyframes dotBlink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.2; }
    }

    .viewer-count-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255,255,255,0.08);
        border: 1px solid #334155;
        color: #94a3b8;
        font-size: 0.8rem;
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
    }

    /* ── Video area ── */
    .live-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        gap: 1.5rem;
    }

    .video-container {
        position: relative;
        width: 100%;
        max-width: 900px;
        background: #0f0f1a;
        border-radius: 1rem;
        overflow: hidden;
        border: 1px solid #1e293b;
        box-shadow: 0 0 60px rgba(14,165,233, 0.08);
        aspect-ratio: 16/9;
    }

    #remoteVideo {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        background: #000;
    }

    /* ── State overlays ── */
    .video-overlay-state {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.85);
        color: #f1f5f9;
        text-align: center;
        padding: 2rem;
        transition: opacity 0.3s;
    }

    .video-overlay-state.hidden { display: none; }

    .spinner-live {
        width: 48px; height: 48px;
        border: 3px solid #1e293b;
        border-top-color: #0ea5e9;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 1rem;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .stream-ended-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    /* ── Chat / info sidebar ── */
    .live-sidebar {
        width: 100%;
        max-width: 900px;
        background: rgba(15,15,26,0.9);
        border: 1px solid #1e293b;
        border-radius: 0.75rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .live-team-name {
        font-size: 1rem;
        font-weight: 700;
        color: #f1f5f9;
    }

    .live-team-games {
        font-size: 0.78rem;
        color: #64748b;
        margin-top: 0.1rem;
    }

    /* ── Back button ── */
    .btn-back {
        background: none;
        border: 1px solid #334155;
        color: #94a3b8;
        padding: 0.4rem 1rem;
        border-radius: 0.5rem;
        font-size: 0.85rem;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-back:hover { border-color: #0ea5e9; color: #0ea5e9; }

    /* ── Connection quality ── */
    .conn-quality {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.72rem;
        color: #22c55e;
    }

    .conn-quality.poor { color: #f97316; }
    .conn-quality.bad  { color: #ef4444; }
</style>
{% endblock %}

{% block body %}
<div class="live-page-wrapper">
    <!-- Sticky Header -->
    <div class="live-header">
        <div class="team-info">
            {% if team.logo %}
                <img src="{{ asset('uploads/teams/' ~ team.logo) }}" alt="{{ team.name }}" class="rounded-circle" width="36" height="36" style="object-fit:cover;">
            {% else %}
                <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center text-dark fw-bold" style="width:36px;height:36px;font-size:0.9rem;">
                    {{ team.name|first|upper }}
                </div>
            {% endif %}
            <div>
                <div class="text-white fw-bold" style="font-size:0.95rem;">{{ team.name }}</div>
                <div style="font-size:0.7rem;color:#64748b;">Live Stream</div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="live-badge hidden" id="liveIndicator">
                <span class="live-dot"></span> LIVE
            </span>
            <span class="viewer-count-badge" id="viewerCountBadge">
                <i class="bi bi-eye"></i>
                <span id="viewerCountNum">0</span>
            </span>
            <a href="{{ path('team_manage', {id: team.id}) }}" class="btn-back">
                <i class="bi bi-arrow-left me-1"></i> Retour
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="live-content">
        <!-- Video player -->
        <div class="video-container">
            <video id="remoteVideo" autoplay playsinline></video>

            <!-- Unified Overlay -->
            <div class="video-overlay-state" id="overlay">
                <div class="spinner-live" id="overlaySpinner"></div>
                <h5 class="text-white mb-2" id="overlayTitle">En attente du stream...</h5>
                <p class="text-muted mb-3" style="font-size:0.85rem;" id="overlayText">
                    L'organisateur n'a pas encore démarré la diffusion.<br>
                    Cette page se connectera automatiquement quand le stream démarre.
                </p>
                <div id="connectionStatus" class="mb-3 small fw-bold" style="color: #4ade80; font-family: monospace;">Initialisation...</div>
                <button onclick="window.location.reload()" class="btn btn-outline-info btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-clockwise me-1"></i> Actualiser
                </button>
            </div>

            <!-- Stream ended overlay -->
            <div class="video-overlay-state hidden" id="endedOverlay">
                <div class="stream-ended-icon">📺</div>
                <h5 class="text-white mb-2">Stream terminé</h5>
                <p class="text-muted mb-3" style="font-size:0.85rem;">L'organisateur a arrêté la diffusion.</p>
                <a href="{{ path('team_manage', {id: team.id}) }}" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Retour à la team
                </a>
            </div>
        </div>

        <!-- Info bar -->
        <div class="live-sidebar">
            <div>
                <div class="live-team-name">{{ team.name }} — Live Event</div>
                <div class="live-team-games">
                    {% if team.games|length > 0 %}{{ team.games|join(', ') }}{% endif %}
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="conn-quality" id="connQuality" style="display:none!important;">
                    <i class="bi bi-wifi"></i> <span id="connQualityText">Connecté</span>
                </span>
                <a href="{{ path('team_broadcast', {id: team.id}) }}" class="btn-back" style="font-size:0.75rem;">
                    <i class="bi bi-broadcast me-1"></i> Diffuser moi-même
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const TEAM_ID        = {{ team.id }};
    const SIGNAL_URL = 'https://bits-geological-procedure-telecharger.trycloudflare.com'; // Cloudflare signaling server

    // ─── DOM refs ──────────────────────────────────────────────────────────
    const remoteVideo       = document.getElementById('remoteVideo');
    const overlay           = document.getElementById('overlay');
    const overlayTitle      = document.getElementById('overlayTitle');
    const overlayText       = document.getElementById('overlayText');
    const endedOverlay      = document.getElementById('endedOverlay'); // Kept as it's still used by showOverlay
    const liveIndicator     = document.getElementById('liveIndicator');
    const viewerCountBadge  = document.getElementById('viewerCountBadge'); // Corrected ID
    const viewerCountNum    = document.getElementById('viewerCountNum'); // Still needed for updating count
    const connQuality       = document.getElementById('connQuality');
    const connQualityText   = document.getElementById('connQualityText');
    const connectionStatus  = document.getElementById('connectionStatus'); // Added for status updates

    // Ajout d'un petit helper pour le statut
    function updateStatus(msg, isError = false) {
        console.log(`[Status] ${msg}`);
        const statusEl = document.getElementById('connectionStatus');
        if (statusEl) {
            statusEl.textContent = msg;
            statusEl.style.color = isError ? '#ff4d4d' : '#4ade80';
        }
    }

    // ─── State ─────────────────────────────────────────────────────────────
    let peerConnection  = null;
    let broadcasterSocketId = null;

    const ICE_SERVERS = {
        iceServers: [
            { urls: 'stun:stun.l.google.com:19302' },
            { urls: 'stun:stun1.l.google.com:19302' },
            { urls: 'stun:stun2.l.google.com:19302' }
        ]
    };

    const socket = io(SIGNAL_URL, { transports: ['websocket', 'polling'] });

    socket.on('connect', () => {
        console.log('[Viewer] Connected to signaling server:', socket.id);
        // Join as viewer
        socket.emit('viewer', { teamId: TEAM_ID });
    });

    socket.on('connect_error', (err) => {
        console.error('[Viewer] Socket connection error:', err.message);
        updateStatus(`Erreur de connexion au serveur: ${err.message}`, true);
    });

    // Broadcaster is ready → create peer connection and wait for offer
    socket.on('broadcaster-ready', () => {
        console.log('[Viewer] Broadcaster is ready');
        updateStatus('Diffuseur prêt, en attente de l\'offre WebRTC...');
        showOverlay('connecting');
        liveIndicator.classList.remove('hidden');
    });

    // Waiting — no broadcaster yet
    socket.on('waiting', () => {
        console.log('[Viewer] Waiting for broadcaster');
        showOverlay('waiting');
    });

    // ─── Overlay helpers ──────────────────────────────────────────────────
    function showOverlay(state) {
        // Reset
        overlay.classList.add('hidden');
        endedOverlay.classList.add('hidden');

        if (state === 'waiting') {
            overlay.classList.remove('hidden');
            overlayTitle.textContent = 'En attente du stream...';
            overlayText.innerHTML = "L'organisateur n'a pas encore démarré la diffusion.<br>Cette page se connectera automatiquement quand le stream démarre.";
            updateStatus('En attente du diffuseur...');
        } else if (state === 'connecting') {
            overlay.classList.remove('hidden');
            overlayTitle.textContent = 'Connexion en cours...';
            overlayText.textContent = "Établissement de la connexion WebRTC avec le diffuseur...";
            updateStatus('Handshake WebRTC en cours...');
        } else if (state === 'ended') {
            endedOverlay.classList.remove('hidden');
            updateStatus('Le stream est terminé.', true);
        } else if (state === 'live') {
            updateStatus('EN DIRECT 🔴');
        }
    }

    // ─── WebRTC Offer ──────────────────────────────────────────────────────
    socket.on('offer', async ({ from, offer }) => {
        updateStatus('Offre reçue, préparation de la réponse...');
        broadcasterSocketId = from;
        showOverlay('connecting');
        
        try {
            peerConnection = createPeerConnection();
            await peerConnection.setRemoteDescription(new RTCSessionDescription(offer));
            const answer = await peerConnection.createAnswer();
            await peerConnection.setLocalDescription(answer);
            socket.emit('answer', { to: from, answer });
            updateStatus('Réponse envoyée au diffuseur.');
        } catch (e) {
            updateStatus(`Erreur WebRTC: ${e.message}`, true);
            console.error('[WebRTC] Offer error:', e);
        }
    });

    socket.on('candidate', async ({ candidate }) => {
        if (peerConnection && candidate) {
            try {
                await peerConnection.addIceCandidate(new RTCIceCandidate(candidate));
                console.log('[WebRTC] ICE candidate added');
            } catch (e) {
                console.error('[WebRTC] Candidate error:', e);
            }
        }
    });

    socket.on('viewer-count', ({ count }) => {
        console.log('[Viewer] Count updated:', count);
        if (viewerCountNum) viewerCountNum.textContent = count;
    });

    socket.on('stream-ended', () => {
        updateStatus('Le diffuseur a coupé le stream.');
        showOverlay('ended');
        stopStream();
    });

    function createPeerConnection() {
        if (peerConnection) peerConnection.close();
        
        const pc = new RTCPeerConnection(ICE_SERVERS);

        pc.onicecandidate = (event) => {
            if (event.candidate) {
                socket.emit('candidate', { to: broadcasterSocketId, candidate: event.candidate });
            }
        };

        pc.ontrack = (event) => {
            console.log('[WebRTC] Remote track received');
            if (event.streams && event.streams[0]) {
                remoteVideo.srcObject = event.streams[0];
                showOverlay('live');
                liveIndicator.classList.remove('hidden');
                
                // Auto-play attempt
                remoteVideo.play().catch(e => {
                    console.warn('[Viewer] Autoplay blocked:', e);
                    updateStatus('Clique sur la vidéo pour le son', true);
                });
            }
        };

        pc.onconnectionstatechange = () => {
            console.log('[WebRTC] State:', pc.connectionState);
            if (pc.connectionState === 'connected') {
                updateStatus('Connecté au flux vidéo ✅');
            } else if (pc.connectionState === 'failed' || pc.connectionState === 'disconnected') {
                updateStatus('Connexion WebRTC échouée ❌', true);
            }
        };

        return pc;
    }

    function stopStream() {
        if (peerConnection) {
            peerConnection.close();
            peerConnection = null;
        }
        remoteVideo.srcObject = null;
        liveIndicator.classList.add('hidden');
    }
});
</script>
{% endblock %}

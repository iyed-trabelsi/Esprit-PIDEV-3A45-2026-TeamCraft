{% extends 'frontoffice/base.html.twig' %}

{% block title %}Gestion des Candidatures - TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 fw-bold text-white mb-0">{{ isOwner ? 'Application Management' : 'Candidatures de l\'équipe' }}</h1>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#statsModal">
                    <i class="bi bi-bar-chart-fill me-2"></i>Statistics
                </button>
                <a href="{{ path('team_manage', {id: team.id}) }}" class="btn btn-outline-light">
                    <i class="bi bi-arrow-left me-2"></i>Return
                </a>
            </div>
        </div>

        <div class="card-tc p-0 overflow-hidden" style="background: var(--tc-bg-input);">
            <div class="table-responsive">
                <table class="table align-middle mb-0 text-white bg-input-match" style="font-size: 0.9rem;">
                    <thead class="custom-table-header">
                        <tr>
                            <th class="border-0 px-4 py-3">Candidate</th>
                            <th class="border-0 px-4 py-3">Email</th>
                            <th class="border-0 px-4 py-3">Title</th>
                            <th class="border-0 px-4 py-3">Offer</th>
                            <th class="border-0 px-4 py-3">Message</th>
                            <th class="border-0 px-4 py-3">Date</th>
                            <th class="border-0 px-4 py-3">Status</th>
                            {% if canManage %}
                            <th class="border-0 px-4 py-3 text-end">Actions</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody class="bg-input-match">
                        {% for app in applications %}
                            <tr>
                                <td class="px-4 py-3 fw-semibold bg-input-match">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            {{ app.user.pseudo|first|upper }}
                                        </div>
                                        <div>
                                            <div class="text-white">{{ app.user.pseudo }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-3 bg-input-match">
                                    <!-- Email en blanc -->
                                    <div class="text-white small">{{ app.user.email }}</div>
                                </td>
                                <td class="px-4 py-3 bg-input-match">
                                    <div class="text-white">{{ app.offer.title }}</div>
                                </td>
                                <td class="px-4 py-3 bg-input-match">
                                    <span class="badge-game {{ app.offer.game|lower == 'league of legends' ? 'lol' : app.offer.game|lower }}">{{ app.offer.game }}</span>
                                </td>
                                <td class="px-4 py-3 bg-input-match small" style="max-width: 200px;">
                                    <!-- Message en blanc -->
                                    {% set msg = app.message|default('No message') %}
                                    <div title="{{ msg }}" class="text-white">{{ msg|slice(0, 40) }}{{ msg|length > 40 ? '...' : '' }}</div>
                                </td>
                                <td class="px-4 py-3 bg-input-match">{{ app.createdAt|date('d/m/Y') }}</td>
                                <td class="px-4 py-3 bg-input-match">
                                    {% if app.status == 'accepted' %}
                                        <span class="badge bg-success">Accepted</span>
                                    {% elseif app.status == 'refused' %}
                                        <span class="badge bg-danger">Refused</span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    {% endif %}
                                </td>
                                {% if canManage %}
                                <td class="px-4 py-3 text-end bg-input-match">
                                    {% if app.status == 'pending' %}
                                        <!-- Actions remises comme avant -->
                                        <div class="d-flex gap-2 justify-content-end">
                                            <form method="post" action="{{ path('app_application_accept', {id: app.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ app.id) }}">
                                                <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Accepter ce joueur dans l\'équipe ?')">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <form method="post" action="{{ path('app_application_refuse', {id: app.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('refuse' ~ app.id) }}">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Refuser cette candidature ?')">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </div>
                                    {% else %}
                                        <span class="text-muted small">Processed</span>
                                    {% endif %}
                                </td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ canManage ? '8' : '7' }}" class="px-4 py-5 text-center text-muted bg-input-match">
                                   No applications received at the moment.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Stats Modal -->
    <div class="modal fade" id="statsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content card-tc-premium border-0 shadow-lg" style="background: #1a1d29; border: 1px solid rgba(255, 255, 255, 0.1);">
                <div class="modal-header border-bottom border-white-10">
                    <h5 class="modal-title text-white">Application Statistics</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div style="width: 300px; height: 300px; margin: 0 auto;">
                        <canvas id="appStatsChart"></canvas>
                    </div>
                    {% set total = stats.pending + stats.accepted + stats.refused %}
                    <div class="mt-4 d-flex justify-content-center gap-4 text-white small">
                        <div class="d-flex align-items-center gap-2">
                            <span style="width: 10px; height: 10px; background: #ffc107; border-radius: 50%;"></span>
                            Pending: {{ stats.pending }} ({{ total > 0 ? ((stats.pending / total * 100)|round(1)) : 0 }}%)
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span style="width: 10px; height: 10px; background: #198754; border-radius: 50%;"></span>
                            Accepted: {{ stats.accepted }} ({{ total > 0 ? ((stats.accepted / total * 100)|round(1)) : 0 }}%)
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span style="width: 10px; height: 10px; background: #dc3545; border-radius: 50%;"></span>
                            Refused: {{ stats.refused }} ({{ total > 0 ? ((stats.refused / total * 100)|round(1)) : 0 }}%)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('appStatsChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Pending', 'Accepted', 'Refused'],
                    datasets: [{
                        data: [{{ stats.pending }}, {{ stats.accepted }}, {{ stats.refused }}],
                        backgroundColor: [
                            'rgba(255, 193, 7, 0.8)',  // Warning/Pending
                            'rgba(25, 135, 84, 0.8)',  // Success/Accepted
                            'rgba(220, 53, 69, 0.8)'   // Danger/Refused
                        ],
                        borderColor: [
                            'rgba(255, 193, 7, 1)',
                            'rgba(25, 135, 84, 1)',
                            'rgba(220, 53, 69, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false // Custom legend used below
                        }
                    }
                }
            });
        });
    </script>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}
{% endblock %}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const chatMessagesContainer = document.getElementById('chatMessages');
        const chatForm = document.getElementById('chatForm');
        const chatInput = document.getElementById('chatInput');
        const chatImageInput = document.getElementById('chatImageInput');
        const chatUploadBtn = document.getElementById('chatUploadBtn');
        const teamChatModal = document.getElementById('teamChatModal');
        let chatPollInterval;

        // Trigger file input
        chatUploadBtn.addEventListener('click', () => chatImageInput.click());
        
        // Change icon style when file selected
        chatImageInput.addEventListener('change', () => {
            if (chatImageInput.files.length > 0) {
                chatUploadBtn.classList.remove('text-secondary');
                chatUploadBtn.classList.add('text-primary');
            } else {
                chatUploadBtn.classList.add('text-secondary');
                chatUploadBtn.classList.remove('text-primary');
            }
        });

        let existingMessageIds = new Set();

        function loadMessages() {
            fetch("{{ path('team_chat_list', {id: team.id}) }}")
                .then(response => response.json())
                .then(data => {
                    const newMessageIds = new Set();
                    
                    if (data.length === 0) {
                        chatMessagesContainer.innerHTML = `
                            <div class="text-center text-muted mt-5 opacity-50">
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-chat-square-dots mb-3" viewBox="0 0 16 16">
                                  <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-2.5a2 2 0 0 0-1.6.8L8 14.333 6.1 11.8a2 2 0 0 0-1.6-.8H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2.5l3.5 4.667L11.5 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                                  <path d="M5 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                                </svg>
                                <p>No messages yet.<br>Start the conversation!</p>
                            </div>`;
                        existingMessageIds.clear();
                        return;
                    }

                    // Only clear and rebuild if message count changed
                    const shouldRebuild = chatMessagesContainer.children.length !== data.length;
                    
                    if (shouldRebuild) {
                        chatMessagesContainer.innerHTML = '';
                    }

                    let lastSenderId = null;

                    data.forEach((msg, index) => {
                        const messageId = msg.id || `${msg.senderId}-${msg.createdAt}`;
                        newMessageIds.add(messageId);
                        const isNewMessage = !existingMessageIds.has(messageId);
                        
                        if (!shouldRebuild && !isNewMessage) {
                            return; // Skip existing messages if not rebuilding
                        }

                        const isMe = msg.isMe;
                        let bubbleClass = 'msg-member';
                        let textColor = 'text-white';
                        let borderColor = '#9CA3AF'; // Default gray
                        
                        if (msg.role === 'owner') {
                            bubbleClass = 'msg-owner';
                            borderColor = '#FFD700'; // Gold
                        } else if (msg.role === 'co_owner') {
                            bubbleClass = 'msg-co-owner';
                            borderColor = '#2ECC71'; // Green
                        }

                        // Alignment based on isMe only
                        const alignClass = isMe ? 'align-self-end text-end' : 'align-self-start text-start';
                        const flexDir = isMe ? 'flex-row-reverse' : 'flex-row';
                        
                        // Avatar generation (initials or generic)
                        const initial = msg.sender.charAt(0).toUpperCase();
                        // You could pass avatar URL in the controller if available, for now using placeholder
                        
                        const showHeader = lastSenderId !== msg.senderId;
                        
                        const msgDiv = document.createElement('div');
                        msgDiv.className = `d-flex w-100 mb-1 ${flexDir}`;
                        msgDiv.dataset.messageId = messageId;
                        
                        let contentHtml = `
                            <div style="max-width: 80%;">
                                ${showHeader ? `
                                    <div class="mb-1 small d-flex align-items-center gap-2 ${isMe ? 'justify-content-end' : 'justify-content-start'}">
                                        ${msg.role === 'owner' ? '<span class="badge rounded-pill bg-warning text-dark fw-bold d-flex align-items-center gap-1" style="font-size: 0.6rem; letter-spacing: 0.5px;">👑 OWNER</span>' : ''}
                                        ${msg.role === 'co_owner' ? '<span class="badge rounded-pill bg-info text-dark fw-bold d-flex align-items-center gap-1" style="font-size: 0.6rem; letter-spacing: 0.5px;">⚡ CO-OWNER</span>' : ''}
                                        <span class="fw-bold fs-7 text-white opacity-75">${msg.sender}</span>
                                        <span class="text-muted" style="font-size: 0.65rem;">${msg.createdAt}</span>
                                    </div>
                                ` : ''}
                                <div class="msg-bubble ${bubbleClass} text-start ${isNewMessage ? '' : 'no-animation'}">
                                    ${msg.image ? `<div class="mb-2"><img src="${msg.image}" class="img-fluid rounded" style="max-height: 200px; object-fit: cover;"></div>` : ''}
                                    ${msg.content}
                                </div>
                            </div>
                        `;

                        msgDiv.innerHTML = contentHtml;
                        chatMessagesContainer.appendChild(msgDiv);
                        
                        lastSenderId = msg.senderId;
                    });
                    
                    existingMessageIds = newMessageIds;
                    
                    // Auto scroll to bottom
                    chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
                })
                .catch(err => console.error('Error fetching chat messages:', err));
        }

        teamChatModal.addEventListener('shown.bs.modal', () => {
            loadMessages();
            chatPollInterval = setInterval(loadMessages, 3000); // Poll every 3 seconds
        });

        teamChatModal.addEventListener('hidden.bs.modal', () => {
            clearInterval(chatPollInterval);
        });

        chatForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const content = chatInput.value.trim();
            const imageFile = chatImageInput.files[0];

            if (!content && !imageFile) return;

            const formData = new FormData();
            formData.append('content', content);
            if (imageFile) {
                formData.append('image', imageFile);
            }

            // Send message
            fetch("{{ path('team_chat_send', {id: team.id}) }}", {
                method: 'POST',
                // No headers for FormData, browser sets multipart/form-data boundary
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'success') {
                    chatInput.value = '';
                    chatImageInput.value = ''; // Reset file input
                    chatUploadBtn.classList.add('text-secondary');
                    chatUploadBtn.classList.remove('text-primary');
                    loadMessages(); // Refresh immediately
                }
            })
            .catch(err => console.error('Error sending message:', err));
        });
    });
</script>

{% endblock %}

{% extends 'frontoffice/base.html.twig' %}

{% block title %}Manage Team - {{ team.name }}{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <div class="container py-5 flex-grow-1">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
             <div class="d-flex align-items-center gap-3">
                <div class="icon-box p-2 rounded text-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-gear" viewBox="0 0 16 16">
                      <path d="M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm.256 7a4.474 4.474 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.36 10 8 10c.049 0 .098.001.147.005A4.49 4.49 0 0 1 8 13.5a4.49 4.49 0 0 1 4.642-4.745.5.5 0 0 1 .508.495v.005a5.503 5.503 0 0 0 .507.005H14a.5.5 0 0 1 .495.508V14a.5.5 0 0 1-.508.495H8.256Zm-.055-.494A3.5 3.5 0 0 0 12 10.5a3.49 3.49 0 0 0-3.417 3.46c.01.21.03.418.06.621.037.247.112.483.218.705.105.218.243.417.408.598.66.721 1.638 1.116 2.731 1.116s2.07-.395 2.731-1.116c.165-.181.303-.38.408-.598.106-.222.181-.458.218-.705.03-.203.05-.411.06-.621A3.49 3.49 0 0 0 12 10.5Zm-8.497.001a.5.5 0 0 1-.005.494.5.5 0 0 1-.495-.005.5.5 0 0 1-.005-.494.5.5 0 0 1 .495.005.5.5 0 0 1 .005.494Z"/>
                      <path d="M13.43 12.18c-.027-.378-.073-.75-.138-1.113l-.007-.038a4.507 4.507 0 0 0-.276-1.026l.006-.033a3.507 3.507 0 0 0-.308-.72l.006-.035a2.508 2.508 0 0 0-.29-.53l.004-.025a1.505 1.505 0 0 0-.374-.75h.001l-.002-.002a2.495 2.495 0 0 0-.002 4.28 2.477 2.477 0 0 0 1.396-.008Z"/>
                    </svg>
                </div>
                <h1 class="h3 fw-bold text-white mb-0">Manage My Team</h1>
             </div>
             <a href="{{ path('app_teams') }}" class="btn btn-outline-light btn-sm d-flex align-items-center gap-2 px-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                  <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                </svg>
                Return
             </a>
        </div>

        <div class="row g-4">
            <!-- Left Column: Team Info, Events, Offers -->
            <div class="col-12 col-lg-4">
                <!-- Team Identity Card -->
                <div class="card bg-dark border-0 shadow mb-3" style="background-color: #16161a !important;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="rounded-circle p-1 border border-warning border-opacity-25">
                                {% if team.logo %}
                                    <img src="{{ asset('uploads/teams/' ~ team.logo) }}" alt="{{ team.name }}" class="rounded-circle object-fit-cover" width="60" height="60">
                                {% else %}
                                    <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center text-dark fw-bold fs-4" style="width: 60px; height: 60px;">
                                        {{ team.name|first|upper }}
                                    </div>
                                {% endif %}
                            </div>
                            <div>
                                <h2 class="h5 fw-bold text-white mb-0">{{ team.name }}</h2>
                                <p class="text-secondary mb-0 small">
                                    {% if teamGames is defined and teamGames|length > 0 %}
                                        {{ teamGames|join(', ') }}
                                    {% else %}
                                        No games selected
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <a href="{{ path('team_edit', {'id': team.id}) }}" class="btn btn-success flex-grow-1 fw-bold" style="font-size: 0.9rem;">Edit Team</a>
                            
                            <form method="post" action="{{ path('team_delete', {'id': team.id}) }}" class="flex-grow-1" onsubmit="return confirm('Are you sure you want to delete this team? This action cannot be undone.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_team_' ~ team.id) }}">
                                <button type="submit" class="btn btn-danger w-100 fw-bold" style="font-size: 0.9rem;">Delete Team</button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Recruitment Dashboard -->
                <div class="card bg-dark border-0 shadow mb-3" style="background-color: #16161a !important;">
                     <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent py-3">
                        <div class="d-flex align-items-center gap-2">
                             <span class="d-inline-block bg-info rounded-1" style="width: 8px; height: 8px;"></span>
                             <h5 class="card-title text-white mb-0 fs-6 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Recruitment</h5>
                        </div>
                    </div>
                    <div class="card-body p-3">
                         <a href="{{ path('team_applications', {id: team.id}) }}" class="btn btn-info d-flex align-items-center justify-content-center gap-2 w-100 py-2 fw-bold text-white" style="border: none;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-lines-fill" viewBox="0 0 16 16">
                              <path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-5 6s-1 0-1-1 1-4 6-4 6 3 6 4 1 1 1H1zm11-9a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                              <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                            </svg>
                            View All Applications
                        </a>
                    </div>
                </div>

                <!-- Team Events -->
                <div class="card bg-dark border-0 shadow mb-3" style="background-color: #16161a !important;">
                     <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent py-3">
                        <div class="d-flex align-items-center gap-2">
                             <span class="d-inline-block bg-primary rounded-1" style="width: 8px; height: 8px;"></span>
                             <h5 class="card-title text-white mb-0 fs-6 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Team Events</h5>
                        </div>
                    </div>
                    <div class="card-body p-3">
                         <button class="btn btn-primary d-flex align-items-center justify-content-center gap-2 w-100 mb-2 py-2 fw-bold" style="background-color: #007bff; border: none;" data-bs-toggle="modal" data-bs-target="#createEventModal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                              <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                            </svg>
                            Create New Event
                        </button>
                        <!-- Duplicated button as per mockup -->
                         <a href="{{ path('app_events') }}" class="btn btn-primary d-flex align-items-center justify-content-center gap-2 w-100 py-2 fw-bold" style="background-color: #007bff; border: none;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar-event" viewBox="0 0 16 16">
                              <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                              <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                            </svg>
                            View Events
                        </a>
                    </div>
                </div>

                <!-- Team Offers -->
                <div class="card bg-dark border-0 shadow" style="background-color: #16161a !important;">
                     <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent py-3">
                        <div class="d-flex align-items-center gap-2">
                             <span class="d-inline-block bg-warning rounded-1" style="width: 8px; height: 8px;"></span>
                             <h5 class="card-title text-white mb-0 fs-6 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Team Offers</h5>
                        </div>
                    </div>
                    <div class="card-body p-3">
                         <button class="btn btn-primary d-flex align-items-center justify-content-center gap-2 w-100 mb-2 py-2 fw-bold" style="background-color: #007bff; border: none;" data-bs-toggle="modal" data-bs-target="#createOfferModal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                              <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                            </svg>
                            Create New Offer
                        </button>
                         <button class="btn btn-primary d-flex align-items-center justify-content-center gap-2 w-100 py-2 fw-bold" style="background-color: #007bff; border: none;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                              <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                            </svg>
                            View Offer
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Column: Roster & Stats -->
            <div class="col-12 col-lg-8">
                <!-- Team Roster -->
                <div class="card bg-dark border-0 shadow mb-3" style="background-color: #16161a !important;">
                    <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent py-3">
                         <div class="d-flex align-items-center gap-2">
                             <h5 class="card-title text-white mb-0 fs-6 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Team Roster</h5>
                             <span class="text-secondary small ms-1">| 5 / 7 Members</span>
                         </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            {% for member in roster %}
                                <div class="list-group-item bg-transparent border-bottom border-secondary border-opacity-10 d-flex align-items-center justify-content-between px-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="position-relative">
                                            {% if member.profilePicture %}
                                                <img src="{{ asset('uploads/avatars/' ~ member.profilePicture) }}" class="rounded-circle" width="45" height="45" alt="{{ member.pseudo }}">
                                            {% else %}
                                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white fw-bold" style="width: 45px; height: 45px;">
                                                    {{ member.pseudo|first|upper }}
                                                </div>
                                            {% endif %}
                                            <span class="position-absolute bottom-0 end-0 p-1 rounded-circle {{ member.playerProfile.status|default('offline')|lower == 'online' ? 'bg-success' : 'bg-secondary' }} border border-dark"></span>
                                        </div>
                                        <div>
                                            <div class="text-white fw-bold">{{ member.pseudo }} 
                                                {% if member == team.owner %}
                                                    <span class="badge bg-warning text-dark ms-1" style="font-size: 0.6rem;">OWNER</span>
                                                {% endif %}
                                            </div>
                                            <div class="text-secondary small">{{ member.playerProfile.role|default('Member') }}</div>
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge rounded-pill {{ member.playerProfile.status|default('offline')|lower == 'online' ? 'bg-success bg-opacity-10 text-success border border-success border-opacity-25' : 'bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25' }} px-3 py-2 fw-normal">
                                            {{ member.playerProfile.status|default('Offline') }}
                                        </span>
                                        
                                        {% if app.user == team.owner and member != team.owner %}
                                            <form method="post" action="{{ path('team_remove_member', {id: team.id, userId: member.id}) }}" onsubmit="return confirm('Remove this member?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('remove_member_' ~ member.id) }}">
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-2" title="Remove Member">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            {% else %}
                                <div class="p-4 text-center text-muted">
                                    No members yet.
                                </div>
                            {% endfor %}
                        </div>
                        <div class="p-3 text-center">
                            <a href="#" class="text-decoration-none text-primary fw-bold" style="font-size: 0.9rem;">View All Members</a>
                        </div>
                    </div>
                </div>

                <!-- Online Players Stats -->
                <div class="card bg-dark border-0 shadow" style="background-color: #16161a !important; min-height: 250px;">
                     <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent py-3">
                         <div class="d-flex align-items-center gap-2">
                             <h5 class="card-title text-white mb-0 fs-6 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Online Players</h5>
                             <span class="text-secondary small ms-1">| 3 / 5 Online</span>
                         </div>
                    </div>
                    <div class="card-body p-4 position-relative overflow-hidden">
                        <!-- Background Graph Visual -->
                        <div class="position-absolute bottom-0 end-0 w-100" style="height: 120px; background: linear-gradient(to top, rgba(34, 197, 94, 0.1), transparent); clip-path: polygon(0% 100%, 15% 90%, 30% 95%, 45% 85%, 60% 92%, 75% 80%, 90% 88%, 100% 70%, 100% 100%);"></div>
                        <div class="position-absolute bottom-0 end-0 w-100" style="height: 120px; border-top: 2px solid #22c55e; clip-path: polygon(0% 100%, 15% 90%, 30% 95%, 45% 85%, 60% 92%, 75% 80%, 90% 88%, 100% 70%, 100% 71%, 100% 100%); opacity: 0.6;"></div>

                        <div class="d-flex flex-column gap-3 position-relative" style="z-index: 1;">
                            {% for member in roster|slice(0, 3) %}
                                 <div class="d-flex align-items-center gap-3">
                                    <div class="position-relative">
                                        {% if member.profilePicture %}
                                            <img src="{{ asset('uploads/avatars/' ~ member.profilePicture) }}" class="rounded-circle" width="35" height="35" alt="{{ member.pseudo }}">
                                        {% else %}
                                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white fw-bold" style="width: 35px; height: 35px; font-size: 0.8rem;">
                                                {{ member.pseudo|first|upper }}
                                            </div>
                                        {% endif %}
                                         <span class="position-absolute top-0 start-0 translate-middle p-1 rounded-circle bg-danger border border-dark" style="width: 8px; height: 8px; display: {{ loop.first ? 'block' : 'none' }};"></span>
                                    </div>
                                    <div class="lh-1">
                                        <div class="text-white fw-bold small mb-1">{{ member.pseudo }}</div>
                                        <div class="text-secondary" style="font-size: 0.75rem;">{{ member.playerProfile.status|default('In-Game') }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Manage My Offers Section -->
        <div class="row g-4 mt-4">
            <div class="col-12">
                <div class="d-flex align-items-center gap-3 mb-4 pb-2 border-bottom border-secondary border-opacity-25">
                     <div class="icon-box p-2 rounded text-warning">
                         <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-briefcase-fill" viewBox="0 0 16 16">
                          <path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v1.384l7.614 2.03a1.5 1.5 0 0 0 .772 0L16 5.884V4.5A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1h-3zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5z"/>
                          <path d="M0 12.5A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5V6.85L8.129 8.947a.5.5 0 0 1-.258 0L0 6.85v5.65z"/>
                        </svg>
                    </div>
                    <h2 class="h3 fw-bold text-white mb-0">Manage My Offers</h2>
                </div>
            </div>
            
            {% for o in offers %}
                <div class="col-12">
                     <div class="card h-100 border-secondary border-opacity-25" style="background-color: #16161a;">
                        <div class="row g-0 align-items-center">
                            <div class="col-md-3">
                                <div class="p-3" style="height: 200px;">
                                    {% if o.poster %}
                                        <img src="{{ asset('uploads/offers/' ~ o.poster) }}" alt="{{ o.role }}" class="img-fluid w-100 h-100 object-fit-cover rounded" style="object-position: center;">
                                    {% else %}
                                        <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-dark rounded border border-secondary border-opacity-25 text-white-50">
                                            No Poster
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="card-body d-flex flex-column h-100 p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h4 class="card-title text-white fw-bold mb-1">{{ o.title }}</h4>
                                            <h5 class="card-subtitle text-white-50 fw-bold mb-1" style="font-size: 1rem;">{{ o.team.name }}</h5>
                                            <p class="card-text text-white-50 small mb-0">{{ o.game }} • <span class="text-info">{{ o.role }}</span> • <span class="badge {{ o.game|lower == 'cs2' ? 'bg-success' : 'bg-primary' }}">{{ o.rank }}</span></p>
                                        </div>
                                        <small class="text-muted">{{ o.dateCreation|date('d M Y') }}</small>
                                    </div>
                                    
                                    <p class="card-text text-light flex-grow-1">{{ o.description }}</p>
                                    
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary border-opacity-25">
                                        <div class="text-muted small">
                                            Expires: {{ o.dateExpiration|date('d M Y') }}
                                        </div>
                                        <div class="d-flex gap-2">
                                            <form method="post" action="{{ path('offer_delete', {'id': o.id}) }}" onsubmit="return confirm('Are you sure you want to delete this offer?');" class="d-inline-block">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_offer_' ~ o.id) }}">
                                                <button type="submit" class="btn btn-sm btn-danger px-3 fw-bold">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </form>
                                            <a href="{{ path('offer_edit', {'id': o.id}) }}" class="btn btn-sm btn-primary px-3 fw-bold">
                                                <i class="bi bi-pencil me-1"></i> Modify
                                            </a>
                                        </div>
                                    </div>
                                    
                                    <!-- Applications Section -->
                                    <div class="mt-4">
                                        <h6 class="text-white fw-bold mb-3 d-flex align-items-center gap-2">
                                            <i class="bi bi-people-fill text-info"></i>
                                            Applications ({{ o.postulations|length }})
                                        </h6>
                                        <div class="application-list d-flex flex-column gap-2">
                                            {% for app in o.postulations %}
                                                <div class="application-item p-3 rounded bg-dark border border-secondary border-opacity-10 d-flex flex-wrap align-items-center justify-content-between gap-3">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                                            {{ app.user.pseudo|first|upper }}
                                                        </div>
                                                        <div>
                                                            <div class="text-white fw-bold">{{ app.user.pseudo }}</div>
                                                            <div class="text-muted small">Applied on {{ app.createdAt|date('d M Y') }}</div>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="badge-status-container">
                                                        {% if app.status == 'accepted' %}
                                                            <span class="badge bg-success text-white">Accepted</span>
                                                        {% elseif app.status == 'refused' %}
                                                            <span class="badge bg-danger text-white">Refused</span>
                                                        {% else %}
                                                            <span class="badge bg-warning text-dark">Pending</span>
                                                        {% endif %}
                                                    </div>

                                                    {% if app.status == 'pending' %}
                                                    <div class="d-flex gap-2 ms-auto">
                                                        <form method="post" action="{{ path('app_application_accept', {id: app.id}) }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ app.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-success">Accept</button>
                                                        </form>
                                                        <form method="post" action="{{ path('app_application_refuse', {id: app.id}) }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('refuse' ~ app.id) }}">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">Refuse</button>
                                                        </form>
                                                    </div>
                                                    {% endif %}
                                                </div>
                                                {% if app.message %}
                                                    <div class="ms-4 ps-4 border-start border-secondary border-opacity-25 pb-3">
                                                        <div class="text-white-50 small italic">"{{ app.message }}"</div>
                                                    </div>
                                                {% endif %}
                                            {% else %}
                                                <p class="text-muted small">No applications yet.</p>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                     <div class="p-5 rounded bg-black bg-opacity-25 border border-secondary border-opacity-10 text-center">
                        <p class="text-white-50 mb-0">No offers created yet.</p>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# Include My Events Section from FrontEventController #}
        {{ render(controller('App\\Controller\\FrontEventController::myEventsManage')) }}
    </div>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}

    <!-- Create Event Modal -->
    <div class="modal fade" id="createEventModal" tabindex="-1" aria-labelledby="createEventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content text-white border border-secondary border-opacity-25" style="background-color: #1a1a1f;">
                <div class="modal-header border-secondary border-opacity-25">
                    <h5 class="modal-title" id="createEventModalLabel">Create New Event</h5>

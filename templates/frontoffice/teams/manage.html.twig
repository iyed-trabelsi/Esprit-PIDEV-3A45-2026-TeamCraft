{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const gameSelect = document.getElementById('gameSelect');
        const roleSelect = document.getElementById('roleSelect');
        const rankSelect = document.getElementById('rankSelect');

        const gameData = {
            'VALORANT': {
                roles: ['Duellistes', 'Initiators', 'Controllers', 'Sentinelles'],
                ranks: ['Iron', 'Bronze', 'Silver', 'Gold', 'Platinum', 'Diamond', 'Ascendant', 'Immortal', 'Radiant']
            },
            'LOL': {
                roles: ['TOP', 'JGL', 'MID', 'ADC', 'Support'],
                ranks: ['Iron', 'Bronze', 'Silver', 'Gold', 'Platinum', 'Emerald', 'Diamond', 'Master', 'Grandmaster', 'Challenger']
            },
            'CS2': {
                roles: ['Entry Fragger', 'Sniper (AWP)', 'In-Game Leader', 'Lurker', 'Support', 'Anchor'],
                ranks: ['Silver', 'Silver Elite', 'Silver Elite Master', 'Gold Nova', 'Gold Nova Master', 'Master Guardian', 'Master Guardian Elite', 'Distinguished Master Guardian', 'Legendary Eagle', 'Legendary Eagle Master', 'Supreme Master First Class', 'Global Elite']
            }
        };

        function updateOptions(selectElement, options) {
            selectElement.innerHTML = '<option value="" selected disabled>Select ' + (selectElement.id === 'roleSelect' ? 'Role' : 'Rank') + '</option>';
            if (options) {
                options.forEach(opt => {
                    const option = document.createElement('option');
                    option.value = opt;
                    option.textContent = opt;
                    selectElement.appendChild(option);
                });
            }
        }

        function handleGameChange(triggerValue) {
            const data = gameData[triggerValue];
            if (data) {
                updateOptions(roleSelect, data.roles);
                updateOptions(rankSelect, data.ranks);
                
                // Restore selected values if they exist and match the current game/options
                const selectedRole = roleSelect.getAttribute('data-selected-value');
                if (selectedRole && data.roles.includes(selectedRole)) {
                    roleSelect.value = selectedRole;
                }
                
                const selectedRank = rankSelect.getAttribute('data-selected-value');
                if (selectedRank && data.ranks.includes(selectedRank)) {
                    rankSelect.value = selectedRank;
                }
            } else {
                updateOptions(roleSelect, []);
                updateOptions(rankSelect, []);
            }
        }

        gameSelect.addEventListener('change', function() {
            handleGameChange(this.value);
            // Clear the data-selected-value attribute to avoid re-selecting old values on subsequent changes
            roleSelect.removeAttribute('data-selected-value');
            rankSelect.removeAttribute('data-selected-value');
        });

        // Initialize on load if a game is selected
        if (gameSelect.value) {
            handleGameChange(gameSelect.value);
        }
    });
</script>

<!-- Team Chat Modal -->
<style>
    .chat-modal-content {
        background-color: #0A0C10; /* Fond principal profond */
        border: 1px solid rgba(74, 158, 255, 0.2); /* Bordure subtile glow */
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
        border-radius: 16px;
        overflow: hidden;
    }
    .chat-header {
        background: linear-gradient(90deg, #1A1D23 0%, #0A0C10 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 15px 20px;
    }
    .chat-body {
        background-color: #16181C; /* Fond zone messages */
        background-image: radial-gradient(#1A1D23 1px, transparent 1px);
        background-size: 20px 20px;
    }
    .chat-footer {
        background-color: #0A0C10;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding: 15px;
    }
    
    /* Messages */
    .msg-bubble {
        border-radius: 18px;
        padding: 12px 18px;
        position: relative;
        font-size: 0.95rem;
        line-height: 1.4;
        transition: all 0.2s ease;
        animation: msgPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes msgPop { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
    
    .msg-bubble.no-animation {
        animation: none;
    }

    .msg-owner {
        background: linear-gradient(135deg, rgba(42, 128, 241, 0.15), rgba(42, 128, 241, 0.05));
        border: 1px solid rgba(42, 128, 241, 0.5);
        color: #F0F4FA;
        box-shadow: 0 4px 15px rgba(42, 128, 241, 0.1);
        border-bottom-right-radius: 4px;
    }
    .msg-co-owner {
        background: linear-gradient(135deg, rgba(46, 204, 113, 0.15), rgba(46, 204, 113, 0.05));
        border: 1px solid rgba(46, 204, 113, 0.5);
        color: #F0F4FA;
        box-shadow: 0 4px 15px rgba(46, 204, 113, 0.1);
        border-bottom-right-radius: 4px;
    }
    .msg-member {
        background-color: #2D313A;
        border: 1px solid #3A3F4B;
        color: #E2E8F0;
        border-bottom-left-radius: 4px;
    }
    
    .avatar-ring {
        transition: transform 0.2s;
    }
    .avatar-ring:hover {
        transform: scale(1.1);
    }
    
    /* Scrollbar */
    #chatMessages::-webkit-scrollbar { width: 6px; }
    #chatMessages::-webkit-scrollbar-track { background: #0A0C10; }
    #chatMessages::-webkit-scrollbar-thumb { background: #3A3F4B; border-radius: 10px; }
    #chatMessages::-webkit-scrollbar-thumb:hover { background: #4A9EFF; }

    /* Input */
    .chat-input {
        background-color: #1A1D23;
        border: 1px solid #3A3F4B;
        color: white;
        border-radius: 20px;
        padding-left: 15px;
    }
    .chat-input:focus {
        background-color: #1A1D23;
        color: white;
        border-color: #4A9EFF;
        box-shadow: 0 0 0 0.2rem rgba(74, 158, 255, 0.25);
    }
</style>


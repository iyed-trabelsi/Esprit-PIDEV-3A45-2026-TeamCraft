                    <script>
                    // Prevent z-index issues caused by nested modals by moving to body
                    (function() {
                        const modal = document.getElementById('aiDetailsModalFront');
                        if (modal) document.body.appendChild(modal);
                    })();

                    document.addEventListener('DOMContentLoaded', function() {
                        const btnFront = document.getElementById('ai-generate-btn-front');
                        if (btnFront) {
                            btnFront.addEventListener('click', function(e) {
                                e.preventDefault();
                                const originalText = btnFront.innerHTML;
                                btnFront.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Analyse historique en cours...';
                                btnFront.disabled = true;

                                fetch('/api/events/ai-generate')
                                    .then(res => res.json())
                                    .then(response => {
                                        if (response.success && response.data) {
                                            const data = response.data;

                                            // Fill the form fields
                                            const nomInput   = document.querySelector('#createEventModal [id$="_nomEvenement"]');
                                            const typeInput  = document.querySelector('#createEventModal [id$="_typeEvenement"]');
                                            const debutInput = document.querySelector('#createEventModal [id$="_dateDebut"]');
                                            const finInput   = document.querySelector('#createEventModal [id$="_dateFin"]');
                                            if (data.nomEvenement  && nomInput)   nomInput.value   = data.nomEvenement;
                                            if (data.typeEvenement && typeInput)  typeInput.value  = data.typeEvenement;
                                            if (data.dateDebut     && debutInput) debutInput.value = data.dateDebut;
                                            if (data.dateFin       && finInput)   finInput.value   = data.dateFin;

                                            // Populate rich modal fields
                                            const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val || ''; };
                                            set('ai-summary-text-front',      data.reasoning      || "Analyse complète disponible ci-dessous.");
                                            set('ai-confidence-front',        data.confidence_score ? data.confidence_score + '%' : '—');
                                            set('ai-event-type-badge-front',  data.typeEvenement  || '—');
                                            set('ai-event-name-badge-front',  data.nomEvenement   || '—');
                                            set('ai-insights-text-front',     data.data_insights  || data.reasoning || '');
                                            set('ai-time-text-front',         data.time_rationale || '');
                                            set('ai-type-text-front',         data.type_rationale || '');

                                            // Show "Voir détails" link and open modal
                                            const detailsBtn = document.getElementById('ai-details-btn-front');
                                            if (detailsBtn) detailsBtn.classList.remove('d-none');

                                            const modalElement = document.getElementById('aiDetailsModalFront');
                                            if (modalElement) {
                                                const aiModal = new bootstrap.Modal(modalElement);
                                                aiModal.show();
                                            }
                                        }
                                    })
                                    .catch(err => console.error("AI Fetch Error: ", err))
                                    .finally(() => {
                                        btnFront.innerHTML = originalText;
                                        btnFront.disabled = false;
                                    });
                            });
                        }
                    });
                    </script>
                </div>
            </div>

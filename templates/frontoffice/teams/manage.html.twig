{% extends 'frontoffice/base.html.twig' %}

{% block title %}Manage Team - {{ team.name }}{% endblock %}

{% block stylesheets %}
<style>
    /* Add Place SUB-MODAL Styling */
    .calendar-modal-content {
        background: rgba(13, 13, 27, 0.96) !important;
        backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    
    /* Team roster scrollable container */
    .team-roster-container {
        max-height: 600px;
        overflow-y: auto;
    }
    
    .team-roster-container .list-group-item {
        transition: opacity 0.3s ease;
    }
    
    .team-roster-container .list-group-item.hidden {
        display: none !important;
    }
    
    .team-roster-container::-webkit-scrollbar {
        width: 8px;
    }
    
    .team-roster-container::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
    }
    
    .team-roster-container::-webkit-scrollbar-thumb {
        background: var(--tc-cyan, #0dcaf0);
        border-radius: 4px;
    }
    
    .team-roster-container::-webkit-scrollbar-thumb:hover {
        background: #0ab7d4;
    }
    
    /* Offer card banner styling - exactly like events but smaller */
    .offer-card-banner {
        width: 100%;
        aspect-ratio: 16 / 10;  /* Slightly smaller ratio */
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 1rem;     /* Reduced margin */
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: block;
    }
</style>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <div class="container py-5 flex-grow-1">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
             <div class="d-flex align-items-center gap-3">
                <div class="icon-box p-2 rounded text-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-gear" viewBox="0 0 16 16">
                      <path d="M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm.256 7a4.474 4.474 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.36 10 8 10c.049 0 .098.001.147.005A4.49 4.49 0 0 1 8 13.5a4.49 4.49 0 0 1 4.642-4.745.5.5 0 0 1 .508.495v.005a5.503 5.503 0 0 0 .507.005H14a.5.5 0 0 1 .495.508V14a.5.5 0 0 1-.508.495H8.256Zm-.055-.494A3.5 3.5 0 0 0 12 10.5a3.49 3.49 0 0 0-3.417 3.46c.01.21.03.418.06.621.037.247.112.483.218.705.105.218.243.417.408.598.66.721 1.638 1.116 2.731 1.116s2.07-.395 2.731-1.116c.165-.181.303-.38.408-.598.106-.222.181-.458.218-.705.03-.203.05-.411.06-.621A3.49 3.49 0 0 0 12 10.5Zm-8.497.001a.5.5 0 0 1-.005.494.5.5 0 0 1-.495-.005.5.5 0 0 1-.005-.494.5.5 0 0 1 .495.005.5.5 0 0 1 .005.494Z"/>
                      <path d="M13.43 12.18c-.027-.378-.073-.75-.138-1.113l-.007-.038a4.507 4.507 0 0 0-.276-1.026l.006-.033a3.507 3.507 0 0 0-.308-.72l.006-.035a2.508 2.508 0 0 0-.29-.53l.004-.025a1.505 1.505 0 0 0-.374-.75h.001l-.002-.002a2.495 2.495 0 0 0-.002 4.28 2.477 2.477 0 0 0 1.396-.008Z"/>
                    </svg>
                </div>
                <h1 class="h3 fw-bold text-white mb-0">{{ isOwner ? 'Manage My Team' : (canManage ? 'Manage Team' : 'View Team') }}</h1>
             </div>
             <div class="d-flex gap-2">
                 <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-2 px-3" data-bs-toggle="modal" data-bs-target="#teamChatModal">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chat-dots-fill" viewBox="0 0 16 16">
                      <path d="M16 8c0 3.866-3.582 7-8 7a9.06 9.06 0 0 1-2.347-.306c-.584.296-1.925.864-4.181 1.234-.2.032-.352-.176-.273-.362.354-.836.674-1.95.77-2.966C.744 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7zM5 8a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm4 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                    </svg>
                    Team Chat
                 </button>
                 <a href="{{ path('app_teams') }}" class="btn btn-outline-light btn-sm d-flex align-items-center gap-2 px-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                      <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                    </svg>
                    Return
                 </a>
             </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Team Info, Events, Offers -->
            <div class="col-12 col-lg-4">
                <!-- Team Identity Card -->
                <div class="card bg-dark border-0 shadow mb-3" style="background-color: #16161a !important;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="rounded-circle p-1 border border-warning border-opacity-25">
                                {% if team.logo %}
                                    <img src="{{ asset('uploads/teams/' ~ team.logo) }}" alt="{{ team.name }}" class="rounded-circle object-fit-cover" width="60" height="60">
                                {% else %}
                                    <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center text-dark fw-bold fs-4" style="width: 60px; height: 60px;">
                                        {{ team.name|first|upper }}
                                    </div>
                                {% endif %}
                            </div>
                            <div>
                                <h2 class="h5 fw-bold text-white mb-0">{{ team.name }}</h2>
                                <p class="text-secondary mb-0 small">
                                    {% if teamGames is defined and teamGames|length > 0 %}
                                        {{ teamGames|join(', ') }}
                                    {% else %}
                                        No games selected
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                        
                        {% if isOwner %}
                        <div class="d-flex gap-2">
                            <a href="{{ path('team_edit', {'id': team.id}) }}" class="btn btn-success flex-grow-1 fw-bold" style="font-size: 0.9rem;">Edit Team</a>
                            
                            <form method="post" action="{{ path('team_delete', {'id': team.id}) }}" class="flex-grow-1" onsubmit="return confirm('Are you sure you want to delete this team? This action cannot be undone.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_team_' ~ team.id) }}">
                                <button type="submit" class="btn btn-danger w-100 fw-bold" style="font-size: 0.9rem;">Delete Team</button>
                            </form>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Recruitment Dashboard -->
                {% if canManage %}
                <div class="card bg-dark border-0 shadow mb-3" style="background-color: #16161a !important;">
                     <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent py-3">
                        <div class="d-flex align-items-center gap-2">
                             <span class="d-inline-block bg-info rounded-1" style="width: 8px; height: 8px;"></span>
                             <h5 class="card-title text-white mb-0 fs-6 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Recruitment</h5>
                        </div>
                    </div>
                    <div class="card-body p-3">
                         <a href="{{ path('team_applications', {id: team.id}) }}" class="btn btn-info d-flex align-items-center justify-content-center gap-2 w-100 py-2 fw-bold text-white" style="border: none;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-lines-fill" viewBox="0 0 16 16">
                              <path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-5 6s-1 0-1-1 1-4 6-4 6 3 6 4 1 1 1H1zm11-9a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                              <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                            </svg>
                            Manage Recruitments
                        </a>
                    </div>
                </div>
                {% endif %}

                <!-- ── Live Stream Card ─────────────────────────────────── -->
                <div class="card bg-dark border-0 shadow mb-3" style="background-color: #16161a !important;">
                    <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <span class="d-inline-block bg-danger rounded-1" style="width: 8px; height: 8px;"></span>
                                <h5 class="card-title text-white mb-0 fs-6 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Live Stream</h5>
                            </div>
                            <!-- LIVE indicator (shown when a stream is active) -->
                            <span id="liveStatusBadge" class="badge text-white d-none" style="background:#dc2626; font-size:0.65rem; letter-spacing:1px; animation: livePulse 2s infinite;">
                                ● LIVE
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-3 d-flex flex-column gap-2">
                        {% if canManage %}
                        <a href="{{ path('team_broadcast', {id: team.id}) }}"
                           class="btn d-flex align-items-center justify-content-center gap-2 w-100 py-2 fw-bold text-white"
                           style="background: linear-gradient(135deg, #dc2626, #b91c1c); border: none;">
                            <i class="bi bi-broadcast"></i> Go Live
                        </a>
                        {% endif %}
                        <a href="{{ path('team_live', {id: team.id}) }}"
                           class="btn d-flex align-items-center justify-content-center gap-2 w-100 py-2 fw-bold"
                           style="background: transparent; border: 1px solid #334155; color: #94a3b8;">
                            <i class="bi bi-play-circle"></i> Watch Live
                        </a>
                        <div class="text-center" id="liveViewerCount" style="display:none; font-size:0.72rem; color:#64748b;">
                            <i class="bi bi-eye me-1"></i><span id="liveViewerNum">0</span> spectateur(s) en direct
                        </div>
                    </div>
                </div>

                <style>
                @keyframes livePulse {
                    0%, 100% { box-shadow: 0 0 0 0 rgba(220,38,38,0.5); }
                    50%       { box-shadow: 0 0 0 5px rgba(220,38,38,0); }
                }
                </style>
                <script>
                (function() {
                    const badge      = document.getElementById('liveStatusBadge');
                    const viewerInfo = document.getElementById('liveViewerCount');
                    const viewerNum  = document.getElementById('liveViewerNum');

                    function checkLiveStatus() {
                        fetch('https://bits-geological-procedure-telecharger.trycloudflare.com/room/{{ team.id }}/status')
                            .then(r => r.json())
                            .then(data => {
                                if (data.isLive) {
                                    badge.classList.remove('d-none');
                                    viewerInfo.style.removeProperty('display');
                                    viewerNum.textContent = data.viewerCount;
                                } else {
                                    badge.classList.add('d-none');
                                    viewerInfo.style.display = 'none !important';
                                }
                            })
                            .catch(() => {
                                // Signaling server not reachable — hide badge silently
                                badge.classList.add('d-none');
                            });
                    }

                    checkLiveStatus();
                    setInterval(checkLiveStatus, 5000);
                })();

                // Team Roster Search Functionality
                const teamRosterSearch = document.getElementById('team-roster-search');
                const teamRosterContainer = document.querySelector('.team-roster-container');
                const teamRosterItems = teamRosterContainer.querySelectorAll('.list-group-item');

                if (teamRosterSearch) {
                    teamRosterSearch.addEventListener('input', (e) => {
                        const searchTerm = e.target.value.toLowerCase().trim();
                        
                        teamRosterItems.forEach(item => {
                            const memberName = item.querySelector('.text-white.fw-bold')?.textContent.toLowerCase() || '';
                            const memberRole = item.querySelector('.text-secondary.small')?.textContent.toLowerCase() || '';
                            
                            if (memberName.includes(searchTerm) || memberRole.includes(searchTerm)) {
                                item.style.display = 'flex';
                            } else {
                                item.style.display = 'none';
                            }
                        });
                    });
                }
                </script>

                <!-- ───────────────────────────────────────────────────────── -->


                {% if canManage %}
                <div class="card bg-dark border-0 shadow mb-3" style="background-color: #16161a !important;">
                     <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent py-3">
                        <div class="d-flex align-items-center gap-2">
                             <span class="d-inline-block bg-primary rounded-1" style="width: 8px; height: 8px;"></span>
                             <h5 class="card-title text-white mb-0 fs-6 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Team Events</h5>
                        </div>
                    </div>
                    <div class="card-body p-3">
                         <button class="btn btn-primary d-flex align-items-center justify-content-center gap-2 w-100 mb-2 py-2 fw-bold" style="background-color: #007bff; border: none;" data-bs-toggle="modal" data-bs-target="#createEventModal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                              <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                            </svg>
                            Create New Event
                        </button>
                        <!-- Duplicated button as per mockup -->
                         <a href="{{ path('app_events') }}" class="btn btn-primary d-flex align-items-center justify-content-center gap-2 w-100 py-2 fw-bold" style="background-color: #007bff; border: none;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar-event" viewBox="0 0 16 16">
                              <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                              <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                            </svg>
                            View Events
                        </a>
                    </div>
                </div>
                {% endif %}

                <!-- Team Offers -->
                <div class="card bg-dark border-0 shadow" style="background-color: #16161a !important;">
                     <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent py-3">
                        <div class="d-flex align-items-center gap-2">
                             <span class="d-inline-block bg-warning rounded-1" style="width: 8px; height: 8px;"></span>
                             <h5 class="card-title text-white mb-0 fs-6 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Team Offers</h5>
                        </div>
                    </div>
                    <div class="card-body p-3">
                         <button class="btn btn-primary d-flex align-items-center justify-content-center gap-2 w-100 mb-2 py-2 fw-bold" style="background-color: #007bff; border: none;" data-bs-toggle="modal" data-bs-target="#createOfferModal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                              <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                            </svg>
                            Create New Offer
                        </button>
                         <button class="btn btn-primary d-flex align-items-center justify-content-center gap-2 w-100 py-2 fw-bold" style="background-color: #007bff; border: none;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                              <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                            </svg>
                            View Offer
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Column: Roster & Stats -->
            <div class="col-12 col-lg-8">
                <!-- Team Roster -->
                <div class="card bg-dark border-0 shadow mb-3" style="background-color: #16161a !important;">
                    <div class="card-header border-bottom border-secondary border-opacity-25 bg-transparent py-3">
                         <div class="d-flex align-items-center justify-content-between gap-2">
                             <h5 class="card-title text-white mb-0 fs-6 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Team Roster</h5>
                             
                             <!-- Search Input -->
                             <div class="position-relative">
                                 <input type="text" id="team-roster-search" class="form-control form-control-sm text-white ps-5" placeholder="Rechercher un membre..." style="background-color: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); min-width: 250px; border-radius: 20px;">
                                 <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                             </div>
                         </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="team-roster-container list-group list-group-flush">
                            {% for member in roster %}
                                <div class="list-group-item bg-transparent border-bottom border-secondary border-opacity-10 d-flex align-items-center justify-content-between px-4 py-3" 
                                     data-name="{{ member.pseudo|lower }}" 
                                     data-role="{{ member.playerProfile.role|default('Member')|lower }}">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="position-relative">
                                            {% if member.profilePicture %}
                                                <img src="{{ asset(member.profilePicture) }}" class="rounded-circle" width="45" height="45" alt="{{ member.pseudo }}" style="object-fit: cover;">
                                            {% else %}
                                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white fw-bold" style="width: 45px; height: 45px;">
                                                    {{ member.pseudo|first|upper }}
                                                </div>
                                            {% endif %}
                                            <span class="position-absolute bottom-0 end-0 p-1 rounded-circle {{ member.playerProfile.status|default('offline')|lower == 'online' ? 'bg-success' : 'bg-secondary' }} border border-dark"></span>
                                        </div>
                                        <div>
                                            <div class="text-white fw-bold">{{ member.pseudo }} 
                                                {% if member == team.owner %}
                                                    <span class="badge bg-warning text-dark ms-1" style="font-size: 0.6rem;">OWNER</span>
                                                {% elseif team.isCoOwner(member) %}
                                                    <span class="badge bg-info text-dark ms-1" style="font-size: 0.6rem;">CO-OWNER</span>
                                                {% endif %}
                                            </div>
                                            <div class="text-secondary small">{{ member.playerProfile.role|default('Member') }}</div>
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge rounded-pill {{ member.playerProfile.status|default('offline')|lower == 'online' ? 'bg-success bg-opacity-10 text-success border border-success border-opacity-25' : 'bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25' }} px-3 py-2 fw-normal">
                                            {{ member.playerProfile.status|default('Offline') }}
                                        </span>
                                        
                                        {% if isOwner and member != team.owner %}
                                            {% if team.isCoOwner(member) %}
                                                <form method="post" action="{{ path('team_demote_co_owner', {id: team.id, userId: member.id}) }}" class="d-inline" onsubmit="return confirm('Demote this member?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('demote_co_owner_' ~ member.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-link text-warning p-0 ms-2" title="Demote to Member">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-down-circle" viewBox="0 0 16 16">
                                                          <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8zm15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8.5 4.5a.5.5 0 0 0-1 0v5.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V4.5z"/>
                                                        </svg>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <form method="post" action="{{ path('team_promote_co_owner', {id: team.id, userId: member.id}) }}" class="d-inline" onsubmit="return confirm('Promote to Co-Owner?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('promote_co_owner_' ~ member.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-link text-success p-0 ms-2" title="Promote to Co-Owner">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-up-circle" viewBox="0 0 16 16">
                                                          <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8zm15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-7.5 3.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V11.5z"/>
                                                        </svg>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        {% endif %}

                                        {% if canManage and member != team.owner %}
                                            {% if not team.isCoOwner(member) or isOwner %}
                                            <form method="post" action="{{ path('team_remove_member', {id: team.id, userId: member.id}) }}" class="d-inline" onsubmit="return confirm('Remove this member?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('remove_member_' ~ member.id) }}">
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-2" title="Remove Member">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle" viewBox="0 0 16 16">
                                                      <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>

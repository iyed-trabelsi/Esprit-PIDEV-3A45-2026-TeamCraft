{% block scripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const gameSelect = document.getElementById('gameSelect');
        const roleSelect = document.getElementById('roleSelect');
        const rankSelect = document.getElementById('rankSelect');

        const gameData = {
            'VALORANT': {
                roles: ['Duellistes', 'Initiators', 'Controllers', 'Sentinelles'],
                ranks: ['Iron', 'Bronze', 'Silver', 'Gold', 'Platinum', 'Diamond', 'Ascendant', 'Immortal', 'Radiant']
            },
            'LOL': {
                roles: ['TOP', 'JGL', 'MID', 'ADC', 'Support'],
                ranks: ['Iron', 'Bronze', 'Silver', 'Gold', 'Platinum', 'Emerald', 'Diamond', 'Master', 'Grandmaster', 'Challenger']
            },
            'CS2': {
                roles: ['Entry Fragger', 'Sniper (AWP)', 'In-Game Leader', 'Lurker', 'Support', 'Anchor'],
                ranks: ['Silver', 'Silver Elite', 'Silver Elite Master', 'Gold Nova', 'Gold Nova Master', 'Master Guardian', 'Master Guardian Elite', 'Distinguished Master Guardian', 'Legendary Eagle', 'Legendary Eagle Master', 'Supreme Master First Class', 'Global Elite']
            }
        };

        function updateOptions(selectElement, options) {
            selectElement.innerHTML = '<option value="" selected disabled>Select ' + (selectElement.id === 'roleSelect' ? 'Role' : 'Rank') + '</option>';
            if (options) {
                options.forEach(opt => {
                    const option = document.createElement('option');
                    option.value = opt;
                    option.textContent = opt;
                    selectElement.appendChild(option);
                });
            }
        }

        function handleGameChange(triggerValue) {
            const data = gameData[triggerValue];
            if (data) {
                updateOptions(roleSelect, data.roles);
                updateOptions(rankSelect, data.ranks);
                
                // Restore selected values if they exist and match the current game/options
                const selectedRole = roleSelect.getAttribute('data-selected-value');
                if (selectedRole && data.roles.includes(selectedRole)) {
                    roleSelect.value = selectedRole;
                }
                
                const selectedRank = rankSelect.getAttribute('data-selected-value');
                if (selectedRank && data.ranks.includes(selectedRank)) {
                    rankSelect.value = selectedRank;
                }
            } else {
                updateOptions(roleSelect, []);
                updateOptions(rankSelect, []);
            }
        }

        gameSelect.addEventListener('change', function() {
            handleGameChange(this.value);
            // Clear the data-selected-value attribute to avoid re-selecting old values on subsequent changes
            roleSelect.removeAttribute('data-selected-value');
            rankSelect.removeAttribute('data-selected-value');
        });

        // Initialize on load if a game is selected
        if (gameSelect.value) {
            handleGameChange(gameSelect.value);
        }

        // --- LEAFLET JS FOR "ADD PLACE" SUB-MODAL ---
        let placeMap = null;
        let placeMarker = null;
        const addPlaceModalEl = document.getElementById('addPlaceModal');
        const addressInput = document.getElementById('place_adresse');
        const saveBtn = document.getElementById('btnSubmitPlace');

        function updateLocation(lat, lng) {
            if (placeMarker) {
                placeMarker.setLatLng([lat, lng]);
            } else {
                placeMarker = L.marker([lat, lng]).addTo(placeMap);
            }

            addressInput.value = "Recherche d'adresse en cours...";
            fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`, {
                headers: { 'Accept-Language': 'fr' }
            })
            .then(response => response.json())
            .then(data => {
                if (data && data.display_name) {
                    addressInput.value = data.display_name;
                } else {
                    addressInput.value = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
                }
            })
            .catch(err => {
                console.error("Geocoding failed", err);
                addressInput.value = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
            });
        }

        addPlaceModalEl.addEventListener('hidden.bs.modal', function () {
            const createEventModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('createEventModal'));
            createEventModal.show();
        });

        addPlaceModalEl.addEventListener('shown.bs.modal', function () {
            // Initialize map only once
            if (!placeMap) {
                // Default center
                placeMap = L.map('placeMap').setView([36.8065, 10.1815], 10);
                
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(placeMap);

                // Add Search Control (Leaflet Geocoder plugin)
                var geocoder = L.Control.geocoder({
                    defaultMarkGeocode: false,
                    placeholder: "Rechercher un lieu...",
                    errorMessage: "Adresse non trouvée."
                })
                .on('markgeocode', function(e) {
                    var latlng = e.geocode.center;
                    
                    // Auto-center & Zoom on search result
                    placeMap.setView(latlng, 16); 
                    
                    if (placeMarker) {
                        placeMarker.setLatLng(latlng);
                    } else {
                        placeMarker = L.marker(latlng).addTo(placeMap);
                    }
                    
                    // For direct search result, use the Geocoder returned name
                    const resolvedAddress = e.geocode.name || Object.values(e.geocode.properties.address || {}).join(', ');
                    addressInput.value = resolvedAddress;
                })
                .addTo(placeMap);

                // Map click handler
                placeMap.on('click', function(e) {
                    updateLocation(e.latlng.lat, e.latlng.lng);
                });

                // Use My Location handler
                document.getElementById('btnCurrentLocation').addEventListener('click', function() {
                    if ("geolocation" in navigator) {
                        const btn = document.getElementById('btnCurrentLocation');
                        const originalHTML = btn.innerHTML;
                        
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Localisation...';
                        btn.disabled = true;

                        navigator.geolocation.getCurrentPosition(function(position) {
                            const lat = position.coords.latitude;
                            const lng = position.coords.longitude;
                            
                            // Auto-center & Zoom on Current Location
                            placeMap.setView([lat, lng], 16); 
                            updateLocation(lat, lng);

                            btn.innerHTML = originalHTML;
                            btn.disabled = false;
                        }, function(error) {
                            alert("Erreur de localisation. Veuillez autoriser l'accès à votre position.");
                            btn.innerHTML = originalHTML;
                            btn.disabled = false;
                        }, {
                            timeout: 10000,
                            enableHighAccuracy: true
                        });
                    } else {
                        alert("La géolocalisation n'est pas supportée par votre navigateur.");
                    }
                });
            }
            
            // Very important: Fix Leaflet gray boxes inside Bootstrap Modal
            setTimeout(() => { placeMap.invalidateSize(); }, 200);
        });

        // AJAX Form Submission
        saveBtn.addEventListener('click', function(e) {
            e.preventDefault();
            
            // Clear previous errors
            document.querySelectorAll('.place-error').forEach(el => el.innerText = '');
            
            const payload = {
                nomPlace: document.getElementById('place_nom').value,
                typePlace: document.getElementById('place_type').value,
                capaciteMax: document.getElementById('place_capacite').value,
                adresse: addressInput.value
            };

            const btnText = document.getElementById('placeSubmitText');
            const loader = document.getElementById('placeSubmitLoader');
            
            btnText.classList.add('d-none');
            loader.classList.remove('d-none');
            saveBtn.disabled = true;

            fetch('/api/place/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Success: Hide sub-modal
                    const modal = bootstrap.Modal.getInstance(addPlaceModalEl);
                    modal.hide();
                    
                    // Update the Place dropdown in Create Event Modal
                    const placeSelect = document.querySelector('select[name*="[place]"]');
                    if (placeSelect) {
                        const newOption = new Option(data.place.nomPlace, data.place.id, true, true);
                        placeSelect.add(newOption);
                    }
                    
                    alert(data.message);
                } else {
                    // Display Validation Errors directly under inputs
                    for (const [field, msg] of Object.entries(data.errors)) {
                        const errEl = document.getElementById('error-' + field);
                        if (errEl) errEl.innerText = msg;
                    }
                }
            })
            .catch(err => {
                alert("Erreur système lors de l'ajout.");
                console.error(err);
            })
            .finally(() => {
                btnText.classList.remove('d-none');
                loader.classList.add('d-none');
                saveBtn.disabled = false;
            });
        });
    });
</script>
{% endblock %}

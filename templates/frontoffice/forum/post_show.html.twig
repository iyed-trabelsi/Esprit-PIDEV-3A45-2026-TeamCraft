{% block scripts %}
<style>
    .comment-input-white::placeholder {
        color: rgba(255, 255, 255, 0.7) !important;
        opacity: 1;
    }
    .comment-input-white::-ms-input-placeholder { /* Edge 12-18 */
        color: rgba(255, 255, 255, 0.7) !important;
    }
</style>
<script>
    // VoiceRSS Text-to-Speech
    let currentAudio = null;
    let currentBtn = null; // Track the currently active button

    window.playTTS = function(text, btn) {
        console.log("playTTS called with text:", text); // Debug
        
        // If clicking the SAME button that is currently playing -> Stop
        if (currentAudio && currentBtn === btn) {
            currentAudio.pause();
            currentAudio = null;
            const icon = btn.querySelector('i');
            icon.className = 'bi bi-megaphone text-secondary'; // Reset to original state
            currentBtn = null;
            return; // Stop here
        }

        // If clicking a DIFFERENT button or nothing is playing
        if (currentAudio) {
            currentAudio.pause();
            const prevIcon = currentBtn.querySelector('i');
            if (prevIcon) prevIcon.className = 'bi bi-megaphone text-secondary'; // Reset previous
            currentAudio = null;
            currentBtn = null;
        }
        
        // Start new audio
        currentBtn = btn;
        const icon = btn.querySelector('i');
        const originalIconClass = 'bi bi-megaphone text-secondary'; // Helper to restore
        icon.className = 'bi bi-stop-fill text-danger'; // Show stop icon while playing
        
        const apiKey = 'e7d912a975d84ecfb6c2d9c712cb67db';
        
        // Auto-detect language: if text contains Arabic characters, use ar-sa, otherwise fr-fr
        const isArabic = /[\u0600-\u06FF]/.test(text);
        const lang = isArabic ? 'ar-sa' : 'fr-fr';
        
        // Add c=mp3 and f=16khz_16bit_stereo for better compatibility
        const url = `https://api.voicerss.org/?key=${apiKey}&hl=${lang}&c=MP3&f=16khz_16bit_stereo&src=${encodeURIComponent(text)}`;
        console.log("TTS URL:", url, "Language detected:", lang); // Debug

        currentAudio = new Audio(url);
        
        // Debug events
        currentAudio.onloadeddata = function() {
            console.log("Audio data loaded");
        };
        currentAudio.onplay = function() {
            console.log("Audio playing");
        };
        
        currentAudio.onended = function() {
            console.log("Audio ended");
            icon.className = originalIconClass; // Reset icon
            currentAudio = null;
            currentBtn = null;
        };
        currentAudio.onerror = function(e) {
            console.error("Audio Error:", e);
            const err = currentAudio.error;
            let errMsg = "Erreur inconnue";
            if (err) {
                 switch (err.code) {
                     case err.MEDIA_ERR_ABORTED: errMsg = "Lecture annulée"; break;
                     case err.MEDIA_ERR_NETWORK: errMsg = "Erreur réseau (vérifiez votre connexion)"; break;
                     case err.MEDIA_ERR_DECODE: errMsg = "Erreur de décodage audio"; break;
                     case err.MEDIA_ERR_SRC_NOT_SUPPORTED: errMsg = "Format non supporté ou source introuvable (Vérifiez la clé API)"; break;
                 }
            }
            alert("Erreur lecture audio: " + errMsg);
            icon.className = originalIconClass;
            currentAudio = null;
            currentBtn = null;
        };
        
        currentAudio.play().catch(e => {
            console.error("Play Promise Error:", e);
            alert("Impossible de lire l'audio (Autoplay bloqué ?): " + e.message);
            icon.className = originalIconClass;
            currentBtn = null;
        });
    };

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    function nl2br(text) {
        return escapeHtml(text).replace(/\n/g, '<br>');
    }
    function timeAgo(dateString) {
        const date = new Date(dateString); // dateString must be ISO or parseable
        const now = new Date();
        const seconds = Math.floor((now - date) / 1000);
        let interval = seconds / 31536000;

        if (interval > 1) return Math.floor(interval) + " an" + (Math.floor(interval) > 1 ? "s" : "");
        interval = seconds / 2592000;
        if (interval > 1) return Math.floor(interval) + " mois";
        interval = seconds / 86400;
        if (interval > 1) return Math.floor(interval) + " jour" + (Math.floor(interval) > 1 ? "s" : "");
        interval = seconds / 3600;
        if (interval > 1) return Math.floor(interval) + " heure" + (Math.floor(interval) > 1 ? "s" : "");
        interval = seconds / 60;
        if (interval > 1) return Math.floor(interval) + " minute" + (Math.floor(interval) > 1 ? "s" : "");
        return "à l'instant";
    }

    function buildReplyHtml(c, config) {
        var contenu = nl2br(c.contenu);
        // Note: c.dateCommentaire from JSON is "d/m/Y H:i", we need to parse it or pass ISO from controller.
        // For simplicity, let's assume controller returns a timestamp or ISO. We'll update controller next.
        // Fallback if parsing fails or just display as is if complex. 
        // Better: Controller returns 'timeAgo' string directly or ISO date.
        var timeDisplay = 'il y a ' + c.timeAgo; 
        
        var actions = '';
        // ... rest of function ...
        if (c.tokenDelete) {
            actions = '<div class="dropdown ms-auto">' +
                '<button class="btn btn-link text-secondary p-0 text-decoration-none" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-three-dots-vertical"></i></button>' +
                '<ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary shadow">' +
                '<li><button class="dropdown-item text-white" type="button" data-edit-toggle="edit-form-' + c.id + '"><i class="bi bi-pencil me-2"></i>Modifier</button></li>' +
                '<li><form action="' + escapeHtml(c.deleteUrl) + '" method="post" onsubmit="return confirm(\'Supprimer ce commentaire ?\');">' +
                '<input type="hidden" name="_token" value="' + escapeHtml(c.tokenDelete) + '">' +
                '<button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Supprimer</button></form></li>' +
                '</ul></div>';
        }

        var imageHtml = '';
        if (c.image) {
            var isAudio = c.image.endsWith('.mp3') || c.image.endsWith('.webm') || c.image.endsWith('.ogg') || c.image.endsWith('.wav');
            if (isAudio) {
                 imageHtml = '<div class="mt-2"><audio controls class="w-100" style="height: 30px;"><source src="' + escapeHtml(c.image) + '">Votre navigateur ne supporte pas l\'audio.</audio></div>';
            } else {
                imageHtml = '<div class="mt-2"><img src="' + escapeHtml(c.image) + '" alt="Comment Image" class="img-fluid rounded border border-secondary" style="max-height:' + (c.isSubreply ? '100px' : '150px') + '; cursor:pointer" onclick="window.open(this.src)"></div>';
            }
        }

        // TEXT-TO-SPEECH BUTTON
        // Using onclick with escapeHtml for content is tricky because of quotes. 
        // We'll use a data attribute and a delegated event listener or simple onclick with robust escaping.
        // For simplicity in this string builder, let's use a safe encodeURIComponent approach or a data attribute.
        var ttsButton = '<button class="btn p-0 border-0 bg-transparent" onclick="playTTS(decodeURIComponent(\'' + encodeURIComponent(c.contenu) + '\'), this)" title="Écouter"><i class="bi bi-megaphone text-secondary"></i></button>';

        if (c.isSubreply) {
            return '<div class="ms-3 mt-2 p-2 rounded small" style="background:rgba(14,165,233,0.1);border-left:2px solid var(--tc-cyan)" id="comment-' + c.id + '">' +
                '<div class="d-flex align-items-center justify-content-between">' +
                '<div><span class="fw-bold">' + escapeHtml(c.auteur) + '</span> <span class="text-white-50">' + escapeHtml(timeDisplay) + '</span></div>' + 
                '<div class="d-flex align-items-center gap-2">' + ttsButton + actions + '</div></div>' +
                '<p class="mb-0 mt-1" style="color:var(--tc-text)">' + contenu + '</p>' + 
                 '<div class="d-flex align-items-center justify-content-end gap-2 mt-1"><button class="btn p-0 border-0 bg-transparent d-flex align-items-center gap-1 comment-like-btn" data-url="/forum/comment/' + c.id + '/like" data-comment-id="' + c.id + '"><img src="/images/icons/jaime.png" alt="Like" style="width:16px;height:16px"><span class="small text-white comment-like-count" style="font-size:0.75rem">' + (c.nbLikes || 0) + '</span></button></div>' +
                imageHtml + '</div>';
        }
        var replyBtn = '';
        if (config.canReply) {
             var formId = 'reply-form-reply-' + c.id;
            replyBtn = '<div class="mt-2"><button type="button" class="btn btn-outline-secondary btn-sm" data-reply-toggle="' + formId + '">Répondre</button>' +
                '<div id="' + formId + '" class="reply-form mt-2 p-2 rounded d-none" style="background:rgba(0,0,0,0.3);border:1px solid var(--tc-border)">' +
                '<form class="reply-ajax-form" action="' + escapeHtml(config.formAction) + '" method="post" data-parent-id="' + c.id + '" data-parent-type="reply">' +
                '<input type="hidden" name="parent_id" value="' + c.id + '">' +
                '<input type="hidden" name="' + escapeHtml(config.tokenName) + '" value="' + escapeHtml(config.tokenValue) + '">' +
                '<div class="mb-2 position-relative">' + 
                    '<textarea name="comment[contenu]" class="form-control form-control-sm bg-black text-white border-secondary comment-input-white" rows="2" placeholder="Répondre..." style="padding-right: 30px;"></textarea>' +
                    '<div class="dropdown position-absolute top-0 end-0 mt-1 me-2">' +
                        '<button class="btn btn-link p-0 text-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Smart Writing Assistant">' +
                            '<i class="bi bi-stars ai-magic-btn" style="font-size: 1rem; color: #a855f7;"></i>' +
                        '</button>' +
                        '<ul class="dropdown-menu dropdown-menu-dark shadow border-secondary p-2" style="width: 200px;">' +
                            '<li><h6 class="dropdown-header text-muted small text-uppercase">Améliorer</h6></li>' +
                            '<li><button class="dropdown-item small" type="button" onclick="improveText(\'' + formId + '\', \'correction\')"><i class="bi bi-check2-circle"></i> Corriger</button></li>' +
                            '<li><button class="dropdown-item small" type="button" onclick="improveText(\'' + formId + '\', \'professional\')"><i class="bi bi-briefcase"></i> Pro</button></li>' +
                            '<li><button class="dropdown-item small" type="button" onclick="improveText(\'' + formId + '\', \'friendly\')"><i class="bi bi-emoji-smile"></i> Amical</button></li>' +
                            '<li><button class="dropdown-item small" type="button" onclick="improveText(\'' + formId + '\', \'witty\')"><i class="bi bi-lightbulb"></i> Fun</button></li>' +
                            '<li><hr class="dropdown-divider border-secondary"></li>' +
                            '<li><button class="dropdown-item small" type="button" onclick="improveText(\'' + formId + '\', \'translate_ar\')">AR</button></li>' +
                            '<li><button class="dropdown-item small" type="button" onclick="improveText(\'' + formId + '\', \'translate_en\')">EN</button></li>' +
                            '<li><button class="dropdown-item small" type="button" onclick="improveText(\'' + formId + '\', \'translate_fr\')">FR</button></li>' +
                        '</ul>' +
                    '</div>' +
                '</div>' +
                '<div class="mb-2"><input type="file" name="comment[image]" class="form-control form-control-sm bg-black text-white border-secondary"></div>' +
                '<button type="submit" class="btn btn-success btn-sm fw-bold">Répondre</button>' +
                '<button type="button" class="btn btn-outline-secondary btn-sm ms-2" data-reply-cancel="' + formId + '">Annuler</button></form></div></div>';
        }
        return '<div class="ms-4 mt-3 p-3 rounded" style="background:var(--tc-bg-input);border-left:3px solid var(--tc-cyan)" id="comment-' + c.id + '">' +
            '<div class="d-flex align-items-center justify-content-between mb-1 flex-wrap">' + 
            '<div class="d-flex align-items-center gap-2"><span class="fw-bold small">' + escapeHtml(c.auteur) + '</span>' +
            '<span class="discovery-card-subtitle small">' + escapeHtml(timeDisplay) + '</span></div>' + 
            '<div class="d-flex align-items-center gap-2">' + ttsButton + actions + '</div></div>' +
             '<p class="mb-0 small" style="color:var(--tc-text)">' + contenu + '</p>' + 
             '<div class="d-flex align-items-center justify-content-end gap-3 mt-2"><button class="btn p-0 border-0 bg-transparent d-flex align-items-center gap-1 comment-like-btn" data-url="/forum/comment/' + c.id + '/like" data-comment-id="' + c.id + '"><img src="/images/icons/jaime.png" alt="Like" style="width:20px;height:20px"><span class="small text-white comment-like-count">' + (c.nbLikes || 0) + '</span></button></div>' +
            imageHtml + replyBtn +
            '<div class="subreplies-list" data-parent-id="' + c.id + '"></div></div>';
    }
    function initReplyForms() {
        var config = {
            formAction: '{{ path('app_forum_comment_new', { id: post.id }) }}',
            tokenName: '{{ commentForm._token.vars.full_name }}',
            tokenValue: '{{ commentForm._token.vars.value }}',
            canReply: {{ app.user ? 'true' : 'false' }}
        };
        document.querySelectorAll('.reply-ajax-form').forEach(function(form) {
            if (form.dataset.ajaxInit) return;
            form.dataset.ajaxInit = '1';
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                var btn = form.querySelector('button[type="submit"]');
                var origText = btn.textContent;
                btn.disabled = true;
                btn.textContent = 'Envoi...';
                var fd = new FormData(form);
                fetch(form.action, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                }).then(function(r) { return r.json(); }).then(function(data) {
                    if (data.success) {
                        var c = data.comment;
                        var container = document.querySelector('.replies-list[data-parent-id="' + c.parentId + '"]');
                        if (!container) container = document.querySelector('.subreplies-list[data-parent-id="' + c.parentId + '"]');
                        if (container) {
                            var div = document.createElement('div');
                            div.innerHTML = buildReplyHtml(c, config);
                            container.appendChild(div.firstChild);
                            initReplyForms();
                            initToggleButtons();
                        }
                        form.reset();
                        var formWrap = form.closest('.reply-form');
                        if (formWrap) { formWrap.classList.add('d-none'); }
                        var toggle = document.querySelector('[data-reply-toggle="' + formWrap.id + '"]');
                        if (toggle) toggle.setAttribute('aria-expanded', 'false');
                    } else {
                        alert(data.errors ? data.errors.join(' ') : 'Erreur');
                    }
                }).catch(function() { alert('Erreur réseau'); }).finally(function() {
                    btn.disabled = false;
                    btn.textContent = origText;
                });
            });
        });
    }
    function initToggleButtons() {
        document.querySelectorAll('[data-reply-toggle]').forEach(function(btn) {
            if (btn.dataset.toggleInit) return;
            btn.dataset.toggleInit = '1';
            btn.addEventListener('click', function() {
                var id = this.getAttribute('data-reply-toggle');
                var formEl = document.getElementById(id);
                if (formEl) {
                    formEl.classList.toggle('d-none');
                    this.setAttribute('aria-expanded', formEl.classList.contains('d-none') ? 'false' : 'true');
                }
            });
        });
        document.querySelectorAll('[data-reply-cancel]').forEach(function(btn) {
            if (btn.dataset.cancelInit) return;
            btn.dataset.cancelInit = '1';
            btn.addEventListener('click', function() {
                var id = this.getAttribute('data-reply-cancel');
                var formEl = document.getElementById(id);
                if (formEl) {
                    formEl.classList.add('d-none');
                    var toggleBtn = document.querySelector('[data-reply-toggle="' + id + '"]');
                    if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
                }
            });
        });
    }
    function initLikeButton() {
        var likeBtn = document.getElementById('like-btn');
        if (!likeBtn) return;

        likeBtn.addEventListener('click', function() {
            var url = this.getAttribute('data-url');
            var img = document.getElementById('like-icon');
            var countSpan = document.getElementById('like-count');
            var topCountSpan = document.getElementById('top-like-count');

            // Simple scale animation
            img.style.transform = 'scale(1.2)';
            setTimeout(function() { img.style.transform = 'scale(1)'; }, 200);

            fetch(url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).then(function(r) { 
                if (r.status === 403) {
                    alert('Veuillez vous connecter pour aimer ce post.');
                    return;
                }
                return r.json(); 
            }).then(function(data) {
                if (data && data.success) {
                    img.src = data.liked ? '{{ asset('images/icons/jaimepas.png') }}' : '{{ asset('images/icons/jaime.png') }}';
                    countSpan.textContent = data.nbLikes + ' likes';
                    if (topCountSpan) topCountSpan.textContent = data.nbLikes;
                }
            }).catch(function() { alert('Erreur réseau'); });
        });
    }

    function initCommentLikeButtons() {
        document.querySelectorAll('.comment-like-btn').forEach(function(btn) {
            if (btn.dataset.likeInit) return;
            btn.dataset.likeInit = '1';
            btn.addEventListener('click', function() {
                var url = this.getAttribute('data-url');
                var img = this.querySelector('img');
                var countSpan = this.querySelector('.comment-like-count');

                img.style.transform = 'scale(1.2)';
                setTimeout(function() { img.style.transform = 'scale(1)'; }, 200);

                fetch(url, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).then(function(r) {
                    if (r.status === 403) {
                        alert('Veuillez vous connecter pour aimer ce commentaire.');
                        return;
                    }
                    return r.json();
                }).then(function(data) {
                    if (data && data.success) {
                        img.src = data.liked ? '{{ asset('images/icons/jaimepas.png') }}' : '{{ asset('images/icons/jaime.png') }}';
                        countSpan.textContent = data.nbLikes;
                    }
                }).catch(function() { alert('Erreur réseau'); });
            });
        });
    }

    // Observer pour les nouveaux commentaires chargés dynamiquement
    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.addedNodes.length) {
                initCommentLikeButtons();
            }
        });
    });
    
    // Observer le conteneur principal des commentaires s'il existe (à adapter selon votre structure)
    // Ici on observe document.body faute de mieux, mais idéalement cibler le conteneur des commentaires
    observer.observe(document.body, { childList: true, subtree: true });

    document.addEventListener('DOMContentLoaded', function() {
        initReplyForms();
        initToggleButtons();
        initLikeButton();
        initCommentLikeButtons();
        initEditForms(); // NEW
    });

    function initEditForms() {
        // Init delete media buttons
        document.querySelectorAll('[data-delete-media]').forEach(function(btn) {
             if (btn.dataset.delInit) return;
             btn.dataset.delInit = '1';
             btn.addEventListener('click', function() {
                  var id = this.dataset.deleteMedia;
                  if (confirm('Supprimer l\'audio/image actuel ?')) {
                       // Mark for deletion in submission
                       var form = btn.closest('form');
                       form.dataset.deleteMedia = "true";
                       this.parentElement.removeChild(this); // Remove button
                       // Optionally visually hide current image/audio if present
                  }
             });
        });

        // Init recording for edits
        document.querySelectorAll('[data-record-edit]').forEach(function(btn) {
             if (btn.dataset.recInit) return;
             btn.dataset.recInit = '1';
             
             btn.addEventListener('click', async function() {
                  var id = this.dataset.recordEdit;
                  var icon = this.querySelector('i');
                  var preview = document.getElementById('edit-audio-preview-' + id);
                  
                  // Toggle Stop
                  if (btn.classList.contains('text-danger')) {
                       if (window.editMediaRecorders && window.editMediaRecorders[id] && window.editMediaRecorders[id].state === 'recording') {
                            window.editMediaRecorders[id].stop();
                            window.editMediaRecorders[id].stream.getTracks().forEach(track => track.stop());
                       }
                       return;
                  }

                  // Start
                  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                        alert("Votre navigateur ne supporte pas l'enregistrement audio.");
                        return;
                  }
                  
                  try {
                      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                      var mediaRecorder = new MediaRecorder(stream);
                      if (!window.editMediaRecorders) window.editMediaRecorders = {};
                      window.editMediaRecorders[id] = mediaRecorder;
                      
                      var chunks = [];
                      mediaRecorder.ondataavailable = e => chunks.push(e.data);
                      mediaRecorder.onstop = () => {
                           const blob = new Blob(chunks, { type: 'audio/webm' });
                           if (!window.editAudioBlobs) window.editAudioBlobs = {};
                           window.editAudioBlobs[id] = blob;
                           
                           icon.className = 'bi bi-mic';
                           btn.classList.remove('text-danger');
                           btn.classList.add('text-secondary');
                           
                           if (preview) {
                               preview.classList.remove('d-none');
                               setTimeout(() => preview.classList.add('d-none'), 3000);
                           }
                      };
                      
                      mediaRecorder.start();
                      icon.className = 'bi bi-stop-fill';
                      btn.classList.remove('text-secondary');
                      btn.classList.add('text-danger');
                      
                  } catch (e) {
                      alert("Erreur micro: " + e.message);
                  }
             });
        });

        document.querySelectorAll('.edit-ajax-form').forEach(function(form) {
            if (form.dataset.ajaxInit) return;
            form.dataset.ajaxInit = '1';
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                var btn = form.querySelector('button[type="submit"]');
                var origHtml = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                
                var fd = new FormData(form);
                
                // Check if we have a recorded audio for this form
                var match = form.action.match(/\/comment\/(\d+)\/edit/);
                if (match && window.editAudioBlobs && window.editAudioBlobs[match[1]]) {
                     fd.set('comment[image]', window.editAudioBlobs[match[1]], 'edit-voice-' + Date.now() + '.webm');
                     delete window.editAudioBlobs[match[1]]; 
                }
                
                // Check if delete media requested
                if (form.dataset.deleteMedia === "true") {
                    fd.append('delete_image', '1');
                }

                fetch(form.action, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                }).then(function(r) { return r.json(); }).then(function(data) {
                    if (data.success) {
                        window.location.reload(); 
                    } else {
                        if (data.errors) alert(data.errors.join('\n'));
                        else window.location.reload(); 
                    }
                }).catch(function(err) { 
                    console.error(err);
                    window.location.reload(); 
                }).finally(function() {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                });
            });
        });
        
        // Handle Cancel Buttons
        document.querySelectorAll('[data-edit-cancel]').forEach(function(btn) {
             btn.addEventListener('click', function() {
                var id = this.getAttribute('data-edit-cancel');
                var formEl = document.getElementById(id);
                if (formEl) {
                    formEl.classList.add('d-none');
                    // Show content back
                    var contentId = id.replace('edit-form-', 'comment-content-');
                    var contentEl = document.getElementById(contentId);
                    if (contentEl) contentEl.classList.remove('d-none');
                }
             });
        });
        
        // Handle Toggle Buttons (Edit click)
        document.querySelectorAll('[data-edit-toggle]').forEach(function(btn) {
            if (btn.dataset.editInit) return;
            btn.dataset.editInit = '1';
            btn.addEventListener('click', function() {
                var id = this.getAttribute('data-edit-toggle');
                var formEl = document.getElementById(id);
                if (formEl) {
                     formEl.classList.remove('d-none');
                     // Hide content
                     var contentId = id.replace('edit-form-', 'comment-content-');
                     var contentEl = document.getElementById(contentId);
                     if (contentEl) contentEl.classList.add('d-none');
                     
                     // Focus input
                     var input = formEl.querySelector('input[type="text"]');
                     if (input) input.focus();
                }
            });
        });
    }


// Sensitive image: "Voir l'image" (reveal + show "Flouter à nouveau") / "Flouter à nouveau" (reblur) / "Désactiver le floutage" (reveal all)
(function() {
    function revealWrapper(wrapper) {
        wrapper.classList.remove('sensitive-image-blurred');
        wrapper.querySelectorAll('.sensitive-image-img').forEach(function(img) { img.style.filter = ''; img.style.pointerEvents = ''; });
        var overlay = wrapper.querySelector('.sensitive-image-overlay');
        if (overlay) {
            overlay.style.display = '';
            overlay.style.background = 'transparent';
            var blurredBlock = overlay.querySelector('.sensitive-image-overlay-blurred');
            var revealedBlock = overlay.querySelector('.sensitive-image-overlay-revealed');
            if (blurredBlock) blurredBlock.classList.add('d-none');
            if (revealedBlock) revealedBlock.classList.remove('d-none');
        }
    }
    function reblurWrapper(wrapper) {
        wrapper.classList.add('sensitive-image-blurred');
        wrapper.querySelectorAll('.sensitive-image-img').forEach(function(img) { img.style.filter = 'blur(20px)'; img.style.pointerEvents = 'none'; });
        var overlay = wrapper.querySelector('.sensitive-image-overlay');
        if (overlay) {
            overlay.style.background = 'rgba(0,0,0,0.8)';
            var blurredBlock = overlay.querySelector('.sensitive-image-overlay-blurred');
            var revealedBlock = overlay.querySelector('.sensitive-image-overlay-revealed');
            if (blurredBlock) blurredBlock.classList.remove('d-none');
            if (revealedBlock) revealedBlock.classList.add('d-none');
        }
    }
    document.querySelectorAll('.sensitive-image-btn-view').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var wrapper = this.closest('.sensitive-image-wrapper');
            if (wrapper) revealWrapper(wrapper);
        });
    });
    document.querySelectorAll('.sensitive-image-btn-reblur').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var wrapper = this.closest('.sensitive-image-wrapper');
            if (wrapper) reblurWrapper(wrapper);
        });
    });
    document.querySelectorAll('.sensitive-image-btn-disable').forEach(function(btn) {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.sensitive-image-blurred').forEach(revealWrapper);
        });
    });
    document.querySelectorAll('.sensitive-image-btn-hide').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var wrapper = this.closest('.sensitive-image-wrapper');
            if (wrapper) {
                wrapper.style.display = 'none';
            }
        });
    });
})();
    // Initialize Edit Forms
    initEditForms();

    // Universal Translation Logic
    function translateContent(type, id, targetLang) {
        let container;
        let originalHTML;
        
        if (type === 'post') {
            container = document.getElementById('post-content-' + id);
        } else {
            container = document.getElementById('comment-content-' + id);
        }

        if (!container) return;
        if (container.dataset.isTranslating === 'true') return;

        // Get text content
        const textToTranslate = container.innerText;
        
        // Loading State
        container.dataset.isTranslating = 'true';
        originalHTML = container.innerHTML;
        container.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm text-info"></div><span class="small text-info">Traduction en cours (' + targetLang + ')...</span></div>';

        fetch('{{ path('app_forum_translate') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
                text: textToTranslate,
                targetLanguage: targetLang
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                container.innerHTML = `
                    <div class="translation-result p-2 rounded mb-2" style="background: rgba(14, 165, 233, 0.1); border-left: 2px solid var(--tc-cyan);">
                        <div class="small text-tc-cyan mb-1"><i class="bi bi-info-circle me-1"></i> Traduit en ${targetLang}</div>
                        <p class="mb-0" style="color: var(--tc-text); line-height: 1.6;">${data.translatedText.replace(/\n/g, '<br>')}</p>
                        <button class="btn btn-link btn-sm p-0 mt-1" onclick="revertTranslation(${id}, '${type}', \`${encodeURIComponent(originalHTML)}\`)">Voir l'original</button>
                    </div>
                `;
            } else {
                alert('Erreur: ' + (data.error || 'Inconnue'));
                container.innerHTML = originalHTML;
            }
        })
        .catch(err => {
            console.error(err);
            alert('Erreur connexion Traduction.');
            container.innerHTML = originalHTML;
        })
        .finally(() => {
            container.dataset.isTranslating = 'false';
        });
    }

    function revertTranslation(id, type, encodedOrig) {
        const container = type === 'post' ? document.getElementById('post-content-' + id) : document.getElementById('comment-content-' + id);
        if (container) {
            container.innerHTML = decodeURIComponent(encodedOrig);
        }
    }

    // ── Best Comment AI ──────────────────────────────────────────
    (function () {
        const btn = document.getElementById('btn-best-comment');
        if (!btn) return;

        let currentBestId = null;

        function clearHighlight() {
            if (!currentBestId) return;
            const card  = document.getElementById('comment-' + currentBestId);
            const badge = document.getElementById('best-badge-' + currentBestId);
            if (card)  card.classList.remove('best-comment-highlight');
            if (badge) badge.classList.add('d-none');
            currentBestId = null;
        }

        btn.addEventListener('click', function () {
            // Toggle off if already active
            if (btn.dataset.active === '1') {
                clearHighlight();
                btn.dataset.active = '0';
                btn.classList.remove('active-best');
                btn.querySelector('.btn-best-label').textContent = 'Meilleur commentaire';
                return;
            }

            // Show spinner
            const label = btn.querySelector('.btn-best-label');
            const icon  = btn.querySelector('i');
            const origIconClass = icon.className;
            icon.className = 'spinner-border spinner-border-sm text-warning';
            label.textContent = 'Analyse en cours…';
            btn.disabled = true;

            fetch(btn.dataset.url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(data => {
                if (!data.success) {
                    alert(data.message || 'Erreur lors de l\'analyse.');
                    return;
                }
                if (!data.best_comment_id) {
                    alert(data.reason || 'Pas assez de commentaires pour analyser.');
                    return;
                }

                const bestId = data.best_comment_id;
                const card   = document.getElementById('comment-' + bestId);
                const badge  = document.getElementById('best-badge-' + bestId);

                if (!card) {
                    alert('Commentaire introuvable sur cette page.');
                    return;
                }

                clearHighlight();
                currentBestId = bestId;

                // Apply highlight
                card.classList.add('best-comment-highlight');
                if (badge) {
                    badge.querySelector('.best-reason-text').textContent = data.reason;
                    badge.classList.remove('d-none');
                }

                // Scroll smoothly to it
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });

                btn.dataset.active = '1';
                btn.classList.add('active-best');
                label.textContent = 'Masquer la sélection';
            })
            .catch(err => {
                console.error(err);
                alert('Erreur de connexion à l\'IA.');
            })
            .finally(() => {
                icon.className = origIconClass;
                btn.disabled = false;
            });
        });
    })();
</script>

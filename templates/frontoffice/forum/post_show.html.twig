{% extends 'frontoffice/base.html.twig' %}

{% block title %}{{ post.titre }} - Forum TEAMCRAFT{% endblock %}

{% block stylesheets %}
    <style>
        @keyframes magic-pulse {
            0% { transform: scale(1); filter: drop-shadow(0 0 0 rgba(168, 85, 247, 0)); }
            50% { transform: scale(1.15); filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.6)); }
            100% { transform: scale(1); filter: drop-shadow(0 0 0 rgba(168, 85, 247, 0)); }
        }
        .ai-magic-btn {
            animation: magic-pulse 2s infinite ease-in-out;
            transition: transform 0.3s ease, filter 0.3s ease;
            display: inline-block;
        }
        .ai-magic-btn:hover {
            animation: none;
            transform: scale(1.2) rotate(15deg);
            filter: drop-shadow(0 0 12px rgba(168, 85, 247, 0.9));
        }

        /* ── Best Comment Highlight ── */
        @keyframes trophy-pulse {
            0%   { box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.5); }
            70%  { box-shadow: 0 0 0 10px rgba(251, 191, 36, 0); }
            100% { box-shadow: 0 0 0 0 rgba(251, 191, 36, 0); }
        }
        .best-comment-highlight {
            border: 2px solid #fbbf24 !important;
            background: linear-gradient(135deg, rgba(251,191,36,0.08) 0%, rgba(30,27,27,1) 60%) !important;
            animation: trophy-pulse 1.5s ease-out 2;
            transition: border 0.4s ease, background 0.4s ease;
        }
        .best-comment-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 10px;
            padding: 6px 14px;
            background: linear-gradient(90deg, rgba(251,191,36,0.18), rgba(251,191,36,0.06));
            border-left: 3px solid #fbbf24;
            border-radius: 0 8px 8px 0;
            font-size: 0.82rem;
            color: #fde68a;
            font-weight: 600;
        }
        #btn-best-comment {
            transition: all 0.2s ease;
        }
        #btn-best-comment:hover {
            background: rgba(251,191,36,0.15) !important;
            border-color: #fbbf24 !important;
            color: #fbbf24 !important;
        }
        #btn-best-comment.active-best {
            background: rgba(251,191,36,0.2) !important;
            border-color: #fbbf24 !important;
            color: #fbbf24 !important;
        }
    </style>
{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_forum') }}" class="text-secondary text-decoration-none">Forum</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_forum_rubrique_show', { id: post.rubrique.id }) }}" class="text-secondary text-decoration-none">{{ post.rubrique.nomRubrique }}</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">{{ post.titre }}</li>
            </ol>
        </nav>

        <div class="discovery-card p-4 p-md-5 mb-4 position-relative">
            {% if app.user and post.auteur.id != app.user.id %}
                <button type="button" class="btn p-0 border-0 bg-transparent position-absolute top-0 end-0 mt-3 me-3 d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#reportModal" title="Signaler ce post" style="z-index: 10;">
                     <span class="fw-bold" style="font-size: 0.85rem; color: #ef4444; opacity: 0.8;">Signaler</span>
                     <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 1.25rem; opacity: 0.8;"></i>
                </button>
            {% endif %}

            <!-- Translation Post -->
            <div class="position-absolute top-0 end-0 mt-5 me-3 dropdown" style="z-index: 9;">
                <button class="btn btn-link p-0 text-secondary d-flex align-items-center gap-1 text-decoration-none" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Traduire ce post">
                    <i class="bi bi-translate" style="font-size: 1.2rem; color: var(--tc-cyan);"></i>
                    <span class="small fw-bold text- TC-cyan" style="font-size: 0.75rem;">Traduire</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary shadow" style="font-size: 0.85rem;">
                    <li><button class="dropdown-item" onclick="translateContent('post', {{ post.id }}, 'Français')">Français</button></li>
                    <li><button class="dropdown-item" onclick="translateContent('post', {{ post.id }}, 'English')">English</button></li>
                    <li><button class="dropdown-item" onclick="translateContent('post', {{ post.id }}, 'Arabic')">العربية</button></li>
                    <li><button class="dropdown-item" onclick="translateContent('post', {{ post.id }}, 'Spanish')">Español</button></li>
                    <li><button class="dropdown-item" onclick="translateContent('post', {{ post.id }}, 'German')">Deutsch</button></li>
                    <li><button class="dropdown-item" onclick="translateContent('post', {{ post.id }}, 'Italian')">Italiano</button></li>
                </ul>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge-game valorant">{{ post.typePost }}</span>
                <span class="badge-rank green"><i class="bi bi-eye"></i> {{ post.nbVues }}</span>
                <span class="badge-rank purple"><i class="bi bi-heart"></i> <span id="top-like-count">{{ post.nbLikes }}</span></span>
            </div>
            <h1 class="h2 fw-bold discovery-card-title mb-2">{{ post.titre }}</h1>
            <p class="discovery-card-subtitle mb-3">Par {{ post.auteur.pseudo|default(post.auteur.username) }} · <span title="{{ post.dateCreation|date('d/m/Y H:i') }}">il y a {{ post.dateCreation|ago }}</span></p>
            {% if post.image %}
                <div class="mb-3">
                    {% set postImageBlur = (post.imageSensitivity == 'medium' or post.statut == 'pending_review') %}
                    {% include 'frontoffice/partials/_sensitive_image.html.twig' with {
                        imageUrl: asset('uploads/posts/' ~ post.image),
                        shouldBlur: postImageBlur,
                        imageClass: 'img-fluid rounded',
                        maxHeight: '300px',
                        containerId: 'post-image-' ~ post.id,
                        postId: post.id
                    } only %}
                </div>
            {% endif %}
            <div class="post-body" id="post-content-{{ post.id }}" style="color: var(--tc-text); line-height: 1.6;">{{ post.contenu|nl2br }}</div>
            
            <div class="mt-4 d-flex align-items-center gap-3">
                <button id="like-btn" class="btn p-0 border-0 bg-transparent d-flex align-items-center gap-2" data-url="{{ path('app_forum_post_like', { id: post.id }) }}">
                    <img id="like-icon" src="{{ asset('images/icons/' ~ (app.user and post.isLikedBy(app.user) ? 'jaimepas.png' : 'jaime.png')) }}" alt="Like" style="width: 40px; height: 40px; transition: transform 0.2s;">
                    <span id="like-count" class="fw-bold" style="font-size: 1.1rem; color: #a855f7; text-transform: uppercase;">{{ post.nbLikes }}</span>
                </button>
            </div>

            {% if canEdit %}
                <div class="position-absolute top-0 end-0 mt-3 me-3 dropdown">
                    <button class="btn btn-link text-white p-0 text-decoration-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical" style="font-size: 1.5rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary shadow">
                        <li><a class="dropdown-item text-white" href="{{ path('app_forum_post_edit', { id: post.id }) }}"><i class="bi bi-pencil me-2"></i>Modifier</a></li>
                        <li>
                            <form action="{{ path('app_forum_post_delete', { id: post.id }) }}" method="post" onsubmit="return confirm('Supprimer ce post ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Supprimer</button>
                            </form>
                        </li>
                    </ul>
                </div>
            {% endif %}
        </div>

        <div class="d-flex align-items-center justify-content-between mb-3" id="comments">
            <h2 class="h5 fw-bold mb-0">Commentaires ({{ comments|length }})</h2>
            {% if comments|length >= 2 %}
                <button id="btn-best-comment" class="btn btn-sm btn-outline-warning d-flex align-items-center gap-2"
                        style="font-size: 0.82rem; border-radius: 20px; padding: 4px 14px;"
                        title="Laisser l'IA choisir le meilleur commentaire"
                        data-url="{{ path('app_ai_best_comment', { postId: post.id }) }}"
                        data-active="0">
                    <i class="bi bi-trophy-fill" style="color: #fbbf24;"></i>
                    <span class="btn-best-label">Meilleur commentaire</span>
                </button>
            {% endif %}
        </div>

        {% if app.user %}
            <div class="card bg-dark border-0 shadow mb-4" style="background-color: #16161a !important; border-radius: 0.75rem;">
                <div class="card-body p-3">
                    {{ form_start(commentForm, { 'action': path('app_forum_comment_new', { id: post.id }), 'method': 'POST', 'attr': {'enctype': 'multipart/form-data', 'class': 'd-flex align-items-center gap-2', 'id': 'main-comment-form'} }) }}
                        
                        {# Hidden File Input #}
                        <div class="position-relative">
                            <label for="{{ commentForm.image.vars.id }}" class="btn btn-link p-0 text-secondary" style="font-size: 1.5rem; cursor: pointer;" title="Joindre une image/GIF">
                                <i class="bi bi-paperclip"></i>
                            </label>
                            {{ form_widget(commentForm.image, {'attr': {'class': 'd-none', 'onchange': 'handleFileSelect(this)'}}) }}
                            <span id="file-indicator" class="position-absolute top-0 start-100 translate-middle p-1 bg-success border border-light rounded-circle d-none">
                                <span class="visually-hidden">New alerts</span>
                            </span>
                        </div>
                        
                        {# Voice Recorder Button #}
                        <div class="position-relative">
                             <button type="button" class="btn btn-link p-0 text-secondary" style="font-size: 1.5rem;" id="record-btn" title="Enregistrer un message vocal (max 30s)">
                                <i class="bi bi-mic"></i>
                             </button>
                             <span id="recording-indicator" class="position-absolute top-0 start-100 translate-middle p-2 bg-danger border border-light rounded-circle d-none">
                                <span class="visually-hidden">Recording</span>
                             </span>
                        </div>
                        <div id="recording-timer" class="text-danger small fw-bold d-none" style="min-width: 40px;">0:00</div>

                        {# Text Input #}
                        <div class="flex-grow-1 position-relative">
                            {{ form_widget(commentForm.contenu, {'attr': {'class': 'form-control bg-dark text-white border-0 shadow-none rounded-pill px-3 py-2 comment-input-white', 'placeholder': 'Type your message...', 'rows': '1', 'style': 'resize: none; overflow-y: hidden; padding-right: 40px;', 'oninput': 'this.style.height = ""; this.style.height = this.scrollHeight + "px"'}}) }}
                            
                             <!-- AI Smart Writing Assistant -->
                            <div class="dropdown position-absolute top-0 end-0 mt-2 me-2" style="z-index: 5;">
                                <button class="btn btn-link p-0 text-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Smart Writing Assistant">
                                    <i class="bi bi-stars ai-magic-btn" style="font-size: 1.2rem; color: #a855f7;"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark shadow border-secondary p-2" style="width: 200px;">
                                    <li><h6 class="dropdown-header text-muted small text-uppercase">Améliorer le texte</h6></li>
                                    <li><button class="dropdown-item d-flex align-items-center gap-2" type="button" onclick="improveText('main', 'correction')"><i class="bi bi-check2-circle"></i> Corriger</button></li>
                                    <li><button class="dropdown-item d-flex align-items-center gap-2" type="button" onclick="improveText('main', 'professional')"><i class="bi bi-briefcase"></i> Professionnel</button></li>
                                    <li><button class="dropdown-item d-flex align-items-center gap-2" type="button" onclick="improveText('main', 'friendly')"><i class="bi bi-emoji-smile"></i> Amical</button></li>
                                    <li><button class="dropdown-item d-flex align-items-center gap-2" type="button" onclick="improveText('main', 'witty')"><i class="bi bi-lightbulb"></i> Drôle/Spirituel</button></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li><button class="dropdown-item d-flex align-items-center gap-2" type="button" onclick="improveText('main', 'translate_ar')"><i class="bi bi-translate"></i> Traduire (Arabe)</button></li>
                                    <li><button class="dropdown-item d-flex align-items-center gap-2" type="button" onclick="improveText('main', 'translate_en')"><i class="bi bi-translate"></i> Traduire (Anglais)</button></li>
                                    <li><button class="dropdown-item d-flex align-items-center gap-2" type="button" onclick="improveText('main', 'translate_fr')"><i class="bi bi-translate"></i> Traduire (Français)</button></li>
                                </ul>
                            </div>

                            {{ form_errors(commentForm.contenu) }}
                            {{ form_errors(commentForm.image) }}
                            <div id="audio-preview" class="mt-2 d-none">
                                <audio controls class="w-100" style="height: 30px;"></audio>
                                <button type="button" class="btn btn-link text-danger p-0 ms-2" id="delete-audio" title="Supprimer l'audio"><i class="bi bi-x-circle"></i></button>
                            </div>
                        </div>

                        {# Send Button #}
                        <button type="submit" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 40px; height: 40px; background: linear-gradient(135deg, #6366f1, #a855f7); border: none;">
                            <i class="bi bi-send-fill text-white" style="font-size: 1.1rem; margin-left: 2px; margin-top: 1px;"></i>
                        </button>
                    {{ form_end(commentForm) }}
                </div>
            </div>
            <script>
                // File Selection
                function handleFileSelect(input) {
                    const indicator = document.getElementById('file-indicator');
                    const label = input.previousElementSibling;
                    if (input.files && input.files[0]) {
                        indicator.classList.remove('d-none');
                        label.classList.remove('text-secondary');
                        label.classList.add('text-success');
                    } else {
                        indicator.classList.add('d-none');
                        label.classList.add('text-secondary');
                        label.classList.remove('text-success');
                    }
                }

                // Voice Recording Logic
                let mediaRecorder;
                let audioChunks = [];
                let recordingTimer;
                let recordingStartTime;
                let recordedAudioBlob = null;
                const MAX_DURATION = 30000; // 30 seconds

                const recordBtn = document.getElementById('record-btn');
                const recordingIndicator = document.getElementById('recording-indicator');
                const timerDisplay = document.getElementById('recording-timer');
                const audioPreview = document.getElementById('audio-preview');
                const audioPlayer = audioPreview ? audioPreview.querySelector('audio') : null;
                const deleteAudioBtn = document.getElementById('delete-audio');
                const mainForm = document.getElementById('main-comment-form');


                // Smart Writing Assistant
                function improveText(context, tone) {
                    let textarea;
                    let btnIcon;

                    if (context === 'main') {
                        textarea = document.querySelector('#main-comment-form textarea');
                        btnIcon = document.querySelector('#main-comment-form .bi-stars');
                    } else if (context.startsWith('edit-')) {
                        // context is 'edit-' + id
                         let form = document.querySelector('#edit-form-' + context.substring(5) + ' form');
                         if(form) {
                             textarea = form.querySelector('input[type="text"]'); // It's an input in edit mode
                             btnIcon = form.querySelector('.bi-stars');
                         }
                    } else if (context.startsWith('reply-')) {
                         let form = document.querySelector('#' + context + ' form');
                         if(form) {
                             textarea = form.querySelector('textarea');
                             btnIcon = form.querySelector('.bi-stars');
                         }
                    }

                    if (!textarea || !textarea.value.trim()) {
                        alert("Veuillez écrire du texte d'abord.");
                        return;
                    }

                    // Loading state
                    const originalIconClass = btnIcon.className;
                    btnIcon.className = 'spinner-border spinner-border-sm text-warning';
                    
                    fetch('{{ path('app_ai_improve_text') }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            text: textarea.value,
                            tone: tone
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            textarea.value = data.improvedText;
                            // Trigger resize if textarea
                            if (textarea.tagName === 'TEXTAREA') {
                                textarea.style.height = 'auto';
                                textarea.style.height = textarea.scrollHeight + 'px';
                            }
                            // Highlight effect
                            textarea.style.transition = 'box-shadow 0.3s';
                            textarea.style.boxShadow = '0 0 10px #a855f7';
                            setTimeout(() => { textarea.style.boxShadow = ''; }, 1000);
                        } else {
                            alert('Erreur: ' + (data.message || 'Inconnue'));
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        alert('Erreur connexion AI.');
                    })
                    .finally(() => {
                        btnIcon.className = originalIconClass;
                    });
                }

                if(recordBtn) {
                    recordBtn.addEventListener('click', async () => {
                        if (mediaRecorder && mediaRecorder.state === 'recording') {
                            stopRecording();
                        } else {
                            startRecording();
                        }
                    });
                }

                if(deleteAudioBtn) {
                    deleteAudioBtn.addEventListener('click', () => {
                        recordedAudioBlob = null;
                        audioPreview.classList.add('d-none');
                        recordBtn.disabled = false;
                        recordBtn.classList.remove('text-secondary');
                    });
                }

                async function startRecording() {
                    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                        alert("Votre navigateur ne supporte pas l'enregistrement audio.");
                        return;
                    }

                    try {
                        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                        mediaRecorder = new MediaRecorder(stream);
                        audioChunks = [];

                        mediaRecorder.ondataavailable = event => {
                            audioChunks.push(event.data);
                        };

                        mediaRecorder.onstop = () => {
                            const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                            recordedAudioBlob = audioBlob;
                            const audioUrl = URL.createObjectURL(audioBlob);
                            audioPlayer.src = audioUrl;
                            audioPreview.classList.remove('d-none');
                            
                            // Reset UI
                            recordBtn.querySelector('i').className = 'bi bi-mic';
                            recordBtn.classList.add('text-secondary');
                            recordBtn.classList.remove('text-danger');
                            recordingIndicator.classList.add('d-none');
                            timerDisplay.classList.add('d-none');
                            clearInterval(recordingTimer);
                            
                            // Disable recording while audio exists (simple constraint)
                            // recordBtn.disabled = true; 
                        };

                        mediaRecorder.start();
                        recordingStartTime = Date.now();
                        
                        // UI Updates
                        recordBtn.querySelector('i').className = 'bi bi-stop-fill';
                        recordBtn.classList.remove('text-secondary');
                        recordBtn.classList.add('text-danger');
                        recordingIndicator.classList.remove('d-none');
                        timerDisplay.classList.remove('d-none');

                        // Timer & Limit
                        recordingTimer = setInterval(() => {
                            const elapsed = Date.now() - recordingStartTime;
                            const seconds = Math.floor(elapsed / 1000);
                            timerDisplay.textContent = `0:${seconds < 10 ? '0' : ''}${seconds}`;
                            
                            if (elapsed >= MAX_DURATION) {
                                stopRecording();
                            }
                        }, 100);

                    } catch (err) {
                        console.error("Error accessing microphone:", err);
                        alert("Impossible d'accéder au microphone.");
                    }
                }

                function stopRecording() {
                    if (mediaRecorder && mediaRecorder.state === 'recording') {
                        mediaRecorder.stop();
                        mediaRecorder.stream.getTracks().forEach(track => track.stop()); // Stop mic stream
                    }
                }

                // Intercept Form Submission to add Audio Blob
                if (mainForm) {
                    mainForm.addEventListener('submit', function(e) {
                         // Only intercept if we have audio or if we want to force AJAX for consistency
                         // But the controller returns JSON only if AJAX.
                         
                         if (recordedAudioBlob) {
                            e.preventDefault();
                            const btn = mainForm.querySelector('button[type="submit"]');
                            const originalBtnContent = btn.innerHTML;
                            btn.disabled = true;
                            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';

                            const formData = new FormData(mainForm);
                            // Append audio blob acting as 'image' file field
                            formData.set('comment[image]', recordedAudioBlob, 'voice-comment-' + Date.now() + '.webm');
                            
                            fetch(mainForm.action, {
                                method: 'POST',
                                body: formData,
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest', 
                                    'Accept': 'application/json'
                                }
                            }).then(response => {
                                return response.json().then(data => {
                                    if (!response.ok) {
                                        throw new Error(data.errors ? data.errors.join('\n') : 'Erreur inconnue');
                                    }
                                    return data;
                                });
                            }).then(data => {
                                if (data.success) {
                                    // Reload to show the new comment (simpler than appending manually for now)
                                    window.location.reload();
                                } else {
                                     alert("Erreur: " + (data.errors ? data.errors.join('\n') : 'Inconnue'));
                                     btn.disabled = false;
                                     btn.innerHTML = originalBtnContent;
                                }
                            }).catch(err => {
                                console.error(err);
                                alert("Erreur lors de l'envoi: " + err.message);
                                btn.disabled = false;
                                btn.innerHTML = originalBtnContent;
                            });
                         }
                    });
                }
            </script>
        {% endif %}

        <div class="d-flex flex-column gap-3">
            {% for comment in comments %}
                <div class="discovery-card p-4" id="comment-{{ comment.id }}">
                    <div class="best-comment-badge d-none" id="best-badge-{{ comment.id }}">
                        🏆 <span class="best-reason-text"></span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold discovery-card-title">{{ comment.auteur.pseudo|default(comment.auteur.username) }}</span>
                            <span class="discovery-card-subtitle small" title="{{ comment.dateCommentaire|date('d/m/Y H:i') }}">il y a {{ comment.dateCommentaire|ago }}</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn p-0 border-0 bg-transparent" onclick="playTTS(decodeURIComponent('{{ comment.contenu|url_encode }}'), this)" title="Écouter">
                                <i class="bi bi-megaphone text-secondary"></i>
                            </button>
                            <!-- Translation Comment -->
                            <div class="dropdown d-inline-block ms-1">
                                <button class="btn p-0 border-0 bg-transparent" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Traduire">
                                    <i class="bi bi-translate text-secondary"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary shadow" style="font-size: 0.8rem;">
                                    <li><button class="dropdown-item" onclick="translateContent('comment', {{ comment.id }}, 'Français')">Français</button></li>
                                    <li><button class="dropdown-item" onclick="translateContent('comment', {{ comment.id }}, 'English')">English</button></li>
                                    <li><button class="dropdown-item" onclick="translateContent('comment', {{ comment.id }}, 'Arabic')">العربية</button></li>
                                    <li><button class="dropdown-item" onclick="translateContent('comment', {{ comment.id }}, 'Spanish')">Español</button></li>
                                    <li><button class="dropdown-item" onclick="translateContent('comment', {{ comment.id }}, 'German')">Deutsch</button></li>
                                    <li><button class="dropdown-item" onclick="translateContent('comment', {{ comment.id }}, 'Italian')">Italiano</button></li>
                                </ul>
                            </div>
                            {% if app.user and comment.auteur and comment.auteur.id == app.user.id %}
                                <div class="dropdown">
                                    <button class="btn btn-link text-secondary p-0 text-decoration-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

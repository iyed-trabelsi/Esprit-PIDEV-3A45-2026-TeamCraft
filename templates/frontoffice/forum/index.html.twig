{% extends 'frontoffice/base.html.twig' %}

{% block title %}Forum Discovery - TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="h2 fw-bold mb-0 discovery-section-title">
                {% include 'frontoffice/partials/_icon_people.html.twig' %}
                Forum Discovery
            </h1>
            <a href="#" class="discovery-view-all">VIEW ALL FORUMS →</a>
        </div>
        <div class="row g-4">
            {% for post in posts %}
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="discovery-card h-100 d-flex flex-column p-4">
                        <h3 class="discovery-card-title mb-1">{{ post.title }}</h3>
                        <p class="discovery-card-subtitle mb-3">{{ post.subtitle }}</p>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge-game {{ post.gameColor }}">{{ post.game }}</span>
                            <span class="badge-rank {{ post.rankColor }}">{{ post.rank }}</span>
                        </div>
                        <a href="{{ path('app_forum_show', { id: post.id }) }}" class="btn btn-recruit mt-auto text-decoration-none text-center">View Forum</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}
{% endblock %}

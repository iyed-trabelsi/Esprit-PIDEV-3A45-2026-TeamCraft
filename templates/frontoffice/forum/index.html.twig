{% extends 'frontoffice/base.html.twig' %}

{% block title %}Forum - TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1">
        <!-- Page Header & Actions (like Teams) -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-5">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded d-inline-flex" style="background: rgba(255,255,255,0.05);">
                    {% include 'frontoffice/partials/_icon_people.html.twig' %}
                </div>
                <div>
                    <h1 class="h2 fw-bold mb-0 text-white">Forum</h1>
                    <p class="text-white-50 mb-0">Échangez et découvrez les discussions</p>
                </div>
            </div>
            {% if app.user %}
                <a href="{{ path('app_forum_rubrique_new') }}" class="btn btn-recruit px-4 py-2 d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                    </svg>
                    Create Section
                </a>
            {% endif %}
        </div>

        <!-- Mes rubriques (like My Team) -->
        {% if app.user %}
        <div class="mb-5">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="d-flex align-items-center gap-3">
                    <h2 class="h4 fw-bold text-white mb-0">My Sections</h2>
                    <div style="height: 1px; width: 50px; background: linear-gradient(90deg, rgba(255,255,255,0.1), transparent);"></div>
                </div>
                
                {% if mes_rubriques|length > 3 %}
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-tc-outline px-3 js-prev-sections" disabled>
                        <i class="bi bi-chevron-left">&lt;</i>
                    </button>
                    <button class="btn btn-sm btn-tc-outline px-3 js-next-sections">
                        <i class="bi bi-chevron-right">&gt;</i>
                    </button>
                </div>
                {% endif %}
            </div>

            {% if mes_rubriques|length > 0 %}
                <div class="row g-4" id="my-sections-container">
                    {% for rubrique in mes_rubriques %}
                        <div class="col-12 col-md-6 col-lg-4 my-section-item" style="display: {{ loop.index <= 3 ? 'block' : 'none' }}">
                            <div class="discovery-card h-100 d-flex flex-column p-4 text-center position-relative overflow-hidden border border-primary border-opacity-50 clickable-card" 
                                 onclick="if(!event.target.closest('.dropdown')){ window.location.href='{{ path('app_forum_rubrique_show', { id: rubrique.id }) }}'; }" 
                                 style="box-shadow: 0 4px 20px rgba(13, 110, 253, 0.15);">
                                
                                <div class="position-absolute top-0 end-0 p-2 d-flex align-items-center gap-2" style="z-index: 2;">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">AUTEUR</span>
                                    <div class="dropdown">
                                        <button class="btn btn-link text-white-50 p-0 fs-5" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" style="min-width: auto; padding: 0.5rem;">
                                            <li class="d-inline-block"><a class="dropdown-item p-2" href="{{ path('app_forum_rubrique_edit', { id: rubrique.id }) }}" title="Edit">
                                                <i class="bi bi-pencil-square text-success fs-5"></i>
                                            </a></li>
                                            <li class="d-inline-block">
                                                <form action="{{ path('app_forum_rubrique_delete', { id: rubrique.id }) }}" method="post" onsubmit="return confirm('Supprimer cette rubrique et tous ses posts ?');" class="d-inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_rubrique_' ~ rubrique.id) }}">
                                                    <button type="submit" class="dropdown-item p-2" title="Delete">
                                                        <i class="bi bi-trash text-danger fs-5"></i>
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="discovery-avatar mx-auto mb-3">
                                    {% if rubrique.image %}
                                        <img src="{{ asset('uploads/rubriques/' ~ rubrique.image) }}" alt="{{ rubrique.nomRubrique }}" class="w-100 h-100 rounded-circle object-fit-cover">
                                    {% else %}
                                        {{ rubrique.nomRubrique|first|upper }}
                                    {% endif %}
                                </div>
                                <h3 class="discovery-card-title mb-1 text-white">{{ rubrique.nomRubrique }}</h3>
                                <p class="discovery-card-subtitle mb-3">{{ rubrique.description|default(rubrique.topic)|default('Rubrique du forum') }}</p>
                                <div class="d-flex flex-wrap justify-content-center gap-2 mb-2">
                                    <span class="badge-game valorant">{{ rubrique.topic|default('Forum') }}</span>
                                    <span class="badge-rank green">{{ rubrique.nbPosts }} post{{ rubrique.nbPosts > 1 ? 's' : '' }}</span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {% if mes_rubriques|length > 3 %}
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <button class="btn btn-sm btn-tc-outline px-3 js-prev-sections" disabled>
                        <i class="bi bi-chevron-left">&lt;</i>
                    </button>
                    <button class="btn btn-sm btn-tc-outline px-3 js-next-sections">
                        <i class="bi bi-chevron-right">&gt;</i>
                    </button>
                </div>
                {% endif %}

            {% else %}
                <div class="text-center py-5 border border-dashed border-secondary rounded-3">
                    <p class="text-white-50 mb-3">Vous n'avez pas encore créé de rubrique.</p>
                    <a href="{{ path('app_forum_rubrique_new') }}" class="btn btn-primary btn-sm">Créer ma première rubrique</a>
                </div>
            {% endif %}
        </div>
        {% endif %}
        
        <!-- AI Recommendations -->
        {% if recommendations|length > 0 %}
        <div class="mb-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <h2 class="h4 fw-bold text-white mb-0">Recommended for You <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 fs-6 ms-2">AI powered</span></h2>
                <div style="height: 1px; width: 50px; background: linear-gradient(90deg, rgba(255,255,255,0.1), transparent);"></div>
            </div>

            <div class="row g-4">
                {% for post in recommendations %}
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="discovery-card h-100 d-flex flex-column p-4 text-center border border-info border-opacity-25 clickable-card position-relative overflow-hidden" 
                             onclick="window.location.href='{{ path('app_forum_post_show', { id: post.id }) }}';"
                             style="background: linear-gradient(145deg, rgba(13, 202, 240, 0.05) 0%, rgba(13, 110, 253, 0.02) 100%); transition: all 0.3s ease;">
                            
                            <div class="position-absolute top-0 start-0 w-100 h-1" style="background: linear-gradient(90deg, transparent, rgba(13, 202, 240, 0.3), transparent); height: 1px;"></div>
                            
                            <div class="discovery-avatar mx-auto mb-3" style="width: 60px; height: 60px; line-height: 52px; font-size: 1.5rem; border: 2px solid rgba(13, 202, 240, 0.2); background: rgba(13, 202, 240, 0.1);">
                                {% if post.image %}
                                    <img src="{{ asset('uploads/posts/' ~ post.image) }}" alt="{{ post.titre }}" class="w-100 h-100 rounded-circle object-fit-cover">
                                {% else %}
                                    <i class="bi bi-magic text-info"></i>
                                {% endif %}
                            </div>
                            
                            <h3 class="h6 fw-bold mb-2 text-white text-truncate">{{ post.titre }}</h3>
                            <p class="small text-white-50 mb-3 text-truncate" style="max-height: 40px;">
                                {{ post.rubrique.nomRubrique|default('Forum') }}
                            </p>
                            
                            <div class="mt-auto d-flex justify-content-between align-items-center border-top border-white border-opacity-10 pt-3">
                                <div class="d-flex align-items-center gap-1 text-white-50 small">
                                    <i class="bi bi-heart-fill text-danger fs-7"></i>
                                    <span>{{ post.nbLikes }}</span>
                                </div>
                                <div class="d-flex align-items-center gap-1 text-white-50 small">
                                    <i class="bi bi-eye text-info fs-7"></i>
                                    <span>{{ post.nbVues }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <!-- Forum Discovery (like Teams Discovery) -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h2 class="h4 fw-bold mb-0 discovery-section-title">
                Forum Discovery
            </h2>
            
                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-tc-outline dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="sortDropdownBtn">
                            <i class="bi bi-sort-down"></i>
                            <span id="currentSortLabel">Newest First</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item active js-sort-option" href="#" data-sort="desc">Newest First</a></li>
                            <li><a class="dropdown-item js-sort-option" href="#" data-sort="asc">Oldest First</a></li>
                        </ul>
                    </div>

                    <div class="position-relative">
                        <input type="text" id="discovery-search-input" class="form-control form-control-sm text-white ps-5" placeholder="Search..." style="background-color: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); min-width: 250px; border-radius: 20px;">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                    </div>

                {% if rubriques|length > 6 %}
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-tc-outline px-3 js-prev-discovery" disabled>
                        <i class="bi bi-chevron-left">&lt;</i>
                    </button>
                    <button class="btn btn-sm btn-tc-outline px-3 js-next-discovery">
                        <i class="bi bi-chevron-right">&gt;</i>
                    </button>
                </div>
                {% endif %}
            </div>
        </div>
        <div class="row g-4" id="discovery-container">
            {% for rubrique in rubriques %}
                <div class="col-12 col-sm-6 col-lg-4 discovery-item" data-name="{{ rubrique.nomRubrique|lower }}" data-date="{{ rubrique.dateCreation ? rubrique.dateCreation|date('U') : 0 }}" data-id="{{ rubrique.id }}" style="display: {{ loop.index <= 6 ? 'block' : 'none' }}">
                    <div class="discovery-card h-100 d-flex flex-column p-4 text-center clickable-card" 
                         onclick="window.location.href='{{ path('app_forum_rubrique_show', { id: rubrique.id }) }}';">
                        <div class="discovery-avatar mx-auto mb-3">
                            {% if rubrique.image %}
                                <img src="{{ asset('uploads/rubriques/' ~ rubrique.image) }}" alt="{{ rubrique.nomRubrique }}" class="w-100 h-100 rounded-circle object-fit-cover">
                            {% else %}
                                {{ rubrique.nomRubrique|first|upper }}
                            {% endif %}
                        </div>
                        <h3 class="discovery-card-title mb-1 text-white">{{ rubrique.nomRubrique }}</h3>
                        <p class="discovery-card-subtitle mb-3">{{ rubrique.description|default(rubrique.topic)|default('—') }}</p>
                        <div class="d-flex flex-wrap justify-content-center gap-2 mb-2">
                            <span class="badge-game valorant">{{ rubrique.topic|default('Forum') }}</span>
                            <span class="badge-rank green">{{ rubrique.nbPosts }} post{{ rubrique.nbPosts > 1 ? 's' : '' }}</span>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="discovery-card p-5 text-center">
                        <p class="discovery-card-subtitle mb-0">Aucune rubrique pour le moment.</p>
                        {% if app.user %}
                            <a href="{{ path('app_forum_rubrique_new') }}" class="btn btn-recruit mt-3">Créer la première rubrique</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
            <div id="no-results-message" class="col-12 text-center py-5 d-none">
                <p class="text-white-50">No sections found matching your search.</p>
            </div>
        </div>

        {% if rubriques|length > 6 %}
        <div class="d-flex justify-content-center gap-2 mt-4">
            <button class="btn btn-sm btn-tc-outline px-3 js-prev-discovery" disabled>
                <i class="bi bi-chevron-left">&lt;</i>
            </button>
            <button class="btn btn-sm btn-tc-outline px-3 js-next-discovery">
                <i class="bi bi-chevron-right">&gt;</i>
            </button>
        </div>
        {% endif %}
        
        <style>
            #discovery-search-input::placeholder {
                color: white !important;
                opacity: 0.7;
            }
        </style>
        
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                
                function setupPagination(itemClass, prevBtnClass, nextBtnClass, itemsPerPage, containerId) {
                    const container = containerId ? document.getElementById(containerId) : null;
                    if (!container) return null;

                    // Capture all initial items as the source of truth
                    const allItems = Array.from(container.querySelectorAll('.' + itemClass));
                    if (!allItems.length) return null;

                    const prevBtns = document.querySelectorAll('.' + prevBtnClass);
                    const nextBtns = document.querySelectorAll('.' + nextBtnClass);
                    
                    let currentPage = 0;
                    let currentFilter = '';
                    let currentSortDir = 'desc'; // Default
                    let visibleItems = [...allItems]; 

                    // Helper: Get formatted date/id
                    function getData(item) {
                        return {
                            date: parseInt(item.getAttribute('data-date') || '0'),
                            id: parseInt(item.getAttribute('data-id') || '0'),
                            name: (item.getAttribute('data-name') || '').toLowerCase(),
                            element: item
                        };
                    }

                    // Sort logic
                    function sortItemsLogic(items, direction) {
                        return items.sort((a, b) => {
                            const dataA = getData(a);
                            const dataB = getData(b);
                            
                            // Sort by Date
                            if (dataA.date !== dataB.date) {
                                return direction === 'asc' ? dataA.date - dataB.date : dataB.date - dataA.date;
                            }
                            // Fallback to ID
                            return direction === 'asc' ? dataA.id - dataB.id : dataB.id - dataA.id;
                        });
                    }

                    function updateDisplay() {
                        const totalPages = Math.ceil(visibleItems.length / itemsPerPage);
                        
                        // Bound check
                        if (currentPage >= totalPages) currentPage = Math.max(0, totalPages - 1);
                        
                        // 1. Detach all items from DOM (to avoid duplication or misordering)
                        allItems.forEach(item => item.remove());
                        
                        // 2. Hide all items (reset display)
                        allItems.forEach(item => item.style.display = 'none');

                        // 3. Determine items for current page
                        const start = currentPage * itemsPerPage;
                        const end = start + itemsPerPage;
                        const pageItems = visibleItems.slice(start, end);

                        // 4. Show and Append only current page items to container in correct order
                        pageItems.forEach(item => {
                            item.style.display = 'block';
                            container.appendChild(item);
                        });

                        // 5. Update Buttons
                        prevBtns.forEach(btn => btn.disabled = currentPage === 0 || totalPages === 0);
                        nextBtns.forEach(btn => btn.disabled = currentPage >= totalPages - 1 || totalPages === 0);

                        // 6. No Results handling
                        const noResultsMsg = document.getElementById('no-results-message');
                        if (noResultsMsg) {
                            if (visibleItems.length === 0 && currentFilter !== '') {
                                container.appendChild(noResultsMsg); // Move message to end
                                noResultsMsg.classList.remove('d-none');
                            } else {
                                noResultsMsg.classList.add('d-none');
                            }
                        }
                    }

                    // Add click event listeners for pagination buttons
                    prevBtns.forEach(btn => {
                        btn.addEventListener('click', function() {
                            if (currentPage > 0) {
                                currentPage--;
                                updateDisplay();
                            }
                        });
                    });

                    nextBtns.forEach(btn => {
                        btn.addEventListener('click', function() {
                            const totalPages = Math.ceil(visibleItems.length / itemsPerPage);
                            if (currentPage < totalPages - 1) {
                                currentPage++;
                                updateDisplay();
                            }
                        });
                    });

                    // Public Interface
                    return {
                        filter: function(term) {
                            currentFilter = term.toLowerCase().trim();
                            
                            if (!currentFilter) {
                                visibleItems = [...allItems];
                            } else {
                                visibleItems = allItems.filter(item => {
                                    return getData(item).name.includes(currentFilter);
                                });
                            }
                            
                            // Re-sort filtered items
                            sortItemsLogic(visibleItems, currentSortDir);
                            
                            currentPage = 0;
                            updateDisplay();
                        },
                        sort: function(direction) {
                            currentSortDir = direction;
                            sortItemsLogic(visibleItems, currentSortDir);
                            currentPage = 0;
                            updateDisplay();
                        },
                        init: function() {
                            // Initial sort matches default
                            sortItemsLogic(visibleItems, currentSortDir);
                            updateDisplay();
                        }
                    };
                }

                // 1. My Sections (Simple pagination, no sort/filter)
                const mySectionPaginator = setupPagination('my-section-item', 'js-prev-sections', 'js-next-sections', 3, 'my-sections-container');
                if (mySectionPaginator) mySectionPaginator.init();

                // 2. Forum Discovery (Full features)
                const discoveryPaginator = setupPagination('discovery-item', 'js-prev-discovery', 'js-next-discovery', 6, 'discovery-container');
                if (discoveryPaginator) {
                    discoveryPaginator.init();
                    
                    // Search Input
                    const searchInput = document.getElementById('discovery-search-input');
                    if (searchInput) {
                        searchInput.addEventListener('input', (e) => discoveryPaginator.filter(e.target.value));
                    }

                    // Sort Dropdown
                    const sortOptions = document.querySelectorAll('.js-sort-option');
                    const currentSortLabel = document.getElementById('currentSortLabel');
                    
                    sortOptions.forEach(option => {
                        option.addEventListener('click', function(e) {
                            e.preventDefault();
                            const dir = this.getAttribute('data-sort');
                            
                            // Update UI
                            sortOptions.forEach(o => o.classList.remove('active'));
                            this.classList.add('active');
                            if (currentSortLabel) currentSortLabel.textContent = this.textContent;

                            // Trigger Sort
                            discoveryPaginator.sort(dir);
                        });
                    });
                }
            });
        </script>
    </section>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}
{% endblock %}

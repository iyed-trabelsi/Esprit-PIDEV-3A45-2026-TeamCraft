{% extends 'frontoffice/base.html.twig' %}

{% block title %}Forum - TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1">
        <!-- Page Header & Actions (like Teams) -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-5">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded d-inline-flex" style="background: rgba(255,255,255,0.05);">
                    {% include 'frontoffice/partials/_icon_people.html.twig' %}
                </div>
                <div>
                    <h1 class="h2 fw-bold mb-0 text-white">Forum</h1>
                    <p class="text-white-50 mb-0">Échangez et découvrez les discussions</p>
                </div>
            </div>
            {% if app.user %}
                <a href="{{ path('app_forum_rubrique_new') }}" class="btn btn-recruit px-4 py-2 d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                    </svg>
                    Create Section
                </a>
            {% endif %}
        </div>

        <!-- Mes rubriques (like My Team) -->
        {% if app.user %}
        <div class="mb-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <h2 class="h4 fw-bold text-white mb-0">My Sections</h2>
                <div class="flex-grow-1" style="height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.1), transparent);"></div>
            </div>

            {% if mes_rubriques|length > 0 %}
                <div class="row g-4">
                    {% for rubrique in mes_rubriques %}
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="discovery-card h-100 d-flex flex-column p-4 text-center position-relative overflow-hidden border border-primary border-opacity-50" style="box-shadow: 0 4px 20px rgba(13, 110, 253, 0.15);">
                                <div class="position-absolute top-0 end-0 p-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">AUTEUR</span>
                                </div>
                                <div class="discovery-avatar mx-auto mb-3">{{ rubrique.nomRubrique|first|upper }}</div>
                                <h3 class="discovery-card-title mb-1 text-white">{{ rubrique.nomRubrique }}</h3>
                                <p class="discovery-card-subtitle mb-3">{{ rubrique.description|default(rubrique.topic)|default('Rubrique du forum') }}</p>
                                <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
                                    <span class="badge-game valorant">{{ rubrique.topic|default('Forum') }}</span>
                                    <span class="badge-rank green">{{ rubrique.nbPosts }} post{{ rubrique.nbPosts > 1 ? 's' : '' }}</span>
                                </div>
                                <div class="mt-auto row g-2">
                                    <div class="col-12">
                                        <a href="{{ path('app_forum_rubrique_show', { id: rubrique.id }) }}" class="btn btn-sm btn-outline-light w-100">View Posts</a>
                                    </div>
                                    <div class="col-12 d-flex gap-2">
                                        <a href="{{ path('app_forum_rubrique_edit', { id: rubrique.id }) }}" class="btn btn-success btn-sm flex-grow-1 fw-bold">Edit</a>
                                        <form action="{{ path('app_forum_rubrique_delete', { id: rubrique.id }) }}" method="post" class="flex-grow-1" onsubmit="return confirm('Supprimer cette rubrique et tous ses posts ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_rubrique_' ~ rubrique.id) }}">
                                            <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-5 border border-dashed border-secondary rounded-3">
                    <p class="text-white-50 mb-3">Vous n'avez pas encore créé de rubrique.</p>
                    <a href="{{ path('app_forum_rubrique_new') }}" class="btn btn-primary btn-sm">Créer ma première rubrique</a>
                </div>
            {% endif %}
        </div>
        {% endif %}

        <!-- Forum Discovery (like Teams Discovery) -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h2 class="h4 fw-bold mb-0 discovery-section-title">
                Forum Discovery
            </h2>
        </div>
        <div class="row g-4">
            {% for rubrique in rubriques %}
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="discovery-card h-100 d-flex flex-column p-4 text-center">
                        <div class="discovery-avatar mx-auto mb-3">{{ rubrique.nomRubrique|first|upper }}</div>
                        <h3 class="discovery-card-title mb-1">{{ rubrique.nomRubrique }}</h3>
                        <p class="discovery-card-subtitle mb-3">{{ rubrique.description|default(rubrique.topic)|default('—') }}</p>
                        <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                            <span class="badge-game valorant">{{ rubrique.topic|default('Forum') }}</span>
                            <span class="badge-rank green">{{ rubrique.nbPosts }} post{{ rubrique.nbPosts > 1 ? 's' : '' }}</span>
                        </div>
                        <a href="{{ path('app_forum_rubrique_show', { id: rubrique.id }) }}" class="btn btn-recruit mt-auto text-decoration-none">View All Posts</a>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="discovery-card p-5 text-center">
                        <p class="discovery-card-subtitle mb-0">Aucune rubrique pour le moment.</p>
                        {% if app.user %}
                            <a href="{{ path('app_forum_rubrique_new') }}" class="btn btn-recruit mt-3">Créer la première rubrique</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}
{% endblock %}

{% extends 'frontoffice/base.html.twig' %}

{% block title %}Modifier le commentaire - Forum TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1 d-flex flex-column justify-content-center">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_forum') }}" class="text-secondary text-decoration-none">Forum</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_forum_post_show', { id: comment.post.id }) }}" class="text-secondary text-decoration-none">Post</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Modifier le commentaire</li>
            </ol>
        </nav>

        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card bg-dark border-0 shadow-lg text-white" style="border-radius: 1rem; background: #1a1a1a;">
                    <div class="card-body p-5">
                        <div class="text-center mb-5">
                            <h1 class="h2 fw-bold mb-2 text-white">Modifier le commentaire</h1>
                            <p class="text-white-50">Modifiez le contenu de votre commentaire</p>
                        </div>

                        {{ form_start(form) }}
                            <div class="mb-5">
                                {{ form_label(form.contenu, null, {'label_attr': {'class': 'form-label text-white-50'}}) }}
                                {{ form_widget(form.contenu, {'attr': {'class': 'form-control bg-black text-white border-secondary'}}) }}
                                {{ form_errors(form.contenu) }}
                            </div>

                            <div class="d-grid gap-3 d-md-flex justify-content-md-between align-items-center">
                                <a href="{{ path('app_forum_post_show', { id: comment.post.id }) }}#comments" class="btn btn-outline-danger px-4">Cancel</a>
                                <button type="submit" class="btn btn-success px-5 fw-bold">Enregistrer</button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}
{% endblock %}

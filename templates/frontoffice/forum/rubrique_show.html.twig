{% extends 'frontoffice/base.html.twig' %}

{% block title %}{{ rubrique.nomRubrique }} - Forum TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_forum') }}" class="text-secondary text-decoration-none">Forum</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">{{ rubrique.nomRubrique }}</li>
            </ol>
        </nav>

        <div class="row g-4">
            {% if canEdit %}
            <div class="col-12 col-lg-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-box p-2 rounded text-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-gear" viewBox="0 0 16 16">
                            <path d="M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm.256 7a4.474 4.474 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.36 10 8 10c.049 0 .098.001.147.005A4.49 4.49 0 0 1 8 13.5a4.49 4.49 0 0 1 4.642-4.745.5.5 0 0 1 .508.495v.005a5.503 5.503 0 0 0 .507.005H14a.5.5 0 0 1 .495.508V14a.5.5 0 0 1-.508.495H8.256Zm-.055-.494A3.5 3.5 0 0 0 12 10.5a3.49 3.49 0 0 0-3.417 3.46c.01.21.03.418.06.621.037.247.112.483.218.705.105.218.243.417.408.598.66.721 1.638 1.116 2.731 1.116s2.07-.395 2.731-1.116c.165-.181.303-.38.408-.598.106-.222.181-.458.218-.705.03-.203.05-.411.06-.621A3.49 3.49 0 0 0 12 10.5Zm-8.497.001a.5.5 0 0 1-.005.494.5.5 0 0 1-.495-.005.5.5 0 0 1-.005-.494.5.5 0 0 1 .495.005.5.5 0 0 1 .005.494Z"/>
                            <path d="M13.43 12.18c-.027-.378-.073-.75-.138-1.113l-.007-.038a4.507 4.507 0 0 0-.276-1.026l.006-.033a3.507 3.507 0 0 0-.308-.72l.006-.035a2.508 2.508 0 0 0-.29-.53l.004-.025a1.505 1.505 0 0 0-.374-.75h.001l-.002-.002a2.495 2.495 0 0 0-.002 4.28 2.477 2.477 0 0 0 1.396-.008Z"/>
                        </svg>
                    </div>
                    <h1 class="h3 fw-bold text-white mb-0">Manage Section</h1>
                </div>
                <div class="card bg-dark border-0 shadow mb-4" style="background-color: #16161a !important;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="rounded-circle p-1 border border-warning border-opacity-25">
                                <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center text-dark fw-bold fs-4" style="width: 60px; height: 60px;">
                                    {{ rubrique.nomRubrique|first|upper }}
                                </div>
                            </div>
                            <div>
                                <h2 class="h5 fw-bold text-white mb-0">{{ rubrique.nomRubrique }}</h2>
                                <p class="text-secondary mb-0 small">
                                    {{ rubrique.description|default(rubrique.topic)|default('Rubrique du forum') }}
                                </p>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_forum_rubrique_edit', { id: rubrique.id }) }}" class="btn btn-success flex-grow-1 fw-bold" style="font-size: 0.9rem;">Edit Section</a>
                            <form action="{{ path('app_forum_rubrique_delete', { id: rubrique.id }) }}" method="post" class="flex-grow-1" onsubmit="return confirm('Supprimer cette rubrique et tous ses posts ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_rubrique_' ~ rubrique.id) }}">
                                <button type="submit" class="btn btn-danger w-100 fw-bold" style="font-size: 0.9rem;">Delete Section</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}

            <div class="col-12 {% if canEdit %}col-lg-8{% endif %}">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <div>
                        <h2 class="h4 fw-bold text-white mb-1">{{ rubrique.nomRubrique }}</h2>
                        <p class="text-secondary mb-0 small">{{ rubrique.description|default('') }}</p>
                        {% if not canAddPost %}
                            <p class="text-warning small mb-0 mt-1">Cette rubrique est archivée. Les nouveaux posts sont désactivés.</p>
                        {% endif %}
                    </div>
                    {% if app.user and canAddPost %}
                        <a href="{{ path('app_forum_post_new', { rubrique: rubrique.id }) }}" class="btn btn-success px-4 fw-bold">New Post</a>
                    {% endif %}
                </div>

        <div class="row g-4">
            {% for post in posts %}
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="discovery-card h-100 d-flex flex-column p-4">
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <span class="badge-game valorant">{{ post.typePost }}</span>
                            <span class="badge-rank purple">{{ post.nbVues }} vues</span>
                        </div>
                        <h3 class="discovery-card-title mb-2">{{ post.titre }}</h3>
                        <p class="discovery-card-subtitle small mb-3 flex-grow-1">{{ post.contenu|length > 80 ? post.contenu|slice(0, 80) ~ '…' : post.contenu }}</p>
                        <p class="discovery-card-subtitle small mb-2">Par {{ post.auteur.pseudo|default(post.auteur.username) }} · {{ post.dateCreation|date('d/m/Y') }}</p>
                        <a href="{{ path('app_forum_post_show', { id: post.id }) }}" class="btn btn-recruit mt-auto text-decoration-none text-center">View Post</a>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="discovery-card p-5 text-center">
                        <p class="discovery-card-subtitle mb-0">Aucun post dans cette rubrique.</p>
                        {% if app.user %}
                            <a href="{{ path('app_forum_post_new', { rubrique: rubrique.id }) }}" class="btn btn-recruit mt-3">Créer le premier post</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

                <div class="mt-4">
                    <a href="{{ path('app_forum') }}" class="discovery-view-all text-decoration-none">← Return</a>
                </div>
            </div>
        </div>
    </section>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}
{% endblock %}

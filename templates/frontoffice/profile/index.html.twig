    {% if app.user and app.user.id == user.id %}
        <!-- Create Competitive Rank Modal -->
        <div class="modal fade" id="createRankModal" tabindex="-1" aria-labelledby="createRankModalLabel" aria-hidden="true">
            {# ... modal content ... #}
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content card-tc-premium border-0 shadow-lg">
                    <div class="modal-header-premium border-bottom border-white-10 p-4 d-flex justify-content-between align-items-center">
                        <h5 class="modal-title text-white mb-0" id="createRankModalLabel">
                            <i class="bi bi-trophy me-2 text-success"></i> Create Competitive Rank
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="POST" action="{{ path('app_profile') }}" novalidate>
                        <div class="modal-body p-4">
                            <div class="row g-4">
                                <!-- Game Selection -->
                                <div class="col-12">
                                    <label class="form-label text-white-50 small d-block mb-3">Choisir un jeu *</label>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <input type="radio" class="btn-check" name="competitive_game" id="create_rank_game_valorant" value="valorant" autocomplete="off">
                                            <label class="btn btn-outline-danger w-100 py-3 fw-bold" for="create_rank_game_valorant">
                                                VALORANT
                                            </label>
                                        </div>
                                        <div class="col-md-4">
                                            <input type="radio" class="btn-check" name="competitive_game" id="create_rank_game_lol" value="lol" autocomplete="off">
                                            <label class="btn btn-outline-warning w-100 py-3 fw-bold" for="create_rank_game_lol">
                                                LEAGUE OF LEGENDS
                                            </label>
                                        </div>
                                        <div class="col-md-4">
                                            <input type="radio" class="btn-check" name="competitive_game" id="create_rank_game_cs2" value="cs2" autocomplete="off">
                                            <label class="btn btn-outline-light w-100 py-3 fw-bold" for="create_rank_game_cs2">
                                                COUNTER-STRIKE 2
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Principal Role -->
                                <div class="col-md-6">
                                    <label class="form-label text-white-50 small">Rôle Principal *</label>
                                    <select class="form-select modal-tc-input" name="principal_role" id="create_rank_role" disabled>
                                        <option value="">Sélectionner un jeu d'abord</option>
                                    </select>
                                </div>

                                <!-- Skill Level -->
                                <div class="col-md-6">
                                    <label class="form-label text-white-50 small">Niveau de jeu *</label>
                                    <select class="form-select modal-tc-input" name="skill_level" id="create_rank_level" disabled>
                                        <option value="">Sélectionner un jeu d'abord</option>
                                    </select>
                                </div>

                                <!-- Experience -->
                                <div class="col-md-6">
                                    <label class="form-label text-white-50 small">Expérience *</label>
                                    <select class="form-select modal-tc-input" name="experience">
                                        <option value="">Sélectionner</option>
                                        <option value="beginner">Débutant (< 6 mois)</option>
                                        <option value="intermediate">Intermédiaire (6 mois - 2 ans)</option>
                                        <option value="advanced">Avancé (2-5 ans)</option>
                                        <option value="expert">Expert (5+ ans)</option>
                                        <option value="pro">Professionnel</option>
                                    </select>
                                </div>

                                <!-- Availability -->
                                <div class="col-md-6">
                                    <label class="form-label text-white-50 small">Disponibilité *</label>
                                    <select class="form-select modal-tc-input" name="availability">
                                        <option value="">Sélectionner</option>
                                        <option value="weekdays_evening">Soirs en semaine</option>
                                        <option value="weekends">Week-ends</option>
                                        <option value="weekdays_weekends">Soirs & week-ends</option>
                                        <option value="full_time">Temps plein</option>
                                        <option value="flexible">Flexible</option>
                                    </select>
                                </div>

                                <!-- Region/Server -->
                                <div class="col-12">
                                    <label class="form-label text-white-50 small">Région / Serveur *</label>
                                    <select class="form-select modal-tc-input" name="region">
                                        <option value="">Sélectionner une région</option>
                                        <optgroup label="Europe">
                                            <option value="EUW">EUW (Europe West)</option>
                                            <option value="EUNE">EUNE (Europe Nordic & East)</option>
                                            <option value="EU">EU (Europe)</option>
                                        </optgroup>
                                        <optgroup label="Americas">
                                            <option value="NA">NA (North America)</option>
                                            <option value="LAN">LAN (Latin America North)</option>
                                            <option value="LAS">LAS (Latin America South)</option>
                                            <option value="BR">BR (Brazil)</option>
                                        </optgroup>
                                        <optgroup label="Asia">
                                            <option value="KR">KR (Korea)</option>
                                            <option value="JP">JP (Japan)</option>
                                            <option value="OCE">OCE (Oceania)</option>
                                            <option value="SEA">SEA (Southeast Asia)</option>
                                        </optgroup>
                                        <optgroup label="Other">
                                            <option value="TR">TR (Turkey)</option>
                                            <option value="RU">RU (Russia)</option>
                                            <option value="MENA">MENA (Middle East & North Africa)</option>
                                        </optgroup>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-top border-white-10 p-4 d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-tc-secondary px-4 py-2" data-bs-dismiss="modal">Annuler</button>
                            <button type="submit" class="btn btn-tc-primary px-4 py-2">
                                <i class="bi bi-check-circle me-2"></i> Créer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Modals Loop -->
     {% for rank in competitiveRanks %}
        <!-- View Details Modal -->
        <div class="modal fade" id="viewRankModal_{{ rank.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content card-tc-premium border-0 game-accent-{{ rank.game_key|lower }}">
                    <div class="modal-header-premium d-flex justify-content-between align-items-center">
                        <h5 class="modal-title text-white mb-0">Détails du Profil</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="text-center mb-4 pb-4 border-bottom border-white-10">
                            <div class="position-relative d-inline-block mb-3">
                                <div class="position-absolute top-50 left-50 translate-middle" style="width: 120px; height: 120px; background: radial-gradient(circle, rgba(14, 165, 233, 0.2) 0%, transparent 70%); filter: blur(15px);"></div>
                                <img src="{{ rank.logo }}" alt="{{ rank.game }}" style="width: 100px; height: 100px; object-fit: contain; position: relative;">
                            </div>
                            <h3 class="text-white fw-bold mb-1">{{ rank.game }}</h3>
                            <div class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                <i class="bi bi-award-fill me-1"></i> {{ rank.rank|capitalize }}
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-6">
                                <div class="info-card-premium">
                                    <span class="info-label"><i class="bi bi-person-badge me-1"></i> Rôle</span>
                                    <span class="info-value text-white">{{ rank.role|capitalize }}</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-card-premium">
                                    <span class="info-label"><i class="bi bi-globe me-1"></i> Région</span>
                                    <span class="info-value text-white">{{ rank.region }}</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-card-premium">
                                    <span class="info-label"><i class="bi bi-clock-history me-1"></i> Expérience</span>
                                    <span class="info-value text-white">{{ rank.experience|capitalize }}</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-card-premium">
                                    <span class="info-label"><i class="bi bi-calendar-check me-1"></i> Disponibilité</span>
                                    <span class="info-value text-white">{{ rank.availability|replace({'_': ' '})|capitalize }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4 pt-0 justify-content-center">
                        <button type="button" class="btn btn-tc-secondary px-5 py-2" data-bs-dismiss="modal">FERMER</button>
                    </div>
                </div>
            </div>
        </div>

        {% if app.user and app.user.id == user.id %}
            <!-- Edit Rank Modal -->
            <div class="modal fade" id="editRankModal_{{ rank.id }}" tabindex="-1" aria-hidden="true">
                {# ... modal content ... #}
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content card-tc-premium border-0 game-accent-{{ rank.game_key|lower }}">
                        <div class="modal-header-premium d-flex justify-content-between align-items-center">
                            <h5 class="modal-title text-white mb-0">Modifier mon Rang</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form method="POST" action="{{ path('app_profile_rank_edit', {'id': rank.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('edit' ~ rank.id) }}">
                            <div class="modal-body p-4 text-start">
                                <div class="alert alert-info bg-info bg-opacity-10 border-info border-opacity-25 text-info small mb-4">
                                    <i class="bi bi-info-circle me-2"></i> Mettez à jour vos informations pour le jeu <strong>{{ rank.game }}</strong>.
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-white-50 small">Rôle Principal</label>
                                        <select class="form-select modal-tc-input" name="principal_role" required>
                                            {% set game_roles = [] %}
                                            {% if rank.game_key|lower == 'valorant' %}
                                                {% set game_roles = ['Duellistes', 'Initiators', 'Controllers', 'Sentinelles'] %}
                                            {% elseif rank.game_key|lower == 'lol' or rank.game_key|lower == 'league of legends' %}
                                                {% set game_roles = ['TOP', 'JGL', 'MID', 'ADC', 'Support'] %}
                                            {% elseif rank.game_key|lower == 'cs2' or rank.game_key|lower == 'counter-strike 2' %}
                                                {% set game_roles = ['Entry Fragger', 'Sniper (AWP)', 'In-Game Leader', 'Lurker', 'Support', 'Anchor'] %}
                                            {% else %}
                                                {% set game_roles = ['Flex', 'Support', 'Leader', 'Player'] %}
                                            {% endif %}

                                            {% for role in game_roles %}
                                                <option value="{{ role }}" {{ rank.role == role ? 'selected' : '' }}>{{ role }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-white-50 small">Niveau de jeu</label>
                                        <select class="form-select modal-tc-input" name="skill_level" required>
                                            {% set game_ranks = [] %}
                                            {% if rank.game_key|lower == 'valorant' %}
                                                {% set game_ranks = ['Iron', 'Bronze', 'Silver', 'Gold', 'Platinum', 'Diamond', 'Ascendant', 'Immortal', 'Radiant'] %}
                                            {% elseif rank.game_key|lower == 'lol' or rank.game_key|lower == 'league of legends' %}
                                                {% set game_ranks = ['Iron', 'Bronze', 'Silver', 'Gold', 'Platinum', 'Emerald', 'Diamond', 'Master', 'Grandmaster', 'Challenger'] %}
                                            {% elseif rank.game_key|lower == 'cs2' or rank.game_key|lower == 'counter-strike 2' %}
                                                {% set game_ranks = ['Silver', 'Silver Elite', 'Silver Elite Master', 'Gold Nova', 'Gold Nova Master', 'Master Guardian', 'Master Guardian Elite', 'Distinguished Master Guardian', 'Legendary Eagle', 'Legendary Eagle Master', 'Supreme Master First Class', 'Global Elite'] %}
                                            {% else %}
                                                {% set game_ranks = ['Beginner', 'Intermediate', 'Advanced', 'Expert', 'Pro'] %}
                                            {% endif %}

                                            {% for level in game_ranks %}
                                                <option value="{{ level }}" {{ rank.rank == level ? 'selected' : '' }}>{{ level }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="col-12 mb-3">
                                        <label class="form-label text-white-50 small">Expérience</label>
                                        <select class="form-select modal-tc-input" name="experience" required>
                                            {% set experiences = {'beginner': 'Débutant (< 6 mois)', 'intermediate': 'Intermédiaire (6 mois - 2 ans)', 'advanced': 'Avancé (2-5 ans)', 'expert': 'Expert (5+ ans)', 'pro': 'Professionnel'} %}
                                            {% for val, lab in experiences %}
                                                <option value="{{ val }}" {{ rank.experience == val ? 'selected' : '' }}>{{ lab }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-white-50 small">Disponibilité</label>
                                        <select class="form-select modal-tc-input" name="availability" required>
                                            {% set availabilities = {'weekdays_evening': 'Soirs en semaine', 'weekends': 'Week-ends', 'weekdays_weekends': 'Soirs & week-ends', 'full_time': 'Temps plein', 'flexible': 'Flexible'} %}
                                            {% for val, lab in availabilities %}
                                                <option value="{{ val }}" {{ rank.availability == val ? 'selected' : '' }}>{{ lab }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label text-white-50 small">Région / Serveur</label>
                                        <select class="form-select modal-tc-input" name="region" required>
                                            {% for reg in ['EUW', 'EUNE', 'EU', 'NA', 'LAN', 'LAS', 'BR', 'KR', 'JP', 'OCE', 'SEA', 'TR', 'RU', 'MENA'] %}
                                                <option value="{{ reg }}" {{ rank.region == reg ? 'selected' : '' }}>{{ reg }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-top border-white-05 p-4 d-flex justify-content-center gap-3">
                                <button type="button" class="btn btn-tc-secondary px-4 py-2" data-bs-dismiss="modal">ANNULER</button>
                                <button type="submit" class="btn btn-tc-primary px-4 py-2">ENREGISTRER</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}


    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const gameRadios = document.querySelectorAll('input[name="competitive_game"]');
            const roleSelect = document.getElementById('create_rank_role');
            const levelSelect = document.getElementById('create_rank_level');

            const gameData = {
                valorant: {
                    roles: ['Duellistes', 'Initiators', 'Controllers', 'Sentinelles'],
                    ranks: ['Iron', 'Bronze', 'Silver', 'Gold', 'Platinum', 'Diamond', 'Ascendant', 'Immortal', 'Radiant']
                },
                lol: {
                    roles: ['TOP', 'JGL', 'MID', 'ADC', 'Support'],
                    ranks: ['Iron', 'Bronze', 'Silver', 'Gold', 'Platinum', 'Emerald', 'Diamond', 'Master', 'Grandmaster', 'Challenger']
                },
                cs2: {
                    roles: ['Entry Fragger', 'Sniper (AWP)', 'In-Game Leader', 'Lurker', 'Support', 'Anchor'],
                    ranks: ['Silver', 'Silver Elite', 'Silver Elite Master', 'Gold Nova', 'Gold Nova Master', 'Master Guardian', 'Master Guardian Elite', 'Distinguished Master Guardian', 'Legendary Eagle', 'Legendary Eagle Master', 'Supreme Master First Class', 'Global Elite']
                }
            };

            gameRadios.forEach(radio => {
                radio.addEventListener('change', function() {
                    const game = this.value;
                    const data = gameData[game];

                    if (data) {
                        // Enable selects
                        roleSelect.disabled = false;
                        levelSelect.disabled = false;

                        // Populate Roles
                        roleSelect.innerHTML = '<option value="">Sélectionner un rôle</option>';
                        data.roles.forEach(role => {
                            const option = document.createElement('option');
                            option.value = role;
                            option.textContent = role;
                            roleSelect.appendChild(option);
                        });

                        // Populate Ranks
                        levelSelect.innerHTML = '<option value="">Sélectionner un niveau</option>';
                        data.ranks.forEach(rank => {
                            const option = document.createElement('option');
                            option.value = rank;
                            option.textContent = rank;
                            levelSelect.appendChild(option);
                        });
                    }
                });
            });
        });
    </script>
{% endblock %}

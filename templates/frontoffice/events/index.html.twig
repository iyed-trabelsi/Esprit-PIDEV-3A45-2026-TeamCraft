{% extends 'frontoffice/base.html.twig' %}

{% block title %}Événements - TEAMCRAFT{% endblock %}

{% block flash_messages %}
    {{ parent() }}
{% endblock %}

{% block stylesheets %}
<style>
    /* Scoped styles for event images */
    .event-card-banner {
        width: 100%;
        height: 200px;
        object-fit: contain;
        border-radius: 12px;
        margin-bottom: 1.25rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: block;
        background: rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .event-card-banner:hover {
        transform: scale(1.05);
        box-shadow: 0 8px 25px rgba(168, 85, 247, 0.3);
    }
    
    .event-image-container {
        position: relative;
        width: 100%;
        height: 200px;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1.25rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .discovery-avatar {
        overflow: hidden !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    .date-label {
        color: var(--tc-cyan);
        font-weight: 700;
    }
    .status-open {
        background-color: var(--tc-neon-green) !important;
        color: #fff !important;
    }
    .place-label {
        color: #ff4444 !important; /* Vivid Red */
        font-weight: 700 !important;
        opacity: 1 !important;
    }
    /* --- Premium Calendar UI --- */
    .calendar-modal-content {
        background: rgba(13, 13, 27, 0.96) !important;
        backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    .fc { 
        color: #e2e8f0 !important; 
        font-family: inherit;
    }
    /* Hierarchy: Muted numbers */
    .fc-daygrid-day-number {
        color: #94a3b8 !important; /* Soft Slate Gray */
        font-weight: 500 !important;
        font-size: 0.85rem !important;
        padding: 8px !important;
        text-decoration: none !important;
    }
    /* Grid feel */
    .fc-theme-standard td, .fc-theme-standard th {
        border: 1px solid rgba(255, 255, 255, 0.04) !important;
    }
    .fc-scrollgrid { border: none !important; }

    /* Day Card Feel */
    .fc-daygrid-day {
        background: rgba(255, 255, 255, 0.01);
        transition: background 0.2s ease;
    }
    .fc-daygrid-day:hover {
        background: rgba(6, 182, 212, 0.04) !important;
    }
    /* Weekend Shading */
    .fc-day-sun, .fc-day-sat {
        background: rgba(0, 0, 0, 0.15) !important;
    }
    /* Today Highlight */
    .fc-day-today {
        background: rgba(6, 182, 212, 0.06) !important;
        outline: 1px solid rgba(6, 182, 212, 0.3) !important;
        outline-offset: -1px;
    }
    .fc-day-today .fc-daygrid-day-number {
        color: var(--tc-cyan) !important;
        font-weight: 800 !important;
    }

    /* Header Design */
    .fc-toolbar-title {
        font-size: 1.6rem !important;
        letter-spacing: 2px !important;
        color: var(--tc-cyan) !important;
        text-shadow: 0 0 15px rgba(6, 182, 212, 0.3);
        font-weight: 800 !important;
        text-transform: uppercase;
    }
    .fc-button-primary {
        background: rgba(255,255,255,0.05) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        text-transform: uppercase;
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 1px;
        padding: 8px 16px !important;
        border-radius: 8px !important;
        transition: all 0.2s ease !important;
    }
    .fc-button-primary:hover {
        background: var(--tc-cyan) !important;
        color: #000 !important;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    }
    .fc-button-active {
        background: var(--tc-cyan) !important;
        color: #000 !important;
    }

    /* Event Tags (The Major Upgrade) */
    .fc-event {
        border-radius: 6px !important;
        padding: 4px 8px !important;
        margin: 2px 4px !important;
        border: none !important;
        font-size: 0.75rem !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
        animation: eventFadeIn 0.4s ease-out backwards;
        cursor: pointer !important;
        transition: transform 0.2s ease, filter 0.2s ease !important;
    }
    .fc-event:hover {
        transform: translateY(-1px) scale(1.02);
        background: rgba(255, 255, 255, 0.12) !important;
        box-shadow: 0 8px 20px -5px rgba(0, 0, 0, 0.5);
    }
    /* List View Fixes (Prevent Whiteout) */
    .fc-list-event:hover td {
        background: rgba(6, 182, 212, 0.1) !important;
    }
    .fc-list-day-side-text, .fc-list-day-text {
        color: var(--tc-cyan) !important;
        font-weight: 800 !important;
    }
    .fc-list-day-cushion {
        background: rgba(255, 255, 255, 0.05) !important;
    }
    .fc-list-event-title a {
        color: #e2e8f0 !important;
        text-decoration: none !important;
    }
    .fc-list-table {
        border-color: rgba(255, 255, 255, 0.05) !important;
    }
    .fc-list-event {
        cursor: pointer !important;
    }
    @keyframes eventFadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* --- Ultra-Intense Neon Glow Squares --- */
    .fc-event-square {
        width: 9px;
        height: 9px;
        border-radius: 2px;
        margin-right: 10px;
        display: inline-block;
        flex-shrink: 0;
        position: relative;
    }
    .square-open { 
        background: #00ff88; /* Even brighter green */
        box-shadow: 0 0 10px #00ff88, 0 0 20px rgba(0, 255, 136, 0.6), 0 0 30px rgba(0, 255, 136, 0.3) !important; 
        animation: pulse-green 1s infinite cubic-bezier(0.4, 0, 0.2, 1); 
    }
    .square-closed { 
        background: #ff0044; /* Even brighter red */
        box-shadow: 0 0 10px #ff0044, 0 0 20px rgba(255, 0, 68, 0.6), 0 0 30px rgba(255, 0, 68, 0.3) !important; 
        animation: pulse-red 1s infinite cubic-bezier(0.4, 0, 0.2, 1); 
    }
    .square-over { 
        background: #94a3b8; 
        box-shadow: 0 0 6px #94a3b8, 0 0 12px rgba(148, 163, 184, 0.4) !important; 
        animation: pulse-grey 2.5s infinite ease-in-out; 
    }

    @keyframes pulse-green {
        0% { transform: scale(1) rotate(0deg); box-shadow: 0 0 10px #00ff88, 0 0 15px rgba(0, 255, 136, 0.4); }
        50% { transform: scale(1.6) rotate(15deg); box-shadow: 0 0 20px #00ff88, 0 0 40px rgba(0, 255, 136, 0.9), 0 0 60px rgba(0, 255, 136, 0.5); }
        100% { transform: scale(1) rotate(0deg); box-shadow: 0 0 10px #00ff88, 0 0 15px rgba(0, 255, 136, 0.4); }
    }
    @keyframes pulse-red {
        0% { transform: scale(1) rotate(0deg); box-shadow: 0 0 10px #ff0044, 0 0 15px rgba(255, 0, 68, 0.4); }
        50% { transform: scale(1.6) rotate(-15deg); box-shadow: 0 0 20px #ff0044, 0 0 40px rgba(255, 0, 68, 0.9), 0 0 60px rgba(255, 0, 68, 0.5); }
        100% { transform: scale(1) rotate(0deg); box-shadow: 0 0 10px #ff0044, 0 0 15px rgba(255, 0, 68, 0.4); }
    }
    @keyframes pulse-grey {
        0% { opacity: 0.6; transform: scale(1); box-shadow: 0 0 5px #94a3b8; }
        50% { opacity: 1; transform: scale(1.3); box-shadow: 0 0 15px #94a3b8, 0 0 30px rgba(148, 163, 184, 0.5); }
        100% { opacity: 0.6; transform: scale(1); box-shadow: 0 0 5px #94a3b8; }
    }

    /* Premium Tag (Subtle Glass) */
    .fc-event-tag {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        padding: 4px 10px !important;
        border-radius: 8px !important;
        width: 100%;
    }

    /* Participation Life (Cyan Neon Glow) */
    .event-participating {
        border: 1px solid rgba(6, 182, 212, 0.5) !important;
        background: rgba(6, 182, 212, 0.08) !important;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.2) !important;
    }
    .fc-event-runner {
        font-size: 1.1rem;
        margin-left: 8px;
        display: inline-block;
        animation: running-lean 0.8s infinite ease-in-out;
    }
    @keyframes running-lean {
        0%, 100% { transform: translateX(0) rotate(5deg) scale(1); }
        50% { transform: translateX(3px) rotate(15deg) scale(1.1); }
    }
</style>
<!-- FullCalendar & Leaflet CSS -->
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css' rel='stylesheet' />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1">
        {% if app.user %}
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <h1 class="h2 fw-bold mb-0 discovery-section-title">
                    {% include 'frontoffice/partials/_icon_people.html.twig' %}
                    Mes Événements
                </h1>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-info fw-bold" data-bs-toggle="modal" data-bs-target="#calendarModal">
                        <i class="bi bi-calendar3 me-2"></i>📅 Mon Calendrier
                    </button>
                </div>
            </div>

            {# Live Search and Sort for My Events #}
            <div class="d-flex flex-wrap justify-content-end align-items-center gap-3 mb-4">
                <div class="d-flex justify-content-end align-items-center gap-3 w-100 flex-wrap">
                    <!-- Sort by Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-tc-outline dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="mySortDropdownBtn">
                            <i class="bi bi-sort-down"></i>
                            <span id="myCurrentSortLabel">Date (Plus récent)</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item active js-my-sort-option" href="#" data-sort="date_desc">Date (Plus récent)</a></li>
                            <li><a class="dropdown-item js-my-sort-option" href="#" data-sort="date_asc">Date (Plus ancien)</a></li>
                            <li><a class="dropdown-item js-my-sort-option" href="#" data-sort="rating_desc">Mieux noté</a></li>
                            <li><a class="dropdown-item js-my-sort-option" href="#" data-sort="rating_asc">Moins bien noté</a></li>
                            <li><a class="dropdown-item js-my-sort-option" href="#" data-sort="name_asc">Nom (A-Z)</a></li>
                            <li><a class="dropdown-item js-my-sort-option" href="#" data-sort="name_desc">Nom (Z-A)</a></li>
                            <li><a class="dropdown-item js-my-sort-option" href="#" data-sort="status_open">Statut (Open first)</a></li>
                            <li><a class="dropdown-item js-my-sort-option" href="#" data-sort="status_closed">Statut (Closed first)</a></li>
                        </ul>
                    </div>

                    <!-- Search Input -->
                    <div class="position-relative">
                        <input type="text" id="my-event-search" class="form-control form-control-sm text-white ps-5" placeholder="Rechercher mes événements..." style="background-color: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); min-width: 250px; border-radius: 20px;">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-5" id="my-events-container">
                {% if myEvents is not empty %}
                    {% for e in myEvents %}
                    <div class="col-12 col-sm-6 col-lg-4 my-event-item"
                         data-name="{{ e.nomEvenement|lower }}"
                         data-date="{{ e.dateDebut.timestamp }}"
                         data-status="{{ e.status|lower }}"
                         data-rating="{{ e.averageRating }}"
                         data-id="{{ e.id }}">
                        <div class="discovery-card h-100 d-flex flex-column p-4 text-center" style="border: 2px solid #a855f7;">
                            {% if e.imageEvenement %}
                                <div class="event-image-container">
                                    <img src="{{ asset('uploads/events/' ~ e.imageEvenement) }}" alt="{{ e.nomEvenement }}" class="event-card-banner">
                                </div>
                            {% else %}
                                <div class="discovery-avatar mx-auto mb-3">
                                    {{ e.nomEvenement|slice(0, 2)|upper }}
                                </div>
                            {% endif %}
                            <h3 class="discovery-card-title mb-1">{{ e.nomEvenement }}</h3>
                            <div class="mb-3 d-flex justify-content-center">
                                <div class="d-flex align-items-center gap-1 px-3 py-1 rounded-pill" style="background-color: rgba(255,193,7,0.1); border: 1px solid rgba(255,193,7,0.3);" id="rating-display-my-{{ e.id }}">
                                    {% if e.reviewCount > 0 %}
                                        <span class="text-warning fw-bold" style="font-size: 0.95rem;">{{ e.averageRating|number_format(1) }}</span>
                                        <i class="bi bi-star-fill text-warning" style="font-size: 0.85rem; filter: drop-shadow(0 0 5px rgba(255, 193, 7, 0.8));"></i>
                                        <span class="text-white-50 ms-1" style="font-size: 0.8rem;">({{ e.reviewCount }} avis)</span>
                                    {% else %}
                                        <span class="text-white-50 fst-italic" style="font-size: 0.85rem;">Aucun avis</span>
                                    {% endif %}
                                </div>
                            </div>
                            <p class="discovery-card-subtitle mb-2"><span class="badge {{ e.status == 'open' ? 'status-open' : 'bg-secondary' }}">{{ e.status|upper }}</span> • {{ e.participations|length }} / {{ e.place.capaciteMax }}</p>
                            <div class="mb-2">
                                <i class="bi bi-geo-alt-fill place-label" style="font-size: 0.85rem;"></i> 
                                <span class="place-label" style="font-size: 0.85rem;">Lieu: {{ e.place.nomPlace }}</span>
                            </div>
                            <div class="text-white-50 small mb-3">
                                <div><span class="date-label">Début:</span> {{ e.dateDebut|date('d M Y, H:i') }}</div>
                                <div><span class="date-label">Fin:</span> {{ e.dateFin|date('d M Y, H:i') }}</div>
                            </div>
                            <div class="mt-auto d-flex justify-content-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#editModal{{ e.getId() }}">Modifier</button>
                                <form method="post" action="{{ path('app_front_event_delete', {'id': e.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ e.id) }}">
                                    <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                {% endif %}
            </div>
            <div id="my-events-no-results" class="col-12 d-none">
                <div class="p-5 rounded bg-black bg-opacity-25 border border-secondary border-opacity-10 text-center">
                    <p class="text-white-50 mb-0">Aucun événement ne correspond à votre recherche.</p>
                </div>
            </div>
            <hr class="mb-5" style="border-color: rgba(255,255,255,0.1);">
        {% endif %}

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="h2 fw-bold mb-0 discovery-section-title">
                {% include 'frontoffice/partials/_icon_people.html.twig' %}
                Tous les Événements
            </h1>
        </div>

        {# Live Search and Filter Section for All Events #}
        <div class="d-flex flex-wrap justify-content-end align-items-center gap-3 mb-4">
            <div class="d-flex justify-content-end align-items-center gap-3 w-100 flex-wrap">
                <!-- Sort by Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-tc-outline dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="allSortDropdownBtn">
                        <i class="bi bi-sort-down"></i>
                        <span id="allCurrentSortLabel">Date (Plus récent)</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item active js-all-sort-option" href="#" data-sort="date_desc">Date (Plus récent)</a></li>
                        <li><a class="dropdown-item js-all-sort-option" href="#" data-sort="date_asc">Date (Plus ancien)</a></li>
                        <li><a class="dropdown-item js-all-sort-option" href="#" data-sort="rating_desc">Mieux noté</a></li>
                        <li><a class="dropdown-item js-all-sort-option" href="#" data-sort="rating_asc">Moins bien noté</a></li>
                        <li><a class="dropdown-item js-all-sort-option" href="#" data-sort="name_asc">Nom (A-Z)</a></li>
                        <li><a class="dropdown-item js-all-sort-option" href="#" data-sort="name_desc">Nom (Z-A)</a></li>
                        <li><a class="dropdown-item js-all-sort-option" href="#" data-sort="status_open">Statut (Open first)</a></li>
                        <li><a class="dropdown-item js-all-sort-option" href="#" data-sort="status_closed">Statut (Closed first)</a></li>
                    </ul>
                </div>

                <!-- Filter by Type Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-tc-outline dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="typeFilterDropdownBtn">
                        <i class="bi bi-funnel"></i>
                        <span id="currentTypeLabel">Tous les types</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item active js-type-option" href="#" data-type="all">Tous les types</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item js-type-option" href="#" data-type="tournament">Tournament</a></li>
                        <li><a class="dropdown-item js-type-option" href="#" data-type="scrim">Scrim</a></li>
                        <li><a class="dropdown-item js-type-option" href="#" data-type="practice">Practice</a></li>
                        <li><a class="dropdown-item js-type-option" href="#" data-type="competition">Competition</a></li>
                    </ul>
                </div>

                <!-- Filter by Status Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-tc-outline dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="statusFilterDropdownBtn">
                        <i class="bi bi-check-circle"></i>
                        <span id="currentStatusLabel">Tous statuts</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item active js-status-option" href="#" data-status="all">Tous statuts</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item js-status-option" href="#" data-status="open">Open</a></li>
                        <li><a class="dropdown-item js-status-option" href="#" data-status="closed">Closed</a></li>
                        <li><a class="dropdown-item js-status-option" href="#" data-status="over">Over</a></li>
                    </ul>
                </div>

                <!-- Search Input -->
                <div class="position-relative">
                    <input type="text" id="all-event-search" class="form-control form-control-sm text-white ps-5" placeholder="Rechercher par nom..." style="background-color: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); min-width: 250px; border-radius: 20px;">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                </div>
            </div>
        </div>

        <style>
            #my-event-search::placeholder, #all-event-search::placeholder {
                color: white !important;
                opacity: 0.7;
            }
            .btn-tc-outline {
                color: #fff;
                border-color: rgba(255, 255, 255, 0.2);
                background-color: rgba(255, 255, 255, 0.05);
            }
            .btn-tc-outline:hover, .btn-tc-outline:focus {
                background-color: rgba(255, 255, 255, 0.1);
                color: #fff;
                border-color: rgba(255, 255, 255, 0.3);
            }
            .dropdown-menu-dark .dropdown-item.active {
                background-color: var(--tc-cyan, #0dcaf0);
                color: #000;
            }
        </style>

        <div class="row g-4" id="all-events-container">
            {% for e in events %}
                <div class="col-12 col-sm-6 col-lg-4 all-event-item"
                     data-name="{{ e.nomEvenement|lower }}"
                     data-date="{{ e.dateDebut.timestamp }}"
                     data-status="{{ e.status|lower }}"
                     data-type="{{ e.typeEvenement|lower }}"
                     data-rating="{{ e.averageRating }}"
                     data-id="{{ e.id }}">
                    <div class="discovery-card h-100 d-flex flex-column p-4 text-center">
                        {% if e.imageEvenement %}
                            <img src="{{ asset('uploads/events/' ~ e.imageEvenement) }}" alt="{{ e.nomEvenement }}" class="event-card-banner">
                        {% else %}
                            <div class="discovery-avatar mx-auto mb-3">
                                {{ e.nomEvenement|slice(0, 2)|upper }}
                            </div>
                        {% endif %}
                        <h3 class="discovery-card-title mb-1">{{ e.nomEvenement }}</h3>
                        <div class="mb-3 d-flex justify-content-center">
                            <div class="d-flex align-items-center gap-1 px-3 py-1 rounded-pill" style="background-color: rgba(255,193,7,0.1); border: 1px solid rgba(255,193,7,0.3);" id="rating-display-all-{{ e.id }}">
                                {% if e.reviewCount > 0 %}
                                    <span class="text-warning fw-bold" style="font-size: 0.95rem;">{{ e.averageRating|number_format(1) }}</span>
                                    <i class="bi bi-star-fill text-warning" style="font-size: 0.85rem; filter: drop-shadow(0 0 5px rgba(255, 193, 7, 0.8));"></i>
                                    <span class="text-white-50 ms-1" style="font-size: 0.8rem;">({{ e.reviewCount }} avis)</span>
                                {% else %}
                                    <span class="text-white-50 fst-italic" style="font-size: 0.85rem;">Aucun avis</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="text-white-50 small mb-1">
                            <span class="badge {{ e.status == 'open' ? 'status-open' : (e.status == 'over' ? 'bg-secondary' : 'bg-danger') }}">{{ e.status|upper }}</span>
                            <span class="ms-2 fw-bold text-white">{{ e.participations|length }}/{{ e.place.capaciteMax }}</span>
                        </div>
                        <div class="mb-2">
                            <i class="bi bi-geo-alt-fill place-label" style="font-size: 0.85rem;"></i> 
                            <span class="place-label" style="font-size: 0.85rem;">Lieu: {{ e.place.nomPlace }}</span>
                        </div>

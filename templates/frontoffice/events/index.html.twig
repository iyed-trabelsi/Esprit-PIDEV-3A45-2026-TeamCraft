// --- LIVE SEARCH, FILTER & SORT LOGIC ---
document.addEventListener('DOMContentLoaded', function() {
    
    // --- Helper for Sorting ---
    function sortItemsLogic(items, direction) {
        return items.sort((a, b) => {
            const dataA = {
                date: parseInt(a.getAttribute('data-date') || '0'),
                id: parseInt(a.getAttribute('data-id') || '0'),
                name: (a.getAttribute('data-name') || '').toLowerCase(),
                status: (a.getAttribute('data-status') || '').toLowerCase(),
                rating: parseFloat(a.getAttribute('data-rating') || '0.0'),
            };
            const dataB = {
                date: parseInt(b.getAttribute('data-date') || '0'),
                id: parseInt(b.getAttribute('data-id') || '0'),
                name: (b.getAttribute('data-name') || '').toLowerCase(),
                status: (b.getAttribute('data-status') || '').toLowerCase(),
                rating: parseFloat(b.getAttribute('data-rating') || '0.0'),
            };
            
            if (direction === 'name_asc' || direction === 'name_desc') {
                const comparison = dataA.name.localeCompare(dataB.name);
                return direction === 'name_asc' ? comparison : -comparison;
            }
            if (direction === 'rating_asc') {
                const cmp = dataA.rating - dataB.rating;
                return cmp !== 0 ? cmp : (dataB.date - dataA.date); // fallback to date desc
            }
            if (direction === 'rating_desc') {
                const cmp = dataB.rating - dataA.rating;
                return cmp !== 0 ? cmp : (dataB.date - dataA.date); // fallback to date desc
            }
            if (direction === 'status_open' || direction === 'status_closed') {
                const targetStatus = direction === 'status_open' ? 'open' : 'closed';
                const aIsTarget = dataA.status === targetStatus ? 1 : 0;
                const bIsTarget = dataB.status === targetStatus ? 1 : 0;
                if (aIsTarget !== bIsTarget) {
                    return bIsTarget - aIsTarget; // 1 comes before 0
                }
                // Fallback to date
                return dataB.date - dataA.date;
            }
            if (direction === 'date_asc') {
                return dataA.date - dataB.date;
            }
            // default date_desc
            return dataB.date - dataA.date;
        });
    }

    // --- My Events Logic ---
    const myEventsContainer = document.getElementById('my-events-container');
    const myEventsNoResults = document.getElementById('my-events-no-results');
    const mySearchInput = document.getElementById('my-event-search');
    const mySortOptions = document.querySelectorAll('.js-my-sort-option');
    const myCurrentSortLabel = document.getElementById('myCurrentSortLabel');
    
    if (myEventsContainer) {
        let myItems = Array.from(myEventsContainer.querySelectorAll('.my-event-item'));
        let myCurrentFilter = '';
        let myCurrentSortDir = 'date_desc';

        function applyMyFilters() {
            let visibleCount = 0;
            let visibleItems = [];

            myItems.forEach(item => {
                const name = (item.getAttribute('data-name') || '').toLowerCase();
                const matchesSearch = !myCurrentFilter || name.includes(myCurrentFilter);
                
                if (matchesSearch) {
                    item.style.display = 'block';
                    visibleItems.push(item);
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            if (visibleCount === 0) {
                myEventsNoResults.classList.remove('d-none');
            } else {
                myEventsNoResults.classList.add('d-none');
                
                // Sort visible items
                const sortedItems = sortItemsLogic(visibleItems, myCurrentSortDir);
                sortedItems.forEach(item => myEventsContainer.appendChild(item));
            }
        }

        if (mySearchInput) {
            mySearchInput.addEventListener('input', (e) => {
                myCurrentFilter = e.target.value.toLowerCase().trim();
                applyMyFilters();
            });
        }

        mySortOptions.forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                myCurrentSortDir = this.getAttribute('data-sort');
                
                mySortOptions.forEach(o => o.classList.remove('active'));
                this.classList.add('active');
                if (myCurrentSortLabel) myCurrentSortLabel.textContent = this.textContent;

                applyMyFilters();
            });
        });
        
        // Initial sort
        applyMyFilters();
    }

    // --- All Events Logic ---
    const allEventsContainer = document.getElementById('all-events-container');
    const allEventsNoResults = document.getElementById('all-events-no-results');
    const allSearchInput = document.getElementById('all-event-search');
    
    const allSortOptions = document.querySelectorAll('.js-all-sort-option');
    const allCurrentSortLabel = document.getElementById('allCurrentSortLabel');
    
    const typeOptions = document.querySelectorAll('.js-type-option');
    const currentTypeLabel = document.getElementById('currentTypeLabel');
    
    const statusOptions = document.querySelectorAll('.js-status-option');
    const currentStatusLabel = document.getElementById('currentStatusLabel');

    if (allEventsContainer) {
        let allItems = Array.from(allEventsContainer.querySelectorAll('.all-event-item'));
        let allCurrentFilter = '';
        let allCurrentType = 'all';
        let allCurrentStatus = 'all';
        let allCurrentSortDir = 'date_desc';

        function applyAllFilters() {
            let visibleCount = 0;
            let visibleItems = [];

            allItems.forEach(item => {
                const name = (item.getAttribute('data-name') || '').toLowerCase();
                const type = (item.getAttribute('data-type') || '').toLowerCase();
                const status = (item.getAttribute('data-status') || '').toLowerCase();
                
                const matchesSearch = !allCurrentFilter || name.includes(allCurrentFilter);
                const matchesType = allCurrentType === 'all' || type === allCurrentType;
                const matchesStatus = allCurrentStatus === 'all' || status === allCurrentStatus;
                
                if (matchesSearch && matchesType && matchesStatus) {
                    item.style.display = 'block';
                    visibleItems.push(item);
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            if (visibleCount === 0) {
                allEventsNoResults.classList.remove('d-none');
            } else {
                allEventsNoResults.classList.add('d-none');
                
                // Sort visible items
                const sortedItems = sortItemsLogic(visibleItems, allCurrentSortDir);
                sortedItems.forEach(item => allEventsContainer.appendChild(item));
            }
        }

        if (allSearchInput) {
            allSearchInput.addEventListener('input', (e) => {
                allCurrentFilter = e.target.value.toLowerCase().trim();
                applyAllFilters();
            });
        }

        allSortOptions.forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                allCurrentSortDir = this.getAttribute('data-sort');
                
                allSortOptions.forEach(o => o.classList.remove('active'));
                this.classList.add('active');
                if (allCurrentSortLabel) allCurrentSortLabel.textContent = this.textContent;

                applyAllFilters();
            });
        });

        typeOptions.forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                allCurrentType = this.getAttribute('data-type');
                
                typeOptions.forEach(o => o.classList.remove('active'));
                this.classList.add('active');
                if (currentTypeLabel) currentTypeLabel.textContent = this.textContent;

                applyAllFilters();
            });
        });

        statusOptions.forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                allCurrentStatus = this.getAttribute('data-status');
                
                statusOptions.forEach(o => o.classList.remove('active'));
                this.classList.add('active');
                if (currentStatusLabel) currentStatusLabel.textContent = this.textContent;

                applyAllFilters();
            });
        });
        
        // Initial sort
        applyAllFilters();
    }

    // --- Review Modal Logic ---
    const reviewModalElement = document.getElementById('reviewModal');
    if (reviewModalElement) {
        const modalEventName = document.getElementById('reviewModalEventName');
        const eventIdInput = document.getElementById('review-event-id');
        const reviewsFeed = document.getElementById('reviews-feed');
        const modalReviewCount = document.getElementById('modal-review-count');
        
        const rater = document.getElementById('star-rater');
        const raterFill = document.getElementById('star-rater-fill');
        const ratingDisplay = document.getElementById('review-rating-display');
        const ratingInput = document.getElementById('review-rating-input');
        const messageInput = document.getElementById('review-message-input');
        const submitBtn = document.getElementById('submitReviewBtn');
        const formAlert = document.getElementById('review-form-alert');
        
        let isRatingLocked = false;
        let currentEventId = null;
        
        // Open Modal handler
        document.querySelectorAll('.open-review-modal').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const id = btn.getAttribute('data-event-id');
                const name = btn.getAttribute('data-event-name');
                currentEventId = id;
                
                modalEventName.textContent = name;
                eventIdInput.value = id;
                
                // Reset form
                isRatingLocked = false;
                raterFill.style.width = '0%';
                ratingDisplay.textContent = '0.0';
                ratingInput.value = '0';
                messageInput.value = '';
                formAlert.classList.add('d-none');
                submitBtn.disabled = false;
                
                // Load existing reviews
                loadReviews(id);
            });
        });

        // Interactive Stars
        rater.addEventListener('mousemove', (e) => {
            if (isRatingLocked) return;
            const rect = rater.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const percentage = Math.max(0, Math.min(100, (x / rect.width) * 100)); // 0 to 100
            
            // Map percentage to 5.0 with 0.2 precision
            const rawScore = (percentage / 100) * 5;
            let precisionScore = (Math.round(rawScore * 5) / 5);
            if (precisionScore < 0.2) precisionScore = 0.2; // Min rating
            if (precisionScore > 5.0) precisionScore = 5.0; // Max rating
            
            raterFill.style.width = `${(precisionScore / 5) * 100}%`;
            ratingDisplay.textContent = precisionScore.toFixed(1);
        });

        rater.addEventListener('mouseleave', () => {
            if (!isRatingLocked) {
                raterFill.style.width = '0%';
                ratingDisplay.textContent = '0.0';
            }
        });

        rater.addEventListener('click', (e) => {
            const rect = rater.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const percentage = Math.max(0, Math.min(100, (x / rect.width) * 100));
            
            const rawScore = (percentage / 100) * 5;
            let precisionScore = (Math.round(rawScore * 5) / 5);
            if (precisionScore < 0.2) precisionScore = 0.2;
            if (precisionScore > 5.0) precisionScore = 5.0;
            
            ratingInput.value = precisionScore.toFixed(1);
            raterFill.style.width = `${(precisionScore / 5) * 100}%`;
            ratingDisplay.textContent = precisionScore.toFixed(1);
            isRatingLocked = true;
            
            // Quick flash
            rater.style.transform = 'scale(0.95)';
            setTimeout(() => rater.style.transform = 'scale(1)', 100);
            formAlert.classList.add('d-none');
        });

        // Fetch Reviews
        function loadReviews(eventId) {
            reviewsFeed.innerHTML = '<div class="text-center text-secondary small py-3"><div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>Chargement des avis...</div>';
            
            fetch(`/events/${eventId}/reviews`)
                .then(res => res.json())
                .then(data => {
                    modalReviewCount.textContent = data.reviewCount;
                    renderReviews(data.reviews);
                })
                .catch(err => {
                    console.error(err);
                    reviewsFeed.innerHTML = '<div class="text-center text-danger small py-3">Erreur lors du chargement des avis.</div>';
                });
        }
        
        function renderReviews(reviews) {
            if (reviews.length === 0) {
                reviewsFeed.innerHTML = '<div class="text-center text-secondary small py-4 bg-black bg-opacity-25 rounded border border-secondary border-opacity-10">Aucun avis pour le moment.<br>Soyez le premier à partager votre expérience !</div>';
                return;
            }
            
            let html = '';
            reviews.forEach(r => {
                const percentage = (r.rating / 5) * 100;
                
                const date = new Date(r.createdAt);
                const now = new Date();
                const diffTime = Math.abs(now - date);
                const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
                const diffStr = diffDays > 0 ? `Il y a ${diffDays} jour(s)` : "Aujourd'hui";
                
                const avatarStr = r.userAvatar 
                    ? `<img src="/uploads/profiles/${r.userAvatar}" class="rounded-circle" width="32" height="32" style="object-fit: cover;">`
                    : `<div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white" style="width: 32px; height: 32px; font-weight: bold;">${r.username.charAt(0).toUpperCase()}</div>`;
                
                html += `
                    <div class="p-3 rounded border border-secondary border-opacity-25" style="background-color: rgba(255,255,255,0.03);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                ${avatarStr}
                                <div>
                                    <div class="fw-bold fs-6 lh-1">${r.username}</div>
                                    <div class="text-secondary" style="font-size: 0.75rem;">${diffStr}</div>
                                </div>
                            </div>
                            <div class="position-relative" style="width: 80px; height: 16px;">
                                <div class="position-absolute top-0 start-0 d-flex gap-1 text-secondary" style="font-size: 0.8rem;">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                </div>
                                <div class="position-absolute top-0 start-0 h-100 overflow-hidden text-warning" style="font-size: 0.8rem; width: ${percentage}%;">
                                    <div class="d-flex gap-1" style="width: 80px;">
                                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        ${r.message ? `<p class="mb-0 text-white-50 fs-6" style="word-wrap: break-word;">${r.message}</p>` : ''}
                    </div>
                `;
            });
            reviewsFeed.innerHTML = html;
        }

        // Submit Review
        submitBtn.addEventListener('click', () => {
            const rating = parseFloat(ratingInput.value);
            const message = messageInput.value.trim();
            
            if (rating < 0.2 || rating > 5.0) {
                showAlert('danger', 'Veuillez sélectionner une note en cliquant sur les étoiles.');
                return;
            }
            
            submitBtn.disabled = true;
            submitBtn.querySelector('.submit-text').classList.add('d-none');
            submitBtn.querySelector('.spinner-border').classList.remove('d-none');
            
            fetch(`/events/${currentEventId}/review/submit`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ rating, message })
            })
            .then(res => res.json())
            .then(data => {
                submitBtn.disabled = false;
                submitBtn.querySelector('.submit-text').classList.remove('d-none');
                submitBtn.querySelector('.spinner-border').classList.add('d-none');
                
                if (data.success) {
                    showAlert('success', data.message);
                    
                    // Reload reviews instantly
                    loadReviews(currentEventId);
                    
                    // Update main cards averages live
                    updateEventCardAverages(currentEventId, data.averageRating, data.reviewCount);
                    
                    // Reset inputs
                    isRatingLocked = false;
                    raterFill.style.width = '0%';
                    ratingDisplay.textContent = '0.0';
                    ratingInput.value = '0';
                    messageInput.value = '';
                } else {
                    showAlert('danger', data.error || 'Erreur lors de la soumission.');
                }
            })
            .catch(err => {
                submitBtn.disabled = false;
                submitBtn.querySelector('.submit-text').classList.remove('d-none');
                submitBtn.querySelector('.spinner-border').classList.add('d-none');
                showAlert('danger', 'Erreur réseau.');
                console.error(err);
            });
        });

        function showAlert(type, msg) {
            formAlert.className = `alert alert-${type} mt-3 p-2 small text-center mb-0`;
            formAlert.textContent = msg;
            formAlert.classList.remove('d-none');
        }
        
        function updateEventCardAverages(id, avg, count) {
            const formattedAvg = parseFloat(avg).toFixed(1);
            const htmlContent = count > 0 
                ? `<span class="text-warning fw-bold" style="font-size: 0.95rem;">${formattedAvg}</span>
                   <i class="bi bi-star-fill text-warning" style="font-size: 0.85rem; filter: drop-shadow(0 0 5px rgba(255, 193, 7, 0.8));"></i>
                   <span class="text-white-50 ms-1" style="font-size: 0.8rem;">(${count} avis)</span>`
                : `<span class="text-white-50 fst-italic" style="font-size: 0.85rem;">Aucun avis</span>`;
            
            // Update data attributes so sorting still works dynamically
            document.querySelectorAll(`.my-event-item[data-id="${id}"]`).forEach(el => el.setAttribute('data-rating', avg));
            document.querySelectorAll(`.all-event-item[data-id="${id}"]`).forEach(el => el.setAttribute('data-rating', avg));
            
            const myCard = document.getElementById(`rating-display-my-${id}`);
            if (myCard) myCard.innerHTML = htmlContent;
            
            const allCard = document.getElementById(`rating-display-all-${id}`);
            if (allCard) allCard.innerHTML = htmlContent;
        }
    }
});
</script>
{% endblock %}

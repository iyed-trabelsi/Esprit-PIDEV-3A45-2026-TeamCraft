{% extends 'frontoffice/base.html.twig' %}

{% block title %}Événements - TEAMCRAFT{% endblock %}

{% block stylesheets %}
<style>
    /* Scoped styles for event images */
    .event-card-banner {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 1.25rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: block;
    }
    .discovery-avatar {
        overflow: hidden !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    .date-label {
        color: var(--tc-cyan);
        font-weight: 700;
    }
    .status-open {
        background-color: var(--tc-neon-green) !important;
        color: #fff !important;
    }
    .place-label {
        color: #ff4444 !important; /* Vivid Red */
        font-weight: 700 !important;
        opacity: 1 !important;
    }
    /* --- Premium Calendar UI --- */
    .calendar-modal-content {
        background: rgba(13, 13, 27, 0.96) !important;
        backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    .fc { 
        color: #e2e8f0 !important; 
        font-family: inherit;
    }
    /* Hierarchy: Muted numbers */
    .fc-daygrid-day-number {
        color: #94a3b8 !important; /* Soft Slate Gray */
        font-weight: 500 !important;
        font-size: 0.85rem !important;
        padding: 8px !important;
        text-decoration: none !important;
    }
    /* Grid feel */
    .fc-theme-standard td, .fc-theme-standard th {
        border: 1px solid rgba(255, 255, 255, 0.04) !important;
    }
    .fc-scrollgrid { border: none !important; }

    /* Day Card Feel */
    .fc-daygrid-day {
        background: rgba(255, 255, 255, 0.01);
        transition: background 0.2s ease;
    }
    .fc-daygrid-day:hover {
        background: rgba(6, 182, 212, 0.04) !important;
    }
    /* Weekend Shading */
    .fc-day-sun, .fc-day-sat {
        background: rgba(0, 0, 0, 0.15) !important;
    }
    /* Today Highlight */
    .fc-day-today {
        background: rgba(6, 182, 212, 0.06) !important;
        outline: 1px solid rgba(6, 182, 212, 0.3) !important;
        outline-offset: -1px;
    }
    .fc-day-today .fc-daygrid-day-number {
        color: var(--tc-cyan) !important;
        font-weight: 800 !important;
    }

    /* Header Design */
    .fc-toolbar-title {
        font-size: 1.6rem !important;
        letter-spacing: 2px !important;
        color: var(--tc-cyan) !important;
        text-shadow: 0 0 15px rgba(6, 182, 212, 0.3);
        font-weight: 800 !important;
        text-transform: uppercase;
    }
    .fc-button-primary {
        background: rgba(255,255,255,0.05) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        text-transform: uppercase;
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 1px;
        padding: 8px 16px !important;
        border-radius: 8px !important;
        transition: all 0.2s ease !important;
    }
    .fc-button-primary:hover {
        background: var(--tc-cyan) !important;
        color: #000 !important;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    }
    .fc-button-active {
        background: var(--tc-cyan) !important;
        color: #000 !important;
    }

    /* Event Tags (The Major Upgrade) */
    .fc-event {
        border-radius: 6px !important;
        padding: 4px 8px !important;
        margin: 2px 4px !important;
        border: none !important;
        font-size: 0.75rem !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
        animation: eventFadeIn 0.4s ease-out backwards;
        cursor: pointer !important;
        transition: transform 0.2s ease, filter 0.2s ease !important;
    }
    .fc-event:hover {
        transform: translateY(-1px) scale(1.02);
        background: rgba(255, 255, 255, 0.12) !important;
        box-shadow: 0 8px 20px -5px rgba(0, 0, 0, 0.5);
    }
    /* List View Fixes (Prevent Whiteout) */
    .fc-list-event:hover td {
        background: rgba(6, 182, 212, 0.1) !important;
    }
    .fc-list-day-side-text, .fc-list-day-text {
        color: var(--tc-cyan) !important;
        font-weight: 800 !important;
    }
    .fc-list-day-cushion {
        background: rgba(255, 255, 255, 0.05) !important;
    }
    .fc-list-event-title a {
        color: #e2e8f0 !important;
        text-decoration: none !important;
    }
    .fc-list-table {
        border-color: rgba(255, 255, 255, 0.05) !important;
    }
    .fc-list-event {
        cursor: pointer !important;
    }
    @keyframes eventFadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* --- Ultra-Intense Neon Glow Squares --- */
    .fc-event-square {
        width: 9px;
        height: 9px;
        border-radius: 2px;
        margin-right: 10px;
        display: inline-block;
        flex-shrink: 0;
        position: relative;
    }
    .square-open { 
        background: #00ff88; /* Even brighter green */
        box-shadow: 0 0 10px #00ff88, 0 0 20px rgba(0, 255, 136, 0.6), 0 0 30px rgba(0, 255, 136, 0.3) !important; 
        animation: pulse-green 1s infinite cubic-bezier(0.4, 0, 0.2, 1); 
    }
    .square-closed { 
        background: #ff0044; /* Even brighter red */
        box-shadow: 0 0 10px #ff0044, 0 0 20px rgba(255, 0, 68, 0.6), 0 0 30px rgba(255, 0, 68, 0.3) !important; 
        animation: pulse-red 1s infinite cubic-bezier(0.4, 0, 0.2, 1); 
    }
    .square-over { 
        background: #94a3b8; 
        box-shadow: 0 0 6px #94a3b8, 0 0 12px rgba(148, 163, 184, 0.4) !important; 
        animation: pulse-grey 2.5s infinite ease-in-out; 
    }

    @keyframes pulse-green {
        0% { transform: scale(1) rotate(0deg); box-shadow: 0 0 10px #00ff88, 0 0 15px rgba(0, 255, 136, 0.4); }
        50% { transform: scale(1.6) rotate(15deg); box-shadow: 0 0 20px #00ff88, 0 0 40px rgba(0, 255, 136, 0.9), 0 0 60px rgba(0, 255, 136, 0.5); }
        100% { transform: scale(1) rotate(0deg); box-shadow: 0 0 10px #00ff88, 0 0 15px rgba(0, 255, 136, 0.4); }
    }
    @keyframes pulse-red {
        0% { transform: scale(1) rotate(0deg); box-shadow: 0 0 10px #ff0044, 0 0 15px rgba(255, 0, 68, 0.4); }
        50% { transform: scale(1.6) rotate(-15deg); box-shadow: 0 0 20px #ff0044, 0 0 40px rgba(255, 0, 68, 0.9), 0 0 60px rgba(255, 0, 68, 0.5); }
        100% { transform: scale(1) rotate(0deg); box-shadow: 0 0 10px #ff0044, 0 0 15px rgba(255, 0, 68, 0.4); }
    }
    @keyframes pulse-grey {
        0% { opacity: 0.6; transform: scale(1); box-shadow: 0 0 5px #94a3b8; }
        50% { opacity: 1; transform: scale(1.3); box-shadow: 0 0 15px #94a3b8, 0 0 30px rgba(148, 163, 184, 0.5); }
        100% { opacity: 0.6; transform: scale(1); box-shadow: 0 0 5px #94a3b8; }
    }

    /* Premium Tag (Subtle Glass) */
    .fc-event-tag {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        padding: 4px 10px !important;
        border-radius: 8px !important;
        width: 100%;
    }

    /* Participation Life (Cyan Neon Glow) */
    .event-participating {
        border: 1px solid rgba(6, 182, 212, 0.5) !important;
        background: rgba(6, 182, 212, 0.08) !important;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.2) !important;
    }
    .fc-event-runner {
        font-size: 1.1rem;
        margin-left: 8px;
        display: inline-block;
        animation: running-lean 0.8s infinite ease-in-out;
    }
    @keyframes running-lean {
        0%, 100% { transform: translateX(0) rotate(5deg) scale(1); }
        50% { transform: translateX(3px) rotate(15deg) scale(1.1); }
    }
</style>
<!-- FullCalendar & Leaflet CSS -->
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css' rel='stylesheet' />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1">
        {% if app.user %}
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <h1 class="h2 fw-bold mb-0 discovery-section-title">
                    {% include 'frontoffice/partials/_icon_people.html.twig' %}
                    Mes Événements
                </h1>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-success fw-bold" data-bs-toggle="modal" data-bs-target="#addPlaceModal">
                        <i class="bi bi-geo-alt me-2"></i>📍 Ajouter un Lieu
                    </button>
                    <button type="button" class="btn btn-outline-info fw-bold" data-bs-toggle="modal" data-bs-target="#calendarModal">
                        <i class="bi bi-calendar3 me-2"></i>📅 Mon Calendrier
                    </button>
                </div>
            </div>

            {# Search and Sort for My Events #}
            <div class="card bg-dark border-0 shadow mb-4" style="background-color: #16161a !important;">
                <div class="card-body p-3">
                    <form method="GET" action="{{ path('app_events') }}" class="row g-3">
                        <div class="col-12 col-md-8">
                            <input type="text" name="my_search" class="form-control bg-dark text-white border-secondary border-opacity-25" placeholder="🔍 Rechercher dans mes événements..." value="{{ mySearch }}">
                        </div>
                        <div class="col-12 col-md-3">
                            <select name="my_sort" class="form-select bg-dark text-white border-secondary border-opacity-25">
                                <option value="">Trier par...</option>
                                <option value="date_desc" {% if mySort == 'date_desc' %}selected{% endif %}>Date (Plus récent)</option>
                                <option value="date_asc" {% if mySort == 'date_asc' %}selected{% endif %}>Date (Plus ancien)</option>
                                <option value="name_asc" {% if mySort == 'name_asc' %}selected{% endif %}>Nom (A-Z)</option>
                                <option value="name_desc" {% if mySort == 'name_desc' %}selected{% endif %}>Nom (Z-A)</option>
                                <option value="status_open" {% if mySort == 'status_open' %}selected{% endif %}>Statut (Open first)</option>
                                <option value="status_closed" {% if mySort == 'status_closed' %}selected{% endif %}>Statut (Closed first)</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-1">
                            <button type="submit" class="btn btn-primary w-100">OK</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="row g-4 mb-5">
                {% if myEvents is not empty %}
                    {% for e in myEvents %}
                    <div class="col-12 col-sm-6 col-lg-4">
                        <div class="discovery-card h-100 d-flex flex-column p-4 text-center" style="border: 2px solid #a855f7;">
                            {% if e.imageEvenement %}
                                <img src="{{ asset('uploads/events/' ~ e.imageEvenement) }}" alt="{{ e.nomEvenement }}" class="event-card-banner">
                            {% else %}
                                <div class="discovery-avatar mx-auto mb-3">
                                    {{ e.nomEvenement|slice(0, 2)|upper }}
                                </div>
                            {% endif %}
                            <h3 class="discovery-card-title mb-1">{{ e.nomEvenement }}</h3>
                            <p class="discovery-card-subtitle mb-2"><span class="badge {{ e.status == 'open' ? 'status-open' : 'bg-secondary' }}">{{ e.status|upper }}</span> • {{ e.participations|length }} / {{ e.place.capaciteMax }}</p>
                            <div class="mb-2">
                                <i class="bi bi-geo-alt-fill place-label" style="font-size: 0.85rem;"></i> 
                                <span class="place-label" style="font-size: 0.85rem;">Lieu: {{ e.place.nomPlace }}</span>
                            </div>
                            <div class="text-white-50 small mb-3">
                                <div><span class="date-label">Début:</span> {{ e.dateDebut|date('d M Y, H:i') }}</div>
                                <div><span class="date-label">Fin:</span> {{ e.dateFin|date('d M Y, H:i') }}</div>
                            </div>
                            <div class="mt-auto d-flex justify-content-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#editModal{{ e.getId() }}">Modifier</button>
                                <form method="post" action="{{ path('app_front_event_delete', {'id': e.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ e.id) }}">
                                    <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                {% else %}
                    <div class="col-12">
                        <div class="p-5 rounded bg-black bg-opacity-25 border border-secondary border-opacity-10 text-center">
                            <p class="text-white-50 mb-0">
                                {% if mySearch %}
                                    Aucun événement trouvé pour "{{ mySearch }}".
                                {% else %}
                                    Vous n'avez créé aucun événement.
                                {% endif %}
                            </p>
                        </div>
                    </div>
                {% endif %}
            </div>
            <hr class="mb-5" style="border-color: rgba(255,255,255,0.1);">
        {% endif %}

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="h2 fw-bold mb-0 discovery-section-title">
                {% include 'frontoffice/partials/_icon_people.html.twig' %}
                Tous les Événements
            </h1>
            <a href="#" class="discovery-view-all">VOIR TOUS LES ÉVÉNEMENTS →</a>
        </div>

        {# Search and Filter Section #}
        <div class="card bg-dark border-0 shadow mb-4" style="background-color: #16161a !important;">
            <div class="card-body p-3">
                <form method="GET" action="{{ path('app_events') }}" class="row g-3">
                    <div class="col-12 col-md-4">
                        <input type="text" name="search" class="form-control bg-dark text-white border-secondary border-opacity-25" placeholder="🔍 Rechercher par nom..." value="{{ search }}">
                    </div>
                    <div class="col-12 col-md-2">
                        <select name="type" class="form-select bg-dark text-white border-secondary border-opacity-25">
                            <option value="">Tous les types</option>
                            <option value="Tournament" {% if filterType == 'Tournament' %}selected{% endif %}>Tournament</option>
                            <option value="Scrim" {% if filterType == 'Scrim' %}selected{% endif %}>Scrim</option>
                            <option value="Practice" {% if filterType == 'Practice' %}selected{% endif %}>Practice</option>
                            <option value="Competition" {% if filterType == 'Competition' %}selected{% endif %}>Competition</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <select name="status" class="form-select bg-dark text-white border-secondary border-opacity-25">
                            <option value="">Tous statuts</option>
                            <option value="open" {% if filterStatus == 'open' %}selected{% endif %}>Open</option>
                            <option value="closed" {% if filterStatus == 'closed' %}selected{% endif %}>Closed</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <select name="sort" class="form-select bg-dark text-white border-secondary border-opacity-25">
                            <option value="">Trier par...</option>
                            <option value="date_desc" {% if sort == 'date_desc' %}selected{% endif %}>Date (Plus récent)</option>
                            <option value="date_asc" {% if sort == 'date_asc' %}selected{% endif %}>Date (Plus ancien)</option>
                            <option value="name_asc" {% if sort == 'name_asc' %}selected{% endif %}>Nom (A-Z)</option>
                            <option value="name_desc" {% if sort == 'name_desc' %}selected{% endif %}>Nom (Z-A)</option>
                            <option value="status_open" {% if sort == 'status_open' %}selected{% endif %}>Statut (Open first)</option>
                            <option value="status_closed" {% if sort == 'status_closed' %}selected{% endif %}>Statut (Closed first)</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-1">
                        <button type="submit" class="btn btn-primary w-100">OK</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-4">
            {% for e in events %}
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="discovery-card h-100 d-flex flex-column p-4 text-center">
                        {% if e.imageEvenement %}
                            <img src="{{ asset('uploads/events/' ~ e.imageEvenement) }}" alt="{{ e.nomEvenement }}" class="event-card-banner">
                        {% else %}
                            <div class="discovery-avatar mx-auto mb-3">
                                {{ e.nomEvenement|slice(0, 2)|upper }}
                            </div>
                        {% endif %}
                        <h3 class="discovery-card-title mb-1">{{ e.nomEvenement }}</h3>
                        <div class="text-white-50 small mb-1">
                            <span class="badge {{ e.status == 'open' ? 'status-open' : (e.status == 'over' ? 'bg-secondary' : 'bg-danger') }}">{{ e.status|upper }}</span>
                            <span class="ms-2 fw-bold text-white">{{ e.participations|length }}/{{ e.place.capaciteMax }}</span>
                        </div>
                        <div class="mb-2">
                            <i class="bi bi-geo-alt-fill place-label" style="font-size: 0.85rem;"></i> 
                            <span class="place-label" style="font-size: 0.85rem;">Lieu: {{ e.place.nomPlace }}</span>
                        </div>
                        <div class="text-white-50 small mb-3">
                            <div><span class="date-label">Début:</span> {{ e.dateDebut|date('d M Y, H:i') }}</div>
                            <div><span class="date-label">Fin:</span> {{ e.dateFin|date('d M Y, H:i') }}</div>
                        </div>
                        
                        {% set isParticipating = false %}
                        {% if app.user %}
                            {% for p in e.participations %}
                                {% if p.user == app.user %}
                                    {% set isParticipating = true %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}

                        {% if isParticipating %}
                            {% if e.status == 'over' %}
                                <button class="btn btn-secondary mt-auto text-decoration-none text-center disabled w-100 fw-bold" disabled>Terminé</button>
                            {% else %}
                                <form method="post" action="{{ path('app_event_cancel_participation', {'id': e.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler votre participation à cet événement ?');" class="mt-auto">
                                    <button type="submit" class="btn btn-outline-danger w-100 fw-bold">Annuler ma participation</button>
                                </form>
                            {% endif %}
                        {% elseif e.status == 'closed' or e.participations|length >= e.place.capaciteMax %}
                            <button class="btn btn-secondary mt-auto text-decoration-none text-center disabled w-100 fw-bold" disabled>Complet</button>
                        {% elseif e.status == 'over' %}
                            <button class="btn btn-secondary mt-auto text-decoration-none text-center disabled w-100 fw-bold" disabled>Terminé</button>
                        {% else %}
                            <a href="{{ path('app_event_participate', {id: e.getId()}) }}" class="btn btn-recruit mt-auto text-decoration-none text-center w-100 fw-bold">Participer</a>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="p-5 rounded bg-black bg-opacity-25 border border-secondary border-opacity-10 text-center">
                        <p class="text-white-50 mb-0">
                            {% if search or filterType or filterStatus %}
                                Aucun événement ne correspond à vos critères de recherche.
                            {% else %}
                                Aucun événement disponible pour le moment.
                            {% endif %}
                        </p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    {# Edit Modals for My Events #}
    {% if app.user and myEvents is not empty %}
        {% for e in myEvents %}
            <div class="modal fade" id="editModal{{ e.getId() }}" tabindex="-1" aria-labelledby="editModalLabel{{ e.getId() }}" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content" style="background: var(--tc-bg-card, #1a1a2e); color: var(--tc-text, #fff);">
                        <div class="modal-header" style="border-color: rgba(255,255,255,0.1);">
                            <h5 class="modal-title" id="editModalLabel{{ e.getId() }}">Modifier l'événement</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            {% if forms[e.getId()] is defined %}
                                {{ form_start(forms[e.getId()], { attr: { novalidate: 'novalidate', enctype: 'multipart/form-data' } }) }}
                                    <div class="mb-3">
                                        {{ form_label(forms[e.getId()].nomEvenement, null, {'label_attr': {'class': 'text-white'}}) }}
                                        {{ form_widget(forms[e.getId()].nomEvenement, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
                                        <div class="text-danger small mt-1">{{ form_errors(forms[e.getId()].nomEvenement) }}</div>
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(forms[e.getId()].typeEvenement, null, {'label_attr': {'class': 'text-white'}}) }}
                                        {{ form_widget(forms[e.getId()].typeEvenement, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
                                        <div class="text-danger small mt-1">{{ form_errors(forms[e.getId()].typeEvenement) }}</div>
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(forms[e.getId()].dateDebut, null, {'label_attr': {'class': 'text-white'}}) }}
                                        {{ form_widget(forms[e.getId()].dateDebut, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
                                        <div class="text-danger small mt-1">{{ form_errors(forms[e.getId()].dateDebut) }}</div>
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(forms[e.getId()].dateFin, null, {'label_attr': {'class': 'text-white'}}) }}
                                        {{ form_widget(forms[e.getId()].dateFin, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
                                        <div class="text-danger small mt-1">{{ form_errors(forms[e.getId()].dateFin) }}</div>
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(forms[e.getId()].status, null, {'label_attr': {'class': 'text-white'}}) }}
                                        {{ form_widget(forms[e.getId()].status, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
                                        <div class="text-danger small mt-1">{{ form_errors(forms[e.getId()].status) }}</div>
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(forms[e.getId()].place, null, {'label_attr': {'class': 'text-white'}}) }}
                                        {{ form_widget(forms[e.getId()].place, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
                                        <div class="text-danger small mt-1">{{ form_errors(forms[e.getId()].place) }}</div>
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(forms[e.getId()].imageFile, null, {'label_attr': {'class': 'text-white'}}) }}
                                        {{ form_widget(forms[e.getId()].imageFile, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
                                        <div class="text-danger small mt-1">{{ form_errors(forms[e.getId()].imageFile) }}</div>
                                    </div>
                                    <div class="modal-footer" style="border-color: rgba(255,255,255,0.1);">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                                    </div>
                                {{ form_end(forms[e.getId()]) }}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}

    {# Script to reopen modal if there are validation errors #}
    {% if edit_event_id is defined %}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var editModal = new bootstrap.Modal(document.getElementById('editModal{{ edit_event_id }}'));
                editModal.show();
            });
        </script>
    {% endif %}

    {# Calendar Modal #}
    <div class="modal fade" id="calendarModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content calendar-modal-content text-white">
                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title fw-bold">📅 Mon Calendrier d'Événements</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="calendar" style="min-height: 600px;"></div>
                </div>
                <div class="modal-footer border-top border-secondary border-opacity-25 bg-black bg-opacity-25">
                    <div class="d-flex flex-wrap gap-4 small fw-bold">
                        <div class="d-flex align-items-center">
                            <span class="badge p-1 me-2" style="background: linear-gradient(135deg, #10b981, #059669); width: 14px; height: 14px; border-radius: 4px;">&nbsp;</span> 
                            <span class="text-white-50">OPEN</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="badge p-1 me-2" style="background: linear-gradient(135deg, #f43f5e, #be123c); width: 14px; height: 14px; border-radius: 4px;">&nbsp;</span> 
                            <span class="text-white-50">CLOSED (FULL)</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="badge p-1 me-2" style="background: #475569; width: 14px; height: 14px; border-radius: 4px;">&nbsp;</span> 
                            <span class="text-white-50">OVER</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="badge p-1 me-2" style="border: 1px solid #06b6d4; box-shadow: 0 0 8px rgba(6, 182, 212, 0.5); width: 14px; height: 14px; border-radius: 4px; background: rgba(6, 182, 212, 0.2);">&nbsp;</span>
                            <span style="animation: running-lean 0.8s infinite ease-in-out; display: inline-block; font-size: 1.2rem;">🏃</span> 
                            <span class="text-info ms-1">PARTICIPATING</span>
                        </div>
                    </div>
                    <button type="button" class="btn btn-secondary border-0 ms-auto px-4 fw-bold" data-bs-dismiss="modal">Ferme</button>
                </div>
            </div>
        </div>
    </div>

    {# Add Place Modal (Leaflet Form) #}
    <div class="modal fade" id="addPlaceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content calendar-modal-content text-white" style="background: var(--tc-bg-card, #1a1a2e); color: var(--tc-text, #fff);">
                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title fw-bold">📍 Ajouter un Lieu</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="addPlaceForm">
                        <div class="mb-3">
                            <label class="form-label text-white">Nom du Lieu</label>
                            <input type="text" id="place_nom" name="nomPlace" class="form-control bg-dark text-white border-secondary" required minlength="3">
                            <div class="text-danger small mt-1 place-error" id="error-nomPlace"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Type du Lieu</label>
                            <input type="text" id="place_type" name="typePlace" class="form-control bg-dark text-white border-secondary" required minlength="3">
                            <div class="text-danger small mt-1 place-error" id="error-typePlace"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Capacité Maximum</label>
                            <input type="number" id="place_capacite" name="capaciteMax" class="form-control bg-dark text-white border-secondary" required min="1" max="50000">
                            <div class="text-danger small mt-1 place-error" id="error-capaciteMax"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white text-info"><i class="bi bi-hand-index"></i> Recherchez, cliquez sur la carte, ou utilisez votre position</label>
                            <div class="mb-2">
                                <button type="button" id="btnCurrentLocation" class="btn btn-sm btn-outline-info rounded-pill fw-bold">
                                    <i class="bi bi-geo"></i> Utiliser ma position actuelle
                                </button>
                            </div>
                            <!-- Note the z-index fix to prevent search dropdown from being hidden in modal -->
                            <div id="placeMap" style="height: 300px; width: 100%; border-radius: 8px; border: 2px solid rgba(255,255,255,0.1); z-index: 1;"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-white">Adresse générée par la carte</label>
                            <input type="text" id="place_adresse" name="adresse" class="form-control bg-dark text-white border-secondary" readonly placeholder="L'adresse apparaîtra ici...">
                            <div class="text-danger small mt-1 place-error" id="error-adresse"></div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-top border-secondary border-opacity-25 bg-black bg-opacity-25">
                    <button type="button" class="btn btn-secondary border-0 px-4 fw-bold" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-success px-4 fw-bold" id="btnSubmitPlace">
                        <span id="placeSubmitText">Enregistrer le Lieu</span>
                        <div class="spinner-border spinner-border-sm d-none" id="placeSubmitLoader" role="status"></div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    {% include 'frontoffice/partials/_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');
    var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        themeSystem: 'standard',
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,listMonth'
        },
        height: 'auto',
        events: '/api/my-events/calendar',
        eventClick: function(info) {
            if (info.event.url) {
                // Prevent default browser navigation if needed
                // For now, let it follow the URL to /events
            }
        },
        eventContent: function(arg) {
            let runnerHtml = '';
            if (arg.event.extendedProps.isParticipating) {
                runnerHtml = '<span class="fc-event-runner">🏃</span>';
            }
            
            // Re-introducing the "Living Square"
            let status = arg.event.extendedProps.status;
            let squareHtml = '<span class="fc-event-square square-' + status + '"></span>';
            
            let participatingClass = arg.event.extendedProps.isParticipating ? 'event-participating' : '';
            
            // Return pill-style content with square inside and runner on the right
            return {
                html: '<div class="fc-content d-flex align-items-center w-100 fc-event-tag ' + participatingClass + '">' + 
                      squareHtml + 
                      '<span class="fc-event-title text-truncate fw-bold flex-grow-1">' + arg.event.title.replace('★ ', '').replace('🚶 ', '').replace('🏃 ', '') + '</span>' + 
                      runnerHtml + 
                      '</div>'
            };
        },
        eventDidMount: function(info) {
            info.el.style.background = 'none';
            info.el.style.border = 'none';
            
            // Reverted to simple tooltip
            info.el.title = info.event.title.replace('★ ', '').replace('🏃 ', '').replace('🚶 ', '') + '\n' + 
                           '📍 Lieu: ' + info.event.extendedProps.place + '\n' + 
                           '🎮 Type: ' + info.event.extendedProps.type + '\n' +
                           '📊 Statut: ' + info.event.extendedProps.status.toUpperCase();
        }
    });

    // Re-render calendar when modal is shown to fix layout issues
    var modalEl = document.getElementById('calendarModal');
    modalEl.addEventListener('shown.bs.modal', function () {
        calendar.render();
    });

    // --- LEAFLET JS FOR "ADD PLACE" MODAL ---
    let placeMap = null;
    let placeMarker = null;
    const addPlaceModalEl = document.getElementById('addPlaceModal');
    const latInput = document.getElementById('place_lat');
    const lngInput = document.getElementById('place_lng');
    const addressInput = document.getElementById('place_adresse');
    const saveBtn = document.getElementById('btnSubmitPlace');

    function updateLocation(lat, lng) {
        if (placeMarker) {
            placeMarker.setLatLng([lat, lng]);
        } else {
            placeMarker = L.marker([lat, lng]).addTo(placeMap);
        }

        addressInput.value = "Recherche d'adresse en cours...";
        fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`, {
            headers: { 'Accept-Language': 'fr' }
        })
        .then(response => response.json())
        .then(data => {
            if (data && data.display_name) {
                addressInput.value = data.display_name;
            } else {
                addressInput.value = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
            }
        })
        .catch(err => {
            console.error("Geocoding failed", err);
            addressInput.value = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
        });
    }

    addPlaceModalEl.addEventListener('shown.bs.modal', function () {
        // Initialize map only once
        if (!placeMap) {
            // Default center
            placeMap = L.map('placeMap').setView([36.8065, 10.1815], 10);
            
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(placeMap);

            // Add Search Control (Leaflet Geocoder plugin)
            var geocoder = L.Control.geocoder({
                defaultMarkGeocode: false,
                placeholder: "Rechercher un lieu...",
                errorMessage: "Adresse non trouvée."
            })
            .on('markgeocode', function(e) {
                var latlng = e.geocode.center;
                
                // Auto-center & Zoom on search result
                placeMap.setView(latlng, 16); 
                
                if (placeMarker) {
                    placeMarker.setLatLng(latlng);
                } else {
                    placeMarker = L.marker(latlng).addTo(placeMap);
                }
                
                // For direct search result, use the Geocoder returned name
                const resolvedAddress = e.geocode.name || Object.values(e.geocode.properties.address).join(', ');
                addressInput.value = resolvedAddress;
            })
            .addTo(placeMap);

            // Map click handler
            placeMap.on('click', function(e) {
                updateLocation(e.latlng.lat, e.latlng.lng);
            });

            // Use My Location handler
            document.getElementById('btnCurrentLocation').addEventListener('click', function() {
                if ("geolocation" in navigator) {
                    const btn = document.getElementById('btnCurrentLocation');
                    const originalHTML = btn.innerHTML;
                    
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Localisation...';
                    btn.disabled = true;

                    navigator.geolocation.getCurrentPosition(function(position) {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        
                        // Auto-center & Zoom on Current Location
                        placeMap.setView([lat, lng], 16); 
                        updateLocation(lat, lng);

                        btn.innerHTML = originalHTML;
                        btn.disabled = false;
                    }, function(error) {
                        alert("Erreur de localisation. Veuillez autoriser l'accès à votre position.");
                        btn.innerHTML = originalHTML;
                        btn.disabled = false;
                    }, {
                        timeout: 10000,
                        enableHighAccuracy: true
                    });
                } else {
                    alert("La géolocalisation n'est pas supportée par votre navigateur.");
                }
            });
        }
        
        // Very important: Fix Leaflet gray boxes inside Bootstrap Modal
        setTimeout(() => { placeMap.invalidateSize(); }, 200);
    });

    // AJAX Form Submission
    saveBtn.addEventListener('click', function(e) {
        e.preventDefault();
        
        // Clear previous errors
        document.querySelectorAll('.place-error').forEach(el => el.innerText = '');
        
        const payload = {
            nomPlace: document.getElementById('place_nom').value,
            typePlace: document.getElementById('place_type').value,
            capaciteMax: document.getElementById('place_capacite').value,
            adresse: addressInput.value
        };

        const btnText = document.getElementById('placeSubmitText');
        const loader = document.getElementById('placeSubmitLoader');
        
        btnText.classList.add('d-none');
        loader.classList.remove('d-none');
        saveBtn.disabled = true;

        fetch('/api/place/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(payload)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Success: Hide modal & optionally reload to show new places in dropdown (if there's one)
                const modal = bootstrap.Modal.getInstance(addPlaceModalEl);
                modal.hide();
                alert(data.message); // simple notification
                window.location.reload(); // Quickest way to refresh states for now
            } else {
                // Display Validation Errors directly under inputs
                for (const [field, msg] of Object.entries(data.errors)) {
                    const errEl = document.getElementById('error-' + field);
                    if (errEl) errEl.innerText = msg;
                }
            }
        })
        .catch(err => {
            alert("Erreur système lors de l'ajout.");
            console.error(err);
        })
        .finally(() => {
            btnText.classList.remove('d-none');
            loader.classList.add('d-none');
            saveBtn.disabled = false;
        });
    });
});
</script>
{% endblock %}

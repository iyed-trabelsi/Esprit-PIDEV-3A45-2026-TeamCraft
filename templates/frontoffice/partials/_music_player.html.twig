{% if app.user %}
<style>
    #tc-music-player-container {
        position: fixed;
        bottom: 6rem;
        right: 2rem;
        z-index: 1049;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }

    #tc-music-toggle {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a1a2e, #16213e);
        border: 2px solid #0ea5e9;
        color: #0ea5e9;
        font-size: 1.4rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 0 16px rgba(14, 165, 233, 0.4);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    #tc-music-toggle:hover {
        transform: scale(1.1);
        box-shadow: 0 0 24px rgba(14, 165, 233, 0.6);
    }

    #tc-music-toggle.playing {
        border-color: #22c55e;
        color: #22c55e;
        box-shadow: 0 0 16px rgba(34, 197, 94, 0.5);
        animation: pulseGreen 2s infinite;
    }

    @keyframes pulseGreen {
        0%, 100% { box-shadow: 0 0 16px rgba(34, 197, 94, 0.5); }
        50%       { box-shadow: 0 0 28px rgba(34, 197, 94, 0.9); }
    }

    #tc-music-panel {
        position: absolute;
        bottom: 70px;
        right: 0;
        width: 300px;
        background: rgba(15, 15, 22, 0.97);
        backdrop-filter: blur(16px);
        border: 1px solid #334155;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.7);
        display: none;
        flex-direction: column;
    }

    #tc-music-panel.open {
        display: flex;
        animation: musicSlideIn 0.25s ease;
    }

    @keyframes musicSlideIn {
        from { transform: translateY(12px); opacity: 0; }
        to   { transform: translateY(0);   opacity: 1; }
    }

    .music-panel-header {
        padding: 0.75rem 1rem;
        background: rgba(14, 165, 233, 0.07);
        border-bottom: 1px solid #334155;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .music-panel-header span {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #0ea5e9;
    }

    .music-panel-header button {
        background: none;
        border: none;
        color: #64748b;
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
        transition: color 0.2s;
        padding: 0;
    }

    .music-panel-header button:hover { color: #f1f5f9; }

    .music-panel-body { padding: 1rem; }

    .music-track-info {
        text-align: center;
        margin-bottom: 1rem;
    }

    .music-track-title {
        font-size: 0.88rem;
        font-weight: 600;
        color: #f1f5f9;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.15rem;
    }

    .music-track-artist {
        font-size: 0.72rem;
        color: #64748b;
    }

    /* Progress bar */
    .music-progress-row {
        margin-bottom: 0.85rem;
    }

    .music-progress-bar-bg {
        width: 100%;
        height: 4px;
        background: #1e293b;
        border-radius: 2px;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .music-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #0ea5e9, #22c55e);
        width: 0%;
        border-radius: 2px;
        transition: width 0.3s linear;
    }

    .music-time-row {
        display: flex;
        justify-content: space-between;
        margin-top: 0.3rem;
        font-size: 0.65rem;
        color: #475569;
    }

    .music-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 0.85rem;
    }

    .music-btn {
        background: none;
        border: 1px solid #334155;
        color: #94a3b8;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.2s;
        padding: 0;
    }

    .music-btn:hover { border-color: #0ea5e9; color: #0ea5e9; }

    .music-btn-play {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg, #0ea5e9, #22c55e);
        border: none !important;
        color: white !important;
        font-size: 1.1rem;
        box-shadow: 0 0 14px rgba(14,165,233,0.4);
    }

    .music-btn-play:hover {
        transform: scale(1.08);
        box-shadow: 0 0 22px rgba(14,165,233,0.65);
    }

    .music-volume-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .music-volume-row i { color: #64748b; font-size: 0.85rem; }

    .music-volume-row input[type=range] {
        flex: 1;
        accent-color: #0ea5e9;
        cursor: pointer;
    }

    .music-panel-footer {
        padding: 0.5rem 1rem;
        border-top: 1px solid #1e293b;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .music-playlist {
        padding: 0 0 0.5rem;
        border-top: 1px solid #1e293b;
        max-height: 130px;
        overflow-y: auto;
    }

    .music-playlist::-webkit-scrollbar { width: 3px; }
    .music-playlist::-webkit-scrollbar-track { background: transparent; }
    .music-playlist::-webkit-scrollbar-thumb { background: #334155; border-radius: 2px; }

    .music-playlist-item {
        padding: 0.45rem 1rem;
        cursor: pointer;
        transition: background 0.15s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.76rem;
        color: #94a3b8;
        border-left: 2px solid transparent;
    }

    .music-playlist-item:hover { background: rgba(14,165,233,0.08); color: #f1f5f9; }
    .music-playlist-item.active { background: rgba(14,165,233,0.12); color: #0ea5e9; font-weight: 600; border-left-color: #0ea5e9; }
    .music-playlist-item .pi { font-size: 0.65rem; }

    /* Error state */
    .music-error { font-size: 0.72rem; color: #ef4444; text-align: center; padding: 0.3rem; display: none; }
</style>

<div id="tc-music-player-container">

    {# Floating Panel #}
    <div id="tc-music-panel">
        <div class="music-panel-header">
            <span><i class="bi bi-music-note-beamed me-1"></i>Gaming Mix</span>
            <button id="tc-music-close"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="music-panel-body">
            <div class="music-track-info">
                <div class="music-track-title" id="tc-track-title">Sélectionne une piste</div>
                <div class="music-track-artist" id="tc-track-artist">---</div>
            </div>

            <div class="music-progress-row">
                <div class="music-progress-bar-bg" id="tc-progress-bg">
                    <div class="music-progress-fill" id="tc-progress-fill"></div>
                </div>
                <div class="music-time-row">
                    <span id="tc-time-cur">0:00</span>
                    <span id="tc-time-dur">0:00</span>
                </div>
            </div>

            <div class="music-controls">
                <button class="music-btn" id="tc-prev" title="Précédent"><i class="bi bi-skip-start-fill"></i></button>
                <button class="music-btn music-btn-play" id="tc-play-pause" title="Play/Pause">
                    <i class="bi bi-play-fill" id="tc-play-icon"></i>
                </button>
                <button class="music-btn" id="tc-next" title="Suivant"><i class="bi bi-skip-end-fill"></i></button>
            </div>

            <div class="music-volume-row">
                <i class="bi bi-volume-down"></i>
                <input type="range" id="tc-volume" min="0" max="100" value="50">
                <i class="bi bi-volume-up"></i>
            </div>
            <div class="music-error" id="tc-music-error">
                <i class="bi bi-exclamation-triangle me-1"></i>Impossible de charger cette piste, passage à la suivante...
            </div>
        </div>

        <div class="music-playlist" id="tc-playlist"></div>

        <div class="music-panel-footer">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="tc-music-enabled" {% if app.user.isMusicEnabled %}checked{% endif %}>
                    <label class="form-check-label small" for="tc-music-enabled" style="color:#64748b; font-size:0.72rem;">Musique activée</label>
                </div>
                <a href="{{ path('music_library') }}" class="small text-decoration-none" style="color:#0ea5e9; font-size:0.72rem;">
                    <i class="bi bi-collection me-1"></i>Ma Bibliothèque
                </a>
            </div>
        </div>
    </div>

    {# Floating Toggle Button #}
    <button id="tc-music-toggle" title="Lecteur musical">
        <i class="bi bi-headphones" id="tc-music-icon"></i>
    </button>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {

    // ─── Playlist ───────────────────────────────────────────────────────────
    // Using Archive.org free streaming audio (public domain / CC licensed gaming tracks)
    let TRACKS = [
        {
            title:  'Electro Gaming',
            artist: 'Gaming Beats (CC)',
            src:    'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3'
        },
        {
            title:  'Cyber Arcade',
            artist: 'SoundHelix (CC)',
            src:    'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3'
        },
        {
            title:  'Epic Dungeon',
            artist: 'SoundHelix (CC)',
            src:    'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3'
        },
        {
            title:  'Battle Theme',
            artist: 'SoundHelix (CC)',
            src:    'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3'
        },
        {
            title:  'Victory Fanfare',
            artist: 'SoundHelix (CC)',
            src:    'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-5.mp3'
        },
        {
            title:  'Night Raid',
            artist: 'SoundHelix (CC)',
            src:    'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-6.mp3'
        },
    ];

    // ─── State ──────────────────────────────────────────────────────────────
    let currentTrack = 0;
    let isPlaying    = false;
    let panelOpen    = false;
    let musicEnabled = {{ app.user.isMusicEnabled ? 'true' : 'false' }};
    let isCustomTrack = false;

    // ─── Audio element ───────────────────────────────────────────────────────
    const audio = new Audio();
    audio.volume = 0.5;
    audio.preload = 'none';

    // ─── DOM refs ────────────────────────────────────────────────────────────
    const panel        = document.getElementById('tc-music-panel');
    const toggleBtn    = document.getElementById('tc-music-toggle');
    const closeBtn     = document.getElementById('tc-music-close');
    const playBtn      = document.getElementById('tc-play-pause');
    const playIcon     = document.getElementById('tc-play-icon');
    const prevBtn      = document.getElementById('tc-prev');
    const nextBtn      = document.getElementById('tc-next');
    const volumeSlider = document.getElementById('tc-volume');
    const trackTitle   = document.getElementById('tc-track-title');
    const trackArtist  = document.getElementById('tc-track-artist');
    const playlistEl   = document.getElementById('tc-playlist');
    const enabledCB    = document.getElementById('tc-music-enabled');
    const musicIcon    = document.getElementById('tc-music-icon');
    const progressFill = document.getElementById('tc-progress-fill');
    const progressBg   = document.getElementById('tc-progress-bg');
    const timeCur      = document.getElementById('tc-time-cur');
    const timeDur      = document.getElementById('tc-time-dur');
    const errorDiv     = document.getElementById('tc-music-error');

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function fmtTime(s) {
        if (!s || isNaN(s)) return '0:00';
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return m + ':' + (sec < 10 ? '0' : '') + sec;
    }

    function setPlayingUI(playing) {
        isPlaying = playing;
        playIcon.className = playing ? 'bi bi-pause-fill' : 'bi bi-play-fill';
        toggleBtn.classList.toggle('playing', playing);
        musicIcon.className = playing ? 'bi bi-music-note-beamed' : 'bi bi-headphones';
    }

    function updateTrackInfo() {
        const t = TRACKS[currentTrack];
        trackTitle.textContent  = t.title;
        trackArtist.textContent = t.artist;
        updatePlaylistHighlight();
        errorDiv.style.display = 'none';
    }

    function updatePlaylistHighlight() {
        document.querySelectorAll('.music-playlist-item').forEach((el, i) => {
            el.classList.toggle('active', i === currentTrack);
        });
    }

    function buildPlaylist() {
        playlistEl.innerHTML = '';
        TRACKS.forEach((t, i) => {
            const item = document.createElement('div');
            item.className = 'music-playlist-item' + (i === currentTrack ? ' active' : '');
            item.innerHTML = `<i class="bi bi-music-note pi"></i><span>${t.title}</span>`;
            item.addEventListener('click', () => loadAndPlay(i));
            playlistEl.appendChild(item);
        });
    }

    function loadAndPlay(index) {
        currentTrack = index;
        updateTrackInfo();
        audio.src = TRACKS[index].src;
        audio.load();
        audio.play().then(() => {
            setPlayingUI(true);
        }).catch(err => {
            console.warn('Audio play error:', err);
            setPlayingUI(false);
        });
    }

    function openPanel() {
        panelOpen = true;
        panel.classList.add('open');
    }

    function closePanel() {
        panelOpen = false;
        panel.classList.remove('open');
    }

    // ─── Audio events ────────────────────────────────────────────────────────
    audio.addEventListener('timeupdate', () => {
        if (audio.duration) {
            const pct = (audio.currentTime / audio.duration) * 100;
            progressFill.style.width = pct + '%';
            timeCur.textContent = fmtTime(audio.currentTime);
            timeDur.textContent = fmtTime(audio.duration);
        }
    });

    audio.addEventListener('ended', () => {
        loadAndPlay((currentTrack + 1) % TRACKS.length);
    });

    audio.addEventListener('error', () => {
        errorDiv.style.display = 'block';
        setPlayingUI(false);
        // Try next track after 2s
        setTimeout(() => {
            loadAndPlay((currentTrack + 1) % TRACKS.length);
        }, 2000);
    });

    audio.addEventListener('playing', () => setPlayingUI(true));
    audio.addEventListener('pause',   () => setPlayingUI(false));

    // Click on progress bar to seek
    progressBg.addEventListener('click', function(e) {
        if (!audio.duration) return;
        const rect = this.getBoundingClientRect();
        const pct  = (e.clientX - rect.left) / rect.width;
        audio.currentTime = pct * audio.duration;
    });

    // ─── UI events ───────────────────────────────────────────────────────────
    toggleBtn.addEventListener('click', () => panelOpen ? closePanel() : openPanel());
    closeBtn.addEventListener('click', closePanel);

    playBtn.addEventListener('click', () => {
        if (audio.src === '' || audio.src === window.location.href) {
            // Nothing loaded yet — load first track
            loadAndPlay(currentTrack);
            return;
        }
        if (isPlaying) {
            audio.pause();
        } else {
            audio.play().catch(() => {});
        }
    });

    volumeSlider.addEventListener('input', function() {
        audio.volume = parseInt(this.value) / 100;
    });

    enabledCB.addEventListener('change', function() {
        musicEnabled = this.checked;
        fetch('/api/music/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled: this.checked })
        });
        if (!this.checked) {
            audio.pause();
        } else {
            if (audio.src === '' || audio.src === window.location.href) {
                loadAndPlay(currentTrack);
            } else {
                audio.play().catch(() => {});
            }
        }
    });

    // ─── Custom Track Support ───────────────────────────────────────────────
    function loadAndPlayCustomTrack(url, title, artist) {
        isCustomTrack = true;
        trackTitle.textContent = title;
        trackArtist.textContent = artist;
        audio.src = url;
        audio.load();
        audio.play().then(() => {
            setPlayingUI(true);
        }).catch(err => {
            console.warn('Audio play error:', err);
            setPlayingUI(false);
        });
        updatePlaylistHighlight();
    }

    // ─── Fetch User Tracks from API ──────────────────────────────────────────
    async function fetchUserTracks() {
        try {
            const response = await fetch('/music/api/tracks');
            if (response.ok) {
                const userTracks = await response.json();
                if (userTracks.length > 0) {
                    // Merge user tracks with default tracks
                    const newTracks = userTracks.map(t => ({
                        title: t.title,
                        artist: t.artist,
                        src: t.src,
                        isUserTrack: true
                    }));
                    TRACKS = [...newTracks, ...TRACKS];
                    buildPlaylist();
                }
            }
        } catch (e) {
            console.warn('Failed to fetch user tracks:', e);
        }
    }

    // ─── Override next/prev for custom tracks ───────────────────────────────
    nextBtn.addEventListener('click', () => {
        if (isCustomTrack) {
            isCustomTrack = false;
            loadAndPlay((currentTrack + 1) % TRACKS.length);
        } else {
            loadAndPlay((currentTrack + 1) % TRACKS.length);
        }
    });
    prevBtn.addEventListener('click', () => {
        if (isCustomTrack) {
            isCustomTrack = false;
            loadAndPlay((currentTrack - 1 + TRACKS.length) % TRACKS.length);
        } else {
            loadAndPlay((currentTrack - 1 + TRACKS.length) % TRACKS.length);
        }
    });

    // ─── Init ────────────────────────────────────────────────────────────────
    buildPlaylist();
    updateTrackInfo();

    // Fetch user tracks
    fetchUserTracks();

    // Expose global function for library page
    window.tcMusicPlayer = {
        loadAndPlayCustomTrack: loadAndPlayCustomTrack
    };

    // Auto-start if music was enabled
    if (musicEnabled) {
        // Load first track (won't play automatically due to browser policy, but will on user interaction)
        audio.src = TRACKS[currentTrack].src;
        audio.load();
        // Try to play (some browsers allow it if user has interacted)
        audio.play().then(() => {
            setPlayingUI(true);
        }).catch(() => {
            // Browser blocked autoplay — ready to play on first click
            setPlayingUI(false);
        });
    }
});
</script>
{% endif %}

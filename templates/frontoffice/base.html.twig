<!DOCTYPE html>
<html lang="fr">

    <head>
        <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TEAMCRAFT{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/favicon.png') }}">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <style>
            :root {
                --tc-bg-dark: #0f0f12;
                --tc-bg-card: #1a1a1f;
                --tc-bg-input: #252530;
                --tc-cyan: #0ea5e9;
                --tc-cyan-hover: #38bdf8;
                --tc-neon-green: #22c55e;
                --tc-text: #f1f5f9;
                --tc-text-muted: #94a3b8;
                --tc-border: #334155;
            }
            * {
                cursor: url('{{ asset('images/cursorrrr.png') }}'), auto !important;
            }
            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--tc-bg-dark);
                color: var(--tc-text);
                min-height: 100vh;
                position: relative;
                overflow-x: hidden;
            }
            .video-background {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: -1;
                object-fit: cover;
            }
            .video-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: -1;
                background: linear-gradient(rgba(15,15,18,0.88) 0%, rgba(15,15,18,0.82) 100%);
                pointer-events: none;
            }
            body.static-bg {
                background-image: linear-gradient(rgba(15,15,18,0.88) 0%, rgba(15,15,18,0.82) 100%), url('{{ asset('images/home-page-background.jpeg') }}');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                background-attachment: fixed;
            }
            body.static-bg .video-background,
            body.static-bg .video-overlay {
                display: none;
            }
            .font-display { font-family: 'Orbitron', sans-serif; }
            .btn-tc-primary {
                background: var(--tc-cyan);
                border: none;
                color: #fff;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                padding: 0.75rem 1.5rem;
                border-radius: 0.5rem;
                box-shadow: 0 0 20px rgba(14, 165, 233, 0.35);
            }
            .btn-tc-primary:hover {
                background: var(--tc-cyan-hover);
                color: #fff;
                box-shadow: 0 0 25px rgba(14, 165, 233, 0.5);
            }
            .btn-tc-outline {
                background: transparent;
                border: 2px solid var(--tc-text);
                color: var(--tc-text);
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                padding: 0.75rem 1.5rem;
                border-radius: 0.5rem;
            }
            .btn-tc-outline:hover {
                background: rgba(255,255,255,0.1);
                color: var(--tc-text);
                border-color: var(--tc-text);
            }
            .form-tc .form-control, .form-tc .form-select {
                background: var(--tc-bg-input);
                border: 1px solid var(--tc-border);
                color: var(--tc-text);
                border-radius: 0.5rem;
                padding: 0.75rem 1rem;
            }
            .form-tc .form-control::placeholder { color: var(--tc-text-muted); }
            .form-tc .form-control:focus, .form-tc .form-select:focus {
                background: var(--tc-bg-input);
                border-color: var(--tc-cyan);
                color: var(--tc-text);
                box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2);
            }
            .form-tc label { color: var(--tc-text-muted); font-weight: 500; }
            .card-tc {
                background: var(--tc-bg-card);
                border: 1px solid var(--tc-border);
                border-radius: 0.75rem;
                box-shadow: 0 0 30px rgba(34, 197, 94, 0.08);
            }
            .navbar-tc .nav-link { color: var(--tc-text) !important; font-weight: 500; }
            .navbar-tc .nav-link:hover { color: var(--tc-cyan) !important; }
            .brand-text { font-family: 'Orbitron', sans-serif; font-weight: 700; color: var(--tc-text); letter-spacing: 0.1em; }
            /* Discovery pages: cards, badges, recruit button */
            .discovery-section-title { display: flex; align-items: center; gap: 0.5rem; }
            .discovery-icon-people { display: inline-flex; color: var(--tc-neon-green); line-height: 1; }
            .discovery-view-all { color: var(--tc-neon-green) !important; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; }
            .discovery-view-all:hover { color: var(--tc-cyan) !important; }
            .discovery-card { background: var(--tc-bg-card); border: 1px solid var(--tc-border); border-radius: 0.75rem; overflow: hidden; box-shadow: 0 0 20px rgba(34, 197, 94, 0.06); transition: border-color 0.2s; }
            .discovery-card:hover { border-color: rgba(34, 197, 94, 0.4); }
            .discovery-avatar { width: 80px; height: 80px; border-radius: 50%; border: 3px solid var(--tc-neon-green); background: var(--tc-bg-input); display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--tc-text-muted); font-size: 1.25rem; }
            .discovery-card-title { font-weight: 700; color: var(--tc-text); }
            .discovery-card-subtitle { color: var(--tc-text-muted); font-size: 0.9rem; }
            .badge-game { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; padding: 0.25rem 0.5rem; border-radius: 0.35rem; }
            .badge-game.valorant { background: #e11d48; color: #fff; }
            .badge-game.overwatch { background: #0ea5e9; color: #fff; }
            .badge-game.lol { background: #3b82f6; color: #fff; }
            .badge-game.cs2 { background: #f97316; color: #fff; }
            .badge-rank { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; padding: 0.25rem 0.5rem; border-radius: 0.35rem; color: #fff; }
            .badge-rank.purple { background: #a855f7; }
            .badge-rank.yellow { background: #eab308; color: #1f2937; }
            .badge-rank.green { background: #22c55e; }
            .badge-rank.orange { background: #f97316; }
            .btn-recruit { background: var(--tc-neon-green); border: none; color: #fff; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.6rem 1rem; border-radius: 0.5rem; width: 100%; }
            .btn-recruit:hover { background: #16a34a; color: #fff; }

            /* Player card action buttons */
            .player-actions .btn {
                flex: 1 1 0;
                padding: 0.6rem 1rem;
                font-size: 0.8rem;
            }

            /* Background toggle play/pause icon */
            .bg-toggle-btn {
                background: transparent;
                border: none;
                padding: 0;
                margin: 0;
                line-height: 0;
            }
            .bg-toggle-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background-color: #27272f;
                position: relative;
            }
            .bg-toggle-icon::before {
                content: '';
                position: absolute;
                display: block;
            }
            /* Play icon (triangle) */
            .bg-toggle-icon.icon-play::before {
                border-style: solid;
                border-width: 8px 0 8px 14px;
                border-color: transparent transparent transparent #ffffff;
                left: 12px;
            }
            /* Pause icon (two bars) */
            .bg-toggle-icon.icon-pause::before {
                width: 14px;
                height: 14px;
                border-left: 4px solid #ffffff;
                border-right: 4px solid #ffffff;
            }
            .favorite-btn i { transition: transform 0.2s, color 0.2s; }
            .favorite-btn:hover i { transform: scale(1.2); }
            .favorite-btn .bi-heart-fill { color: #ef4444; }
            
            /* Notification System */
            .notification-container {
                position: fixed;
                bottom: 20px;
                left: 20px;
                z-index: 9999;
                display: flex;
                flex-direction: column;
                gap: 10px;
                pointer-events: none;
            }
            
            .notification {
                min-width: 320px;
                max-width: 400px;
                padding: 16px 20px;
                border-radius: 12px;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
                display: flex;
                align-items: center;
                gap: 12px;
                pointer-events: auto;
                transform: translateX(-120%);
                opacity: 0;
                transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.1);
            }
            
            .notification.show {
                transform: translateX(0);
                opacity: 1;
            }
            
            .notification.hide {
                transform: translateX(-120%);
                opacity: 0;
            }
            
            .notification-icon {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                font-size: 14px;
                font-weight: bold;
            }
            
            .notification-content {
                flex: 1;
                font-size: 14px;
                line-height: 1.4;
                font-weight: 500;
            }
            
            .notification-close {
                width: 20px;
                height: 20px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.1);
                border: none;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background 0.2s;
                flex-shrink: 0;
            }
            
            .notification-close:hover {
                background: rgba(255, 255, 255, 0.2);
            }
            
            /* Success notification */
            .notification.success {
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                color: white;
            }
            
            .notification.success .notification-icon {
                background: rgba(255, 255, 255, 0.2);
                color: #10b981;
            }
            
            /* Info notification */
            .notification.info {
                background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
                color: white;
            }
            
            .notification.info .notification-icon {
                background: rgba(255, 255, 255, 0.2);
                color: #3b82f6;
            }
            
            /* Warning notification */
            .notification.warning {
                background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
                color: white;
            }
            
            .notification.warning .notification-icon {
                background: rgba(255, 255, 255, 0.2);
                color: #f59e0b;
            }
            
            /* Error notification */
            .notification.error {
                background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
                color: white;
            }
            
            .notification.error .notification-icon {
                background: rgba(255, 255, 255, 0.2);
                color: #ef4444;
            }
        </style>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

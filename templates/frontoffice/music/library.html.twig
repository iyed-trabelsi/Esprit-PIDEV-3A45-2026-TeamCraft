{% extends 'frontoffice/base.html.twig' %}

{% block title %}My Music Library - TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="position-relative flex-grow-1 py-5" style="min-height: calc(100vh - 80px);">
        <div class="container position-relative z-1">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-8">
                    <div class="card card-tc p-4 p-md-5">
                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                            <h2 class="fw-bold text-white mb-0">
                                <i class="bi bi-collection-play me-2"></i>My Music Library
                            </h2>
                            <a href="{{ path('music_upload') }}" class="btn btn-tc-primary">
                                <i class="bi bi-cloud-upload me-2"></i>Upload
                            </a>
                        </div>

                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success border-0 shadow-sm mb-4">
                                <i class="bi bi-check-circle me-2"></i>{{ message }}
                            </div>
                        {% endfor %}

                        {% if tracks|length > 0 %}
                            <div class="table-responsive">
                                <table class="table table-dark table-hover align-middle rounded-table">
                                    <thead>
                                        <tr>
                                            <th class="text-white-50 rounded-start">#</th>
                                            <th class="text-white-50">Title</th>
                                            <th class="text-white-50 text-end rounded-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for track in tracks %}
                                            <tr>
                                                <td class="text-white-50">{{ loop.index }}</td>
                                                <td class="text-white">
                                                    <i class="bi bi-music-note-beamed me-2 text-cyan"></i>
                                                    {{ track.title }}
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-link text-success p-1" onclick="playTrack('{{ track.fileUrl }}', '{{ track.title }}', '{{ track.artist ?: 'Unknown' }}')" title="Play">
                                                        <i class="bi bi-play-fill fs-5"></i>
                                                    </button>
                                                    <form method="post" action="{{ path('music_delete', {id: track.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this track?');">
                                                        <button type="submit" class="btn btn-sm btn-link text-danger p-1" title="Delete">
                                                            <i class="bi bi-trash fs-5"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="text-center py-5">
                                <i class="bi bi-music-note-beamed display-1 text-white-25 mb-3"></i>
                                <p class="text-white-50 mb-3">Your library is empty</p>
                                <a href="{{ path('music_upload') }}" class="btn btn-tc-primary">
                                    <i class="bi bi-cloud-upload me-2"></i>Upload your first track
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}

    <style>
        .rounded-table {
            border-radius: 0.75rem;
            overflow: hidden;
            border: 1px solid #334155;
        }
        .rounded-table thead th:first-child {
            border-top-left-radius: 0.75rem;
        }
        .rounded-table thead th:last-child {
            border-top-right-radius: 0.75rem;
        }
        .rounded-table tbody tr:last-child td:first-child {
            border-bottom-left-radius: 0.75rem;
        }
        .rounded-table tbody tr:last-child td:last-child {
            border-bottom-right-radius: 0.75rem;
        }
        .rounded-table thead {
            background: rgba(14, 165, 233, 0.1);
        }
    </style>

    <script>
        function playTrack(url, title, artist) {
            // Open the music player panel
            const panel = document.getElementById('tc-music-panel');
            if (panel) {
                panel.classList.add('open');
            }

            // Use the global music player if available
            if (typeof window.tcMusicPlayer !== 'undefined') {
                window.tcMusicPlayer.loadAndPlayCustomTrack(url, title, artist);
            } else {
                // Fallback: create a temporary audio element
                const audio = new Audio(url);
                audio.play().catch(e => console.error('Playback failed:', e));
            }
        }
    </script>
{% endblock %}

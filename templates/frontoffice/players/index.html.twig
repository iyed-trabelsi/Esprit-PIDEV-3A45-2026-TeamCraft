{% extends 'frontoffice/base.html.twig' %}

{% block title %}Player Discovery - TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="h2 fw-bold mb-0 discovery-section-title">
                {% include 'frontoffice/partials/_icon_people.html.twig' %}
                Player Discovery
            </h1>
            <a href="#" class="discovery-view-all">VIEW ALL PLAYERS →</a>
        </div>

        <!-- Filter Bar -->
        <div class="discovery-filter-container mb-5">
            <form action="{{ path('app_players') }}" method="get" class="row g-3 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="discovery-search-wrapper">
                        <i class="fas fa-search discovery-search-icon"></i>
                        <input type="text" name="search" class="form-control discovery-search-input" placeholder="Pseudo..." value="{{ app.request.query.get('search') }}">
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <select name="game" class="form-select discovery-filter-select">
                        <option value="">Tous les types</option>
                        <option value="valorant" {{ app.request.query.get('game') == 'valorant' ? 'selected' : '' }}>VALORANT</option>
                        <option value="lol" {{ app.request.query.get('game') == 'lol' ? 'selected' : '' }}>LEAGUE OF LEGENDS</option>
                        <option value="cs2" {{ app.request.query.get('game') == 'cs2' ? 'selected' : '' }}>CS2</option>
                        <option value="overwatch" {{ app.request.query.get('game') == 'overwatch' ? 'selected' : '' }}>OVERWATCH</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select name="status" class="form-select discovery-filter-select">
                        <option value="">Tous statuts</option>
                        <option value="online" {{ app.request.query.get('status') == 'online' ? 'selected' : '' }}>ONLINE</option>
                        <option value="ingame" {{ app.request.query.get('status') == 'ingame' ? 'selected' : '' }}>IN GAME</option>
                        <option value="offline" {{ app.request.query.get('status') == 'offline' ? 'selected' : '' }}>OFFLINE</option>
                    </select>
                </div>
                <div class="col-8 col-md-2">
                    <select name="sort" class="form-select discovery-filter-select">
                        <option value="">Trier par...</option>
                        <option value="pseudo_asc" {{ app.request.query.get('sort') == 'pseudo_asc' ? 'selected' : '' }}>Pseudo (A-Z)</option>
                        <option value="pseudo_desc" {{ app.request.query.get('sort') == 'pseudo_desc' ? 'selected' : '' }}>Pseudo (Z-A)</option>
                        <option value="newest" {{ app.request.query.get('sort') == 'newest' ? 'selected' : '' }}>Plus récents</option>
                    </select>
                </div>
                <div class="col-4 col-md-2">
                    <button type="submit" class="btn btn-discovery-ok w-100">OK</button>
                </div>
            </form>
        </div>
        <div class="row g-4" id="player-list">
            {% include 'frontoffice/players/_player_cards.html.twig' %}
        </div>
    </section>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.querySelector('.discovery-filter-container form');
    const playerList = document.getElementById('player-list');
    const searchInput = filterForm.querySelector('input[name="search"]');
    const selects = filterForm.querySelectorAll('select');
    
    let debounceTimer;

    const updateFilters = () => {
        const formData = new FormData(filterForm);
        const params = new URLSearchParams(formData);
        
        // Show loading state (optional, for UX)
        playerList.style.opacity = '0.5';
        
        fetch(`${window.location.pathname}?${params.toString()}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.text())
        .then(html => {
            playerList.innerHTML = html;
            playerList.style.opacity = '1';
            
            // Update URL without refreshing for shareability
            window.history.replaceState(null, '', `${window.location.pathname}?${params.toString()}`);
        })
        .catch(error => {
            console.error('Error fetching players:', error);
            playerList.style.opacity = '1';
        });
    };

    // Listen for text input (with debounce)
    searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(updateFilters, 300);
    });

    // Listen for select changes (instant)
    selects.forEach(select => {
        select.addEventListener('change', updateFilters);
    });

    // Prevent form submission (it's all AJAX now)
    filterForm.addEventListener('submit', (e) => {
        e.preventDefault();
        updateFilters();
    });
});
</script>
{% endblock %}

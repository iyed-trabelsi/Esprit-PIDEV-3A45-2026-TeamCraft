{% extends 'frontoffice/base.html.twig' %}

{% block title %}Player Discovery - TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <section class="container py-5 flex-grow-1">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="h2 fw-bold mb-0 discovery-section-title">
                {% include 'frontoffice/partials/_icon_people.html.twig' %}
                Player Discovery
            </h1>
            <a href="#" class="discovery-view-all">VIEW ALL PLAYERS →</a>
        </div>
        <div class="row g-4">
            {% for p in players %}
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="discovery-card h-100 d-flex flex-column p-4 text-center">
                        <div class="discovery-avatar mx-auto mb-3">{{ p.initial }}</div>
                        <h3 class="discovery-card-title mb-1">{{ p.name }}</h3>
                        <p class="discovery-card-subtitle mb-3">{{ p.role }}</p>
                        <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                            <span class="badge-game {{ p.gameColor }}">{{ p.game }}</span>
                            <span class="badge-rank {{ p.rankColor }}">{{ p.rank }}</span>
                        </div>
                        <button type="button" class="btn btn-recruit mt-auto">Recruit Me</button>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    {% include 'frontoffice/partials/_footer_full.html.twig' %}
{% endblock %}

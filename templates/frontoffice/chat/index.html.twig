{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Friend search functionality
    const searchInput = document.getElementById('friend-search');
    const friendItems = document.querySelectorAll('.contact-list-item');

    if (searchInput) {
        searchInput.addEventListener('keyup', function(e) {
            const searchTerm = e.target.value.toLowerCase();

            friendItems.forEach(item => {
                const name = item.querySelector('.fw-medium').textContent.toLowerCase();
                if (name.includes(searchTerm)) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        });
    }

    {% if recipient is defined %}
    const chatBox = document.getElementById('chat-messages');
    if (chatBox) {
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input');
    const recipientId = {{ recipient.id }};

    // Send Message
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const content = input.value.trim();
            if (!content) return;

            // ... (rest of the send message logic)
            fetch(`/chat/send/${recipientId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ content: content })
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'success') {
                    // Add message to chat
                    const msgDiv = document.createElement('div');
                    msgDiv.className = 'd-flex w-100 justify-content-end';
                    msgDiv.id = `msg-container-${data.message.id}`;
                    msgDiv.innerHTML = `
                        <div class="message-bubble message-sent text-start">
                            <span class="msg-time text-end text-white-50">You • ${data.message.createdAt}</span>
                             <div class="d-flex align-items-center gap-2">
                                <span class="msg-content flex-grow-1" id="msg-content-${data.message.id}">${data.message.content}</span>
                                <div class="dropdown">
                                     <button class="btn btn-sm btn-link text-white-50 p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="line-height: 1;">
                                         <i class="bi bi-three-dots-vertical" style="font-size: 0.9rem;"></i>
                                     </button>
                                     <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" style="min-width: 120px;">
                                         <li><a class="dropdown-item edit-msg-btn small" href="#" data-id="${data.message.id}"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                         <li><a class="dropdown-item delete-msg-btn small text-danger" href="#" data-id="${data.message.id}"><i class="bi bi-trash me-2"></i>Delete</a></li>
                                     </ul>
                                </div>
                            </div>
                        </div>
                    `;
                    chatBox.appendChild(msgDiv);
                    chatBox.scrollTop = chatBox.scrollHeight;
                    input.value = '';
                }
            });
        });
    }

    // ... (rest of the JS code for attachments, emoji, etc.)
    // File Upload Handling
    const fileInput = document.getElementById('file-input');
    const fileBtn = document.getElementById('file-upload-btn');

    if (fileBtn && fileInput) {
        fileBtn.addEventListener('click', () => fileInput.click());

        fileInput.addEventListener('change', function() {
            if (this.files.length > 0) {
                const file = this.files[0];
                const formData = new FormData();
                formData.append('file', file);

                fetch(`/chat/upload/${recipientId}`, {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'success') {
                        // Create message element logic (simplified for brevity, should match existing)
                         const msgDiv = document.createElement('div');
                        msgDiv.className = 'd-flex w-100 justify-content-end';
                        msgDiv.id = `msg-container-${data.message.id}`;
                        
                        let attachmentHtml = '';
                        if (data.message.attachmentType === 'image') {
                            attachmentHtml = `<div class="mb-2"><img src="${data.message.attachment}" class="img-fluid rounded" style="max-width: 300px; cursor: pointer;" onclick="window.open(this.src, '_blank')"></div><small class="text-white-50">${data.message.content}</small>`;
                        } else if (data.message.attachmentType === 'video') {
                             attachmentHtml = `<div class="mb-2"><video controls class="rounded" style="max-width: 300px;"><source src="${data.message.attachment}" type="video/mp4"></video></div><small class="text-white-50">${data.message.content}</small>`;
                        } else {
                            attachmentHtml = `<a href="${data.message.attachment}" target="_blank" class="text-white d-flex align-items-center gap-2 text-decoration-none"><i class="bi bi-file-earmark-text fs-4"></i><span>${data.message.content}</span></a>`;
                        }

                        msgDiv.innerHTML = `
                            <div class="message-bubble message-sent text-start">
                                <span class="msg-time text-end text-white-50">You • ${data.message.createdAt}</span>
                                <div class="d-flex align-items-start gap-2">
                                    <div class="flex-grow-1">${attachmentHtml}</div>
                                     <div class="dropdown">
                                         <button class="btn btn-sm btn-link text-white-50 p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="line-height: 1;">
                                             <i class="bi bi-three-dots-vertical" style="font-size: 0.9rem;"></i>
                                         </button>
                                         <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" style="min-width: 120px;">
                                             <li><a class="dropdown-item delete-msg-btn small text-danger" href="#" data-id="${data.message.id}"><i class="bi bi-trash me-2"></i>Delete</a></li>
                                         </ul>
                                    </div>
                                </div>
                            </div>
                        `;
                        chatBox.appendChild(msgDiv);
                        chatBox.scrollTop = chatBox.scrollHeight;
                        this.value = ''; // Reset input
                    } else {
                        alert('Upload failed: ' + (data.error || 'Unknown error'));
                    }
                })
                .catch(error => console.error('Error:', error));
            }
        });
    }

    // Emoji Picker Handling
    const emojiBtn = document.getElementById('emoji-btn');
    const emojiPicker = document.getElementById('emoji-picker');
    const closeEmojiPicker = document.getElementById('close-emoji-picker');
    const chatInput = document.getElementById('chat-input');

    if (emojiBtn && emojiPicker && closeEmojiPicker) {
        // Toggle emoji picker
        emojiBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            emojiPicker.style.display = emojiPicker.style.display === 'none' ? 'block' : 'none';
        });

        // Close button
        closeEmojiPicker.addEventListener('click', function() {
            emojiPicker.style.display = 'none';
        });

        // Close emoji picker when clicking outside
        document.addEventListener('click', function(e) {
            if (!emojiPicker.contains(e.target) && e.target !== emojiBtn) {
                emojiPicker.style.display = 'none';
            }
        });

        // Insert emoji into input
        document.querySelectorAll('.emoji-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const emoji = this.dataset.emoji;
                if (chatInput) { // Ensure chatInput exists
                    const cursorPos = chatInput.selectionStart;
                    const textBefore = chatInput.value.substring(0, cursorPos);
                    const textAfter = chatInput.value.substring(cursorPos);
                    
                    chatInput.value = textBefore + emoji + textAfter;
                    chatInput.focus();
                    
                    // Set cursor position after emoji
                    const newPos = cursorPos + emoji.length;
                    chatInput.setSelectionRange(newPos, newPos);
                }
            });
        });
    }

    // Message Actions (Edit/Delete) - Delegate from chatBox
    if (chatBox) {
        chatBox.addEventListener('click', function(e) {
            // Edit
            if (e.target.closest('.edit-msg-btn')) {
                e.preventDefault();
                const btn = e.target.closest('.edit-msg-btn');
                const msgId = btn.dataset.id;
                const contentSpan = document.getElementById(`msg-content-${msgId}`);
                const currentContent = contentSpan.innerText;
                
                const newContent = prompt('Edit message:', currentContent);
                if (newContent !== null && newContent.trim() !== '' && newContent !== currentContent) {
                    fetch('/chat/edit/' + msgId, {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ content: newContent })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === 'success') {
                            contentSpan.innerText = newContent;
                        }
                    });
                }
            }
            
            // Delete
            if (e.target.closest('.delete-msg-btn')) {
                e.preventDefault();
                if (confirm('Delete this message?')) {
                    const btn = e.target.closest('.delete-msg-btn');
                    const msgId = btn.dataset.id;
                    
                    fetch('/chat/delete/' + msgId, {
                        method: 'DELETE'
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === 'success') {
                            const container = document.getElementById(`msg-container-${msgId}`);
                            container.remove();
                        }
                    });
                }
            }
        });
    }
    {% endif %}
});
</script>
{% endblock %}

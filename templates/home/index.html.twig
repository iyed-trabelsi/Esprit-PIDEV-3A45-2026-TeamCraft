{% extends 'base.html.twig' %}

{% block title %}TEAMCRAFT - Build Your Legacy{% endblock %}

{% block body_class %}d-flex flex-column{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' with { transparent_nav: true } %}

    <section class="hero position-relative flex-grow-1 d-flex align-items-center justify-content-center text-center overflow-hidden" style="min-height: calc(100vh - 80px);">
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark" style="background: linear-gradient(rgba(15,15,18,0.85) 0%, rgba(15,15,18,0.7) 100%), url('{{ asset('images/home-page-background.jpeg') }}') center/cover no-repeat !important;"></div>
        <div class="container position-relative z-1 py-5">
            <p class="font-display text-uppercase mb-3" style="color: var(--tc-neon-green); font-size: 0.9rem; letter-spacing: 0.2em;">The future of esports recruiting</p>
            <h1 class="font-display display-3 fw-bold text-uppercase mb-4" style="line-height: 1.1;">
                Build Your<br>Legacy
            </h1>
            <p class="lead mx-auto mb-5" style="max-width: 520px; color: var(--tc-text); font-size: 1.15rem;">
                Connect with elite teams, showcase your stats, and sign the contract that changes your career.
            </p>
            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <a href="{{ path('app_signup') }}" class="btn btn-tc-primary btn-lg">Start Scouting</a>
                <a href="#" class="btn btn-tc-outline btn-lg">View Demo</a>
            </div>
        </div>
    </section>
{% endblock %}

{% extends 'backoffice/base.html.twig' %}

{% block admin_heading %}Gestion des offres{% endblock %}
{% block admin_subheading %}Liste de toutes les offres de recrutement avec leur jeu et statut.{% endblock %}

{% block admin_content %}
    <div class="discovery-filter-container mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-tc-outline text-uppercase fw-bold" style="border-radius: 8px; padding: 0.6rem 1.25rem; font-size: 0.85rem;">
                    <i class="bi bi-funnel me-1"></i> Filtrer
                </button>
                <button class="btn btn-tc-primary text-uppercase fw-bold" style="border-radius: 8px; padding: 0.6rem 1.25rem; font-size: 0.85rem;">
                    <i class="bi bi-plus-lg me-1"></i> Nouvelle offre
                </button>
            </div>

            <div class="discovery-search-wrapper" style="min-width: 300px;">
                <i class="bi bi-search discovery-search-icon"></i>
                <input type="search" class="form-control discovery-search-input" placeholder="Recherche par titre, équipe ou jeu">
            </div>
        </div>
    </div>

    <div class="card-tc p-0 overflow-hidden" style="background: var(--tc-bg-input);">
        <div class="table-responsive">
            <table class="table align-middle mb-0 text-white bg-input-match" style="font-size: 0.9rem;">
                <thead class="custom-table-header">
                    <tr>
                        <th class="border-0 px-4 py-3">Titre</th>
                        <th class="border-0 px-4 py-3">Équipe / Structure</th>
                        <th class="border-0 px-4 py-3">Jeu</th>
                        <th class="border-0 px-4 py-3">Statut</th>
                        <th class="border-0 px-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-input-match">
                    {% for offer in offers %}
                        <tr>
                            <td class="px-4 py-3 fw-semibold bg-input-match">{{ offer.title }}</td>
                            <td class="px-4 py-3 bg-input-match">{{ offer.team.name }}</td>
                            <td class="px-4 py-3 bg-input-match">{{ offer.game }}</td>
                            <td class="px-4 py-3 bg-input-match">
                                {% if offer.dateExpiration > date() %}
                                    <span class="badge-status badge-online">Active</span>
                                {% else %}
                                    <span class="badge-status bg-secondary">Expirée</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-end bg-input-match">


                                <a href="{{ path('app_offres_show', {'id': offer.id}) }}" class="action-btn view d-inline-block" title="Consulter">
                                    <img src="{{ asset('images/icons/crud-view.png') }}" alt="View">
                                </a>
                                <form method="post" action="{{ path('offer_delete', {'id': offer.id}) }}" onsubmit="return confirm('Are you sure you want to delete this offer?');" class="d-inline-block">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_offer_' ~ offer.id) }}">
                                    <input type="hidden" name="redirect" value="admin">
                                    <button type="submit" class="action-btn delete border-0 bg-transparent" title="Supprimer">
                                        <img src="{{ asset('images/icons/crud-delete.png') }}" alt="Delete">
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>

    <div class="d-flex justify-content-between align-items-center px-4 py-3 mt-3">
        <span class="small text-muted">Affichage de {{ offers|length }} sur {{ totalOffers }} offres</span>
        <nav aria-label="Pagination offres">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ path('admin_offers', {page: currentPage - 1}) }}">Précédent</a>
                </li>
                
                {% for i in 1..maxPages %}
                    <li class="page-item {{ currentPage == i ? 'active' : '' }}">
                        <a class="page-link" href="{{ path('admin_offers', {page: i}) }}">{{ i }}</a>
                    </li>
                {% endfor %}
                
                <li class="page-item {{ currentPage == maxPages ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ path('admin_offers', {page: currentPage + 1}) }}">Suivant</a>
                </li>
            </ul>
        </nav>
    </div>
{% endblock %}


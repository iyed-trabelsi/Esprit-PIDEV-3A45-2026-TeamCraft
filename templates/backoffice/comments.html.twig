{% extends 'backoffice/base.html.twig' %}

{% block admin_heading %}Gestion des commentaires{% endblock %}
{% block admin_subheading %}Liste de tous les commentaires du forum avec auteur et post.{% endblock %}

{% block admin_content %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="discovery-filter-container mb-4">
        <form method="get" action="{{ path('admin_comments') }}" class="d-flex flex-wrap justify-content-between align-items-center gap-3" id="comments-search-form">
            <input type="hidden" name="page" value="1">
            
            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button class="btn btn-tc-outline dropdown-toggle text-uppercase fw-bold" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 8px; padding: 0.6rem 1.25rem; font-size: 0.85rem;">
                        <i class="bi bi-sort-down me-1"></i>
                        {% if sort == 'date_asc' %}Anciennes d'abord
                        {% else %}Plus récents d'abord{% endif %}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item filter-link" href="{{ path('admin_comments', {q: q, sort: 'date_desc'}) }}" data-sort="date_desc">Date (récentes d'abord)</a></li>
                        <li><a class="dropdown-item filter-link" href="{{ path('admin_comments', {q: q, sort: 'date_asc'}) }}" data-sort="date_asc">Date (anciennes d'abord)</a></li>
                    </ul>
                </div>
                <input type="hidden" name="sort" id="sort-value-comments" value="{{ sort|default('date_desc') }}">
            </div>

            <div class="discovery-search-wrapper" style="min-width: 300px;">
                <i class="bi bi-search discovery-search-icon"></i>
                <input type="search" name="q" class="form-control discovery-search-input" placeholder="Rechercher dans le contenu…" value="{{ q|default('') }}">
            </div>
        </form>
    </div>
    <div id="comments-list-container">
        {% block comments_list %}
        <div class="card-tc p-0 overflow-hidden" style="background: var(--tc-bg-input);">
            <div class="table-responsive">
                <table class="table align-middle mb-0 text-white bg-input-match" style="font-size: 0.9rem;">
                    <thead class="custom-table-header">
                        <tr>
                            <th class="border-0 px-4 py-3">Contenu</th>
                            <th class="border-0 px-4 py-3">Auteur</th>
                            <th class="border-0 px-4 py-3">Rubrique</th>
                            <th class="border-0 px-4 py-3">Post</th>
                            <th class="border-0 px-4 py-3">Date</th>
                            <th class="border-0 px-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-input-match">
                        {% for comment in comments %}
                            <tr>
                                <td class="px-4 py-3 bg-input-match text-white-50" style="max-width: 280px;">{% set txt = comment.contenu %}{{ txt|length > 60 ? txt|slice(0, 60) ~ '…' : txt }}</td>
                                <td class="px-4 py-3 bg-input-match">{{ comment.auteur ? comment.auteur.pseudo : '—' }}</td>
                                <td class="px-4 py-3 bg-input-match">{{ comment.post and comment.post.rubrique ? comment.post.rubrique.nomRubrique : '—' }}</td>
                                <td class="px-4 py-3 bg-input-match">{{ comment.post ? comment.post.titre : '—' }}</td>
                                <td class="px-4 py-3 bg-input-match">{{ comment.dateCommentaire ? comment.dateCommentaire|date('d/m/Y') : '—' }}</td>
                                <td class="px-4 py-3 text-end bg-input-match">
                                    {% if comment.post %}
                                        <a href="{{ path('app_forum_post_show', { id: comment.post.id }) }}#comment-{{ comment.id }}" class="action-btn view d-inline-block" title="Voir le post">
                                            <img src="{{ asset('images/icons/crud-view.png') }}" alt="View">
                                        </a>
                                    {% endif %}
                                    <form method="post" action="{{ path('admin_comment_delete', { id: comment.id }) }}" onsubmit="return confirm('Supprimer ce commentaire ?');" class="d-inline-block">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_comment_delete_' ~ comment.id) }}">
                                        <button type="submit" class="action-btn delete border-0 bg-transparent" title="Supprimer">
                                            <img src="{{ asset('images/icons/crud-delete.png') }}" alt="Delete">
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="px-4 py-4 text-center text-white-50">Aucun commentaire.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center px-4 py-3 mt-3">
            <span class="small text-muted">Affichage de {{ comments|length }} sur {{ total }} commentaires</span>
            <nav aria-label="Pagination commentaires">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                        <a class="page-link" href="{{ path('admin_comments', { page: currentPage - 1, q: q|default(''), sort: sort|default('date_desc') }) }}">Précédent</a>
                    </li>
                    {% for i in 1..maxPages %}
                        <li class="page-item {{ currentPage == i ? 'active' : '' }}">
                            <a class="page-link" href="{{ path('admin_comments', { page: i, q: q|default(''), sort: sort|default('date_desc') }) }}">{{ i }}</a>
                        </li>
                    {% endfor %}
                    <li class="page-item {{ currentPage == maxPages ? 'disabled' : '' }}">
                        <a class="page-link" href="{{ path('admin_comments', { page: currentPage + 1, q: q|default(''), sort: sort|default('date_desc') }) }}">Suivant</a>
                    </li>
                </ul>
            </nav>
        </div>
        {% endblock %}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('comments-search-form');
            const listContainer = document.getElementById('comments-list-container');
            const input = form.querySelector('input[name="q"]');
            const sortSelect = form.querySelector('select[name="sort"]');
            let timeout = null;

            function updateList(url) {
                fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.text())
                .then(html => {
                    listContainer.innerHTML = html;
                    attachPaginationListeners();
                })
                .catch(error => console.error('Error:', error));
            }

            function attachListeners() {
                const paginationLinks = listContainer.querySelectorAll('.pagination a.page-link');
                paginationLinks.forEach(link => {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        updateList(this.href);
                    });
                });

                const filterLinks = document.querySelectorAll('.filter-link');
                filterLinks.forEach(link => {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        const url = buildUrlWithParams(this.href);
                        window.history.pushState({}, '', url);
                        updateList(url);
                    });
                });
            }

            function buildUrlWithParams(baseUri) {
                const url = new URL(baseUri, window.location.origin);
                const query = input.value;
                if (query) url.searchParams.set('q', query);
                return url.toString();
            }

            function buildUrl() {
                const url = new URL(form.action, window.location.origin);
                const query = input.value;
                const sortInput = form.querySelector('input[name="sort"]');
                const sort = sortInput ? sortInput.value : 'date_desc';
                if (query) url.searchParams.set('q', query);
                if (sort) url.searchParams.set('sort', sort);
                return url.toString();
            }

            if (input) {
                input.addEventListener('input', function() {
                    clearTimeout(timeout);
                    timeout = setTimeout(function() {
                        form.querySelector('input[name="page"]').value = '1';
                        const url = buildUrl();
                        window.history.pushState({}, '', url);
                        updateList(url);
                    }, 350);
                });
            }

            attachListeners();
        });
    </script>
{% endblock %}

{{ form_start(form, { attr: { novalidate: 'novalidate', 'data-turbo': 'false', enctype: 'multipart/form-data' } }) }}
    {{ form_errors(form) }}
    <div class="admin-form-widgets">
        
        <!-- AI Suggestion Area -->
        <div class="mb-4">
            <button type="button" id="ai-generate-btn-back" class="btn btn-outline-info w-100 py-2 fw-bold" style="border-radius: 8px; border-width: 2px;">
                <i class="bi bi-magic me-2"></i>Suggérer le moment optimal avec l'IA
            </button>
            <!-- Hidden button for details, appears after generation -->
            <button type="button" id="ai-details-btn-back" class="btn btn-sm text-info w-100 mt-2 d-none d-flex align-items-center justify-content-center gap-1" style="background: transparent; border: none; text-decoration: underline;" data-bs-toggle="modal" data-bs-target="#aiDetailsModalBack">
                <i class="bi bi-info-circle"></i> Voir les détails de la génération
            </button>
        </div>

        <!-- AI Details Modal -->
        <div class="modal fade" id="aiDetailsModalBack" tabindex="-1" aria-labelledby="aiDetailsModalBackLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark text-light" style="border: 1px solid rgba(13, 202, 240, 0.3);">
                    <div class="modal-header border-secondary border-opacity-25">
                        <h5 class="modal-title" id="aiDetailsModalBackLabel"><i class="bi bi-robot text-info me-2"></i>Rapport d'Intelligence Artificielle</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info bg-transparent border-0 p-0 m-0" style="color: rgba(255,255,255,0.9);">
                            <span id="ai-reasoning-text-back"></span>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="mb-4">
            {{ form_label(form.nomEvenement, 'Nom de l\'événement', { 'label_attr': {'class': 'form-label fw-bold'} }) }}
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-tag"></i></span>
                {{ form_widget(form.nomEvenement, { 'attr': {'class': 'form-control', 'placeholder': 'Ex: Tournoi Valorant 2024'} }) }}
            </div>
            {{ form_errors(form.nomEvenement) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.typeEvenement, 'Type d\'événement', { 'label_attr': {'class': 'form-label fw-bold'} }) }}
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-layers"></i></span>
                {{ form_widget(form.typeEvenement, { 'attr': {'class': 'form-control', 'placeholder': 'Ex: Compétition, Social, etc.'} }) }}
            </div>
            {{ form_errors(form.typeEvenement) }}
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                {{ form_label(form.dateDebut, 'Date de début', { 'label_attr': {'class': 'form-label fw-bold'} }) }}
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-calendar-check"></i></span>
                    {{ form_widget(form.dateDebut, { 'attr': {'class': 'form-control'} }) }}
                </div>
                {{ form_errors(form.dateDebut) }}
            </div>
            <div class="col-md-6 mb-4">
                {{ form_label(form.dateFin, 'Date de fin', { 'label_attr': {'class': 'form-label fw-bold'} }) }}
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-calendar-x"></i></span>
                    {{ form_widget(form.dateFin, { 'attr': {'class': 'form-control'} }) }}
                </div>
                {{ form_errors(form.dateFin) }}
            </div>
        </div>

        <div class="mb-4">
            {{ form_label(form.status, 'Statut', { 'label_attr': {'class': 'form-label fw-bold'} }) }}
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-info-circle"></i></span>
                {{ form_widget(form.status, { 'attr': {'class': 'form-select'} }) }}
            </div>
            <div class="form-text mt-1" style="color: rgba(255, 255, 255, 0.9) !important;">Choisissez si l'événement est ouvert ou fermé aux inscriptions.</div>
            {{ form_errors(form.status) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.place, 'Lieu / Place', { 'label_attr': {'class': 'form-label fw-bold'} }) }}
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-geo-alt"></i></span>
                {{ form_widget(form.place, { 'attr': {'class': 'form-select'} }) }}
            </div>
            {{ form_errors(form.place) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.imageFile, 'Image de l\'événement (facultatif)', { 'label_attr': {'class': 'form-label fw-bold'} }) }}
            {% if evenement is defined and evenement.imageEvenement %}
                <div class="mb-2 d-flex align-items-center gap-3">
                    <img src="{{ asset('uploads/events/' ~ evenement.imageEvenement) }}"
                         alt="Image actuelle"
                         style="height: 80px; width: 120px; object-fit: cover; border-radius: 8px; border: 1px solid rgba(255,255,255,0.15);">
                    <span class="text-muted small"><i class="bi bi-image me-1"></i>Image actuelle — remplacez-la en téléchargeant une nouvelle ci-dessous.</span>
                </div>
            {% endif %}
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-image"></i></span>
                {{ form_widget(form.imageFile, { 'attr': {'class': 'form-control', 'accept': 'image/jpeg,image/png,image/webp'} }) }}
            </div>
            <div class="form-text mt-1" style="color: rgba(255, 255, 255, 0.6) !important;">Formats acceptés : jpeg, png, webp — Taille max : 3 Mo.</div>
            {{ form_errors(form.imageFile) }}
        </div>
    </div>
    
    <div class="mt-4 pt-2">
        <button type="submit" class="btn btn-tc-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-check-circle"></i>
            <span>{{ button_label|default('Enregistrer les modifications') }}</span>
        </button>
    </div>
{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnBack = document.getElementById('ai-generate-btn-back');
    if (btnBack) {
        btnBack.addEventListener('click', function(e) {
            e.preventDefault();
            const originalText = btnBack.innerHTML;
            btnBack.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Analyse historique en cours...';
            btnBack.disabled = true;

            fetch('/api/events/ai-generate')
                .then(res => res.json())
                .then(response => {
                    if (response.success && response.data) {
                        const data = response.data;
                        const nomInput = document.querySelector('[id$="_nomEvenement"]');
                        const typeInput = document.querySelector('[id$="_typeEvenement"]');
                        const debutInput = document.querySelector('[id$="_dateDebut"]');
                        const finInput = document.querySelector('[id$="_dateFin"]');
                        
                        if (data.nomEvenement && nomInput) nomInput.value = data.nomEvenement;
                        if (data.typeEvenement && typeInput) typeInput.value = data.typeEvenement;
                        if (data.dateDebut && debutInput) debutInput.value = data.dateDebut;
                        if (data.dateFin && finInput) finInput.value = data.dateFin;
                        
                        const detailsBtn = document.getElementById('ai-details-btn-back');
                        const reasoningText = document.getElementById('ai-reasoning-text-back');
                        
                        if (detailsBtn && reasoningText) {
                            reasoningText.innerText = data.reasoning || "Optimisé par l'IA";
                            detailsBtn.classList.remove('d-none');
                            // Automatically open the modal for the user to see the details
                            const modalElement = document.getElementById('aiDetailsModalBack');
                            if (modalElement) {
                                const aiModal = new bootstrap.Modal(modalElement);
                                aiModal.show();
                            }
                        }
                    }
                })
                .catch(err => console.error("AI Fetch Error: ", err))
                .finally(() => {
                    btnBack.innerHTML = originalText;
                    btnBack.disabled = false;
                });
        });
    }
});
</script>

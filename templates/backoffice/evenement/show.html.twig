{% extends 'backoffice/base.html.twig' %}

{% block admin_heading %}Détails de l'événement{% endblock %}
{% block admin_subheading %}Informations complètes sur l'événement.{% endblock %}

{% block admin_content %}
    <div class="mb-3">
        <a href="{{ path('admin_events') }}" class="btn btn-sm btn-tc-outline">
            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
        </a>
    </div>

    <div class="card-tc p-4" style="background: var(--tc-bg-input);">
        <h3 class="mb-4 text-white">{{ evenement.nomEvenement }}</h3>
        
        <table class="table table-borderless text-white" style="max-width: 600px;">
            <tbody>
                <tr>
                    <th class="text-white-50" style="width: 150px;">Id</th>
                    <td>{{ evenement.id }}</td>
                </tr>
                <tr>
                    <th class="text-white-50">Nom</th>
                    <td>{{ evenement.nomEvenement }}</td>
                </tr>
                <tr>
                    <th class="text-white-50">Type</th>
                    <td>{{ evenement.typeEvenement }}</td>
                </tr>
                <tr>
                    <th class="text-white-50">Début</th>
                    <td>{{ evenement.dateDebut ? evenement.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th class="text-white-50">Fin</th>
                    <td>{{ evenement.dateFin ? evenement.dateFin|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th class="text-white-50">Statut</th>
                    <td>{{ evenement.status }}</td>
                </tr>
                <tr>
                    <th class="text-white-50">Lieu</th>
                    <td>{{ evenement.place ? evenement.place.nomPlace : 'Non défini' }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-4 d-flex gap-2">
            <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-tc-primary">
                <i class="bi bi-pencil me-1"></i> Modifier
            </a>
            {{ include('backoffice/evenement/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}


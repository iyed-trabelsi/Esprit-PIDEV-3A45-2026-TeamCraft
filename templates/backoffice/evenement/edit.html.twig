{% extends 'backoffice/base.html.twig' %}

{% block admin_heading %}Modifier l'événement{% endblock %}
{% block admin_subheading %}Mettre à jour les informations de l'événement.{% endblock %}

{% block admin_content %}
    <div class="mb-3">
        <a href="{{ path('admin_events') }}" class="btn btn-sm btn-tc-outline">
            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
        </a>
    </div>

    <div class="card-tc p-4" style="background: var(--tc-bg-input); max-width: 800px;">
        {{ include('backoffice/evenement/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        
        <div class="mt-3">
            {{ include('backoffice/evenement/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}


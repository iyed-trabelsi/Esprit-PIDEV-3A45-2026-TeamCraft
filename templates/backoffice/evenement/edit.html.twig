{% extends 'backoffice/base.html.twig' %}

{% block admin_heading %}Modifier l'événement{% endblock %}
{% block admin_subheading %}Mettre à jour les informations de l'événement.{% endblock %}

{% block admin_content %}
    <div class="mb-4">
        <a href="{{ path('admin_events') }}" class="btn btn-sm btn-tc-outline d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i> Retour à la liste
        </a>
    </div>

    <div class="card-tc p-4 p-md-5 mx-auto" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 1rem; max-width: 900px; backdrop-filter: blur(10px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);">
        <div class="mb-4 border-bottom border-secondary pb-3 d-flex justify-content-between align-items-center">
            <h2 class="h5 text-info mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square"></i> Modification
            </h2>
            <span class="badge bg-dark border border-secondary text-secondary-emphasis">ID: #{{ evenement.id }}</span>
        </div>

        {{ include('backoffice/evenement/_form.html.twig', {'button_label': 'Mettre à jour l\'événement'}) }}
        
        <div class="mt-5 pt-4 border-top border-secondary">
            <p class="text-danger-emphasis small mb-3"><i class="bi bi-exclamation-triangle me-1"></i> Zone de danger - Cette action est irréversible</p>
            {{ include('backoffice/evenement/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}


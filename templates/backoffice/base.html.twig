{% extends 'frontoffice/base.html.twig' %}

{% block title %}Admin - TeamCraft{% endblock %}

{% block body_class %}d-flex flex-column{% endblock %}


{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* Force Dark Tabs */
        .nav-tabs {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .nav-tabs .nav-link {
            color: rgba(255,255,255,0.6);
            border: none;
            background: transparent !important;
            font-weight: 500;
            padding: 0.75rem 1.5rem;
            transition: all 0.2s;
        }
        .nav-tabs .nav-link:hover {
            color: white;
            border-color: transparent;
            isolation: isolate;
        }
        .nav-tabs .nav-link.active {
            color: var(--tc-cyan) !important; /* Cyan text for active */
            background-color: rgba(30, 41, 59, 0.8) !important; /* Dark Blue Slate bg */
            border-bottom: 2px solid var(--tc-cyan) !important;
            font-weight: 600;
        }
        
        /* Force Dark Form Inputs */
        .form-control, .form-select, input, select, textarea {
            background-color: #0f172a !important; /* Dark Slate 900 */
            border: 1px solid #334155 !important;
            color: white !important;
        }
        .form-control:focus, .form-select:focus, input:focus, select:focus, textarea:focus {
            background-color: #0f172a !important;
            border-color: var(--tc-cyan) !important;
            color: white !important;
            box-shadow: 0 0 0 0.25rem rgba(6, 182, 212, 0.25) !important;
        }
        label {
            color: #e2e8f0 !important; /* Slate 200 */
            margin-bottom: 0.5rem;
        }
        
        /* Placeholder styling */
        ::placeholder {
            color: rgba(255, 255, 255, 0.4) !important;
        }
        /* Erreurs de validation : affichées uniquement après soumission, sous chaque champ */
        .admin-form-widgets .mb-3 ul {
            list-style: none;
            padding: 0;
            margin: 0.35rem 0 0 0;
            font-size: 0.875rem;
            color: #f87171;
        }
        .admin-form-widgets .mb-3 ul li {
            margin-top: 0.15rem;
        }
    </style>
{% endblock %}


{% block body %}
    <div class="d-flex flex-grow-1" style="min-height: 100vh;">
        {# Sidebar #}
        <aside class="admin-sidebar d-flex flex-column p-4">
            <div class="mb-5 d-flex justify-content-center w-100">
                <a href="{{ path('admin_dashboard') }}" class="text-decoration-none">
                    <img src="{{ asset('images/logo1.png') }}" alt="TEAMCRAFT" height="85">
                </a>
            </div>

            <nav class="nav flex-column small">
                <!-- GÉNÉRAL -->
                <span class="text-uppercase text-white mb-3 px-3" style="font-size: 0.7rem; letter-spacing: 0.12em;">Général</span>
                
                <a href="{{ path('admin_dashboard') }}" 
                   class="nav-link py-2 px-3 mb-1 rounded-2 d-flex align-items-center gap-3 {% if app.request.attributes.get('_route') starts with 'admin_dashboard' %}active{% else %}text-white-50{% endif %}">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
                <a href="{{ path('app_home') }}" 
                   class="nav-link py-2 px-3 mb-1 rounded-2 d-flex align-items-center gap-3 text-white-50">
                    <i class="bi bi-house-door"></i>
                    <span>Home</span>
                </a>

                <!-- GESTION -->
                <span class="text-uppercase text-white mt-4 mb-3 px-3" style="font-size: 0.7rem; letter-spacing: 0.12em;">Gestion</span>
                
                <a href="{{ path('admin_players') }}" 
                   class="nav-link py-2 px-3 mb-1 rounded-2 d-flex align-items-center gap-3 {% if app.request.attributes.get('_route') starts with 'admin_players' %}active{% else %}text-white-50{% endif %}">
                    <i class="bi bi-people"></i>
                    <span>Joueurs</span>
                </a>
                
                <a href="{{ path('admin_teams') }}" 
                   class="nav-link py-2 px-3 mb-1 rounded-2 d-flex align-items-center gap-3 {% if app.request.attributes.get('_route') starts with 'admin_teams' %}active{% else %}text-white-50{% endif %}">
                    <i class="bi bi-shield"></i>
                    <span>Équipes</span>
                </a>
                
                <a href="{{ path('admin_offers') }}" 
                   class="nav-link py-2 px-3 mb-1 rounded-2 d-flex align-items-center gap-3 {% if app.request.attributes.get('_route') starts with 'admin_offers' %}active{% else %}text-white-50{% endif %}">
                   <i class="bi bi-briefcase"></i>
                    <span>Offres</span>
                </a>
                
                <a href="{{ path('admin_events') }}" 
                   class="nav-link py-2 px-3 mb-1 rounded-2 d-flex align-items-center gap-3 {% if app.request.attributes.get('_route') starts with 'admin_events' %}active{% else %}text-white-50{% endif %}">
                    <i class="bi bi-calendar-event"></i>
                    <span>Événements</span>
                </a>
                
                <a href="{{ path('admin_rubriques') }}" 
                   class="nav-link py-2 px-3 mb-1 rounded-2 d-flex align-items-center gap-3 {% if app.request.attributes.get('_route') starts with 'admin_rubriques' %}active{% else %}text-white-50{% endif %}">
                    <i class="bi bi-folder"></i>
                    <span>Rubriques</span>
                </a>
                <a href="{{ path('admin_posts') }}" 
                   class="nav-link py-2 px-3 mb-1 rounded-2 d-flex align-items-center gap-3 {% if app.request.attributes.get('_route') starts with 'admin_posts' %}active{% else %}text-white-50{% endif %}">
                    <i class="bi bi-chat-left-text"></i>
                    <span>Posts</span>
                </a>
                <a href="{{ path('admin_comments') }}" 
                   class="nav-link py-2 px-3 mb-1 rounded-2 d-flex align-items-center gap-3 {% if app.request.attributes.get('_route') starts with 'admin_comments' %}active{% else %}text-white-50{% endif %}">
                    <i class="bi bi-chat-dots"></i>
                    <span>Commentaires</span>
                </a>

                <span class="text-uppercase text-white mt-4 mb-3 px-3" style="font-size: 0.7rem; letter-spacing: 0.12em;">Administration</span>
                <a href="{{ path('admin_admins') }}" 
                   class="nav-link py-2 px-3 mb-1 rounded-2 d-flex align-items-center gap-3 {% if app.request.attributes.get('_route') starts with 'admin_admins' %}active{% else %}text-white-50{% endif %}">
                    <i class="bi bi-person-gear"></i>
                    <span>Admins</span>
                </a>
                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-tc-outline-danger d-flex align-items-center gap-2 ms-2">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="d-none d-md-inline">Déconnexion</span>
                </a>
            </nav>
        </aside>

        {# Main content #}
        <main class="flex-grow-1 p-4 p-lg-5" style="background: radial-gradient(circle at top left, rgba(56,189,248,0.16), transparent 55%), radial-gradient(circle at bottom right, rgba(34,197,94,0.12), transparent 55%);">
            <header class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h4 mb-1 font-display text-uppercase" style="letter-spacing: 0.16em;">
                        {% block admin_heading %}Dashboard{% endblock %}
                    </h1>
                    <p class="text-white small mb-0">
                        {% block admin_subheading %}Vue de supervision globale.{% endblock %}
                    </p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    {% if app.user %}
                        <div class="d-flex align-items-center gap-2">
                            <div class="text-end d-none d-sm-block">
                                <div class="fw-semibold small">{{ app.user.pseudo }}</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Admin</div>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: #1e293b; border: 2px solid var(--tc-cyan);">
                                <span class="fw-bold" style="font-size: 0.85rem;">{{ app.user.pseudo|first|upper }}</span>
                            </div>

                        </div>
                    {% endif %}
                </div>
            </header>

            {% block admin_content %}{% endblock %}
        </main>
    </div>
{% endblock %}


{% extends 'backoffice/base.html.twig' %}

{% block admin_heading %}Détails du lieu{% endblock %}
{% block admin_subheading %}Informations complètes sur le lieu.{% endblock %}

{% block admin_content %}
    <div class="mb-3">
        <a href="{{ path('admin_events') }}" class="btn btn-sm btn-tc-outline">
            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
        </a>
    </div>

    <div class="card-tc p-4" style="background: var(--tc-bg-input);">
        <h3 class="mb-4 text-white">{{ place.nomPlace }}</h3>
        
        <table class="table table-borderless text-white" style="max-width: 600px;">
            <tbody>
                <tr>
                    <th class="text-white-50" style="width: 150px;">Id</th>
                    <td>{{ place.id }}</td>
                </tr>
                <tr>
                    <th class="text-white-50">Nom</th>
                    <td>{{ place.nomPlace }}</td>
                </tr>
                <tr>
                    <th class="text-white-50">Type</th>
                    <td>{{ place.typePlace }}</td>
                </tr>
                <tr>
                    <th class="text-white-50">Adresse</th>
                    <td>{{ place.adresse }}</td>
                </tr>
                <tr>
                    <th class="text-white-50">Capacité Max</th>
                    <td>{{ place.capaciteMax }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-4 d-flex gap-2">
            <a href="{{ path('app_place_edit', {'id': place.id}) }}" class="btn btn-tc-primary">
                <i class="bi bi-pencil me-1"></i> Modifier
            </a>
            {{ include('backoffice/place/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}


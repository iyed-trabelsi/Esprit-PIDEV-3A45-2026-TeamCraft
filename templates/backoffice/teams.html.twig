{% extends 'backoffice/base.html.twig' %}

{% block admin_heading %}Gestion des équipes{% endblock %}
{% block admin_subheading %}Liste des équipes, jeux associés, niveaux et statuts.{% endblock %}

{% block admin_content %}
    <div class="discovery-filter-container mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button class="btn btn-tc-outline dropdown-toggle text-uppercase fw-bold" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 8px; padding: 0.6rem 1.25rem; font-size: 0.85rem;">
                        <i class="bi bi-funnel me-1"></i> 
                        {% set current_sort = app.request.query.get('sort') %}
                        {% set current_game = app.request.query.get('game') %}
                        {% if current_sort == 'name_asc' %}Nom (A -> Z)
                        {% elseif current_sort == 'name_desc' %}Nom (Z -> A)
                        {% elseif current_game == 'valorant' %}Valorant
                        {% elseif current_game == 'lol' %}LoL
                        {% elseif current_game == 'wow' %}WoW
                        {% elseif current_game == 'csgo' %}CS:GO / CS2
                        {% elseif current_game == 'overwatch' %}Overwatch
                        {% elseif current_game == 'fortnite' %}Fortnite
                        {% else %}Filtrer / Trier{% endif %}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark shadow" style="background: var(--tc-bg-card); border-color: var(--tc-border);">
                        <li><h6 class="dropdown-header text-uppercase small text-muted">Trier par</h6></li>
                        <li><a class="dropdown-item filter-link {{ current_sort == 'name_asc' ? 'active' : '' }}" href="#" data-filter-type="sort" data-filter-value="name_asc">Nom (A -> Z)</a></li>
                        <li><a class="dropdown-item filter-link {{ current_sort == 'name_desc' ? 'active' : '' }}" href="#" data-filter-type="sort" data-filter-value="name_desc">Nom (Z -> A)</a></li>
                        <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                        <li><h6 class="dropdown-header text-uppercase small text-muted">Par Jeu</h6></li>
                        <li><a class="dropdown-item filter-link {{ current_game == 'valorant' ? 'active' : '' }}" href="#" data-filter-type="game" data-filter-value="valorant">Valorant</a></li>
                        <li><a class="dropdown-item filter-link {{ current_game == 'lol' ? 'active' : '' }}" href="#" data-filter-type="game" data-filter-value="lol">League of Legends</a></li>
                        <li><a class="dropdown-item filter-link {{ current_game == 'wow' ? 'active' : '' }}" href="#" data-filter-type="game" data-filter-value="wow">World of Warcraft</a></li>
                        <li><a class="dropdown-item filter-link {{ current_game == 'csgo' ? 'active' : '' }}" href="#" data-filter-type="game" data-filter-value="csgo">CS:GO / CS2</a></li>
                        <li><a class="dropdown-item filter-link {{ current_game == 'overwatch' ? 'active' : '' }}" href="#" data-filter-type="game" data-filter-value="overwatch">Overwatch</a></li>
                        <li><a class="dropdown-item filter-link {{ current_game == 'fortnite' ? 'active' : '' }}" href="#" data-filter-type="game" data-filter-value="fortnite">Fortnite</a></li>
                        <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                        <li><a class="dropdown-item text-danger small filter-link" href="#" data-filter-type="reset">Réinitialiser</a></li>
                    </ul>
                </div>
            </div>

            <div class="discovery-search-wrapper" style="min-width: 300px;">
                <i class="bi bi-search discovery-search-icon"></i>
                <input type="search" name="q" class="form-control discovery-search-input" placeholder="Rechercher par équipe ou jeu" value="{{ app.request.query.get('q') }}">
            </div>
        </div>
    </div>

    <div id="teams-list-container" style="transition: opacity 0.2s;">
        {% include 'backoffice/_teams_list.html.twig' %}
    </div>

    <!-- Modal Team Details -->
    <div class="modal fade" id="teamDetailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: var(--tc-bg-card); border: 1px solid var(--tc-border); color: #fff;">
                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title fw-bold">Détails de l'équipe</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <img id="modalTeamLogo" src="" alt="Team Logo" class="rounded-circle border border-primary p-1" style="width: 100px; height: 100px; object-fit: cover;">
                    </div>
                    <h3 id="modalTeamName" class="fw-bold mb-1"></h3>
                    <p id="modalTeamGames" class="text-info small text-uppercase fw-bold mb-4"></p>
                    
                    <div class="row g-3 text-start bg-black bg-opacity-25 p-3 rounded">
                        <div class="col-6">
                            <span class="text-white-50 small d-block">Créateur (Owner)</span>
                            <span id="modalTeamOwner" class="fw-semibold"></span>
                        </div>
                        <div class="col-6">
                            <span class="text-white-50 small d-block">Date de création</span>
                            <span id="modalTeamCreated" class="fw-semibold"></span>
                        </div>
                        <div class="col-12">
                            <span class="text-white-50 small d-block">Statut</span>
                            <span class="badge bg-success bg-opacity-25 text-success">Active</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary border-opacity-25">
                    <button type="button" class="btn btn-sm btn-outline-light" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Modal Logic
            var teamModal = document.getElementById('teamDetailsModal');
            if (teamModal) {
                teamModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    
                    var name = button.getAttribute('data-name');
                    var logo = button.getAttribute('data-logo');
                    var games = button.getAttribute('data-games');
                    var owner = button.getAttribute('data-owner');
                    var created = button.getAttribute('data-created');

                    teamModal.querySelector('#modalTeamName').textContent = name;
                    teamModal.querySelector('#modalTeamGames').textContent = games;
                    teamModal.querySelector('#modalTeamOwner').textContent = owner;
                    teamModal.querySelector('#modalTeamCreated').textContent = created;
                    
                    var logoImg = teamModal.querySelector('#modalTeamLogo');
                    if (logo) {
                        logoImg.src = logo;
                    } else {
                        logoImg.src = ''; 
                    }
                });
            }

            // AJAX Search logic
            const searchInput = document.querySelector('input[name="q"]');
            const listContainer = document.getElementById('teams-list-container');
            let debounceTimer;

            console.log('Admin Teams Script Loaded');

            if (searchInput && listContainer) {
                console.log('Search Input and List Container found');
                
                searchInput.addEventListener('input', function() {
                    const query = this.value;
                    const sort = new URL(window.location.href).searchParams.get('sort');
                    const game = new URL(window.location.href).searchParams.get('game');
                    
                    console.log('Input detected:', query);

                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        const url = new URL(window.location.href);
                        url.searchParams.set('q', query);
                        url.searchParams.set('page', 1); // Reset to page 1
                        if (sort) url.searchParams.set('sort', sort);
                        if (game) url.searchParams.set('game', game);
                        
                        // Add special param for controller detection
                        url.searchParams.set('ajax', '1');

                        console.log('Fetching:', url.toString());
                        fetchAndUpdate(url);
                    }, 300); // 300ms debounce
                });

                // Hijack pagination links
                listContainer.addEventListener('click', function(e) {
                    if (e.target.closest('.page-link')) {
                        e.preventDefault();
                        const link = e.target.closest('.page-link');
                        const url = new URL(link.href);
                        url.searchParams.set('ajax', '1');

                        console.log('Pagination Click:', url.toString());
                        fetchAndUpdate(url);
                    }
                });
            } else {
                console.error('Search Input or List Container NOT found');
            }

            // Filter dropdown handlers
            document.addEventListener('click', function(e) {
                if (e.target.closest('.filter-link')) {
                    e.preventDefault();
                    const link = e.target.closest('.filter-link');
                    const filterType = link.getAttribute('data-filter-type');
                    const filterValue = link.getAttribute('data-filter-value');

                    const url = new URL(window.location.href);
                    // Preserve current query
                    const currentQ = searchInput ? searchInput.value : '';
                    if (currentQ) url.searchParams.set('q', currentQ);
                    
                    if (filterType === 'reset') {
                        // Clear all filters
                        url.searchParams.delete('sort');
                        url.searchParams.delete('game');
                        url.searchParams.delete('q');
                        url.searchParams.set('page', 1);
                        if (searchInput) searchInput.value = '';
                    } else {
                        // Set the filter
                        url.searchParams.set(filterType, filterValue);
                        url.searchParams.set('page', 1);
                    }
                    
                    url.searchParams.set('ajax', '1');
                    fetchAndUpdate(url);
                }
            });

            // Shared fetch and update function
            function fetchAndUpdate(urlObj) {
                listContainer.style.opacity = '0.5'; // Visual feedback
                
                // Ensure ajax param is set
                urlObj.searchParams.set('ajax', '1');
                
                fetch(urlObj.toString(), {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.text();
                })
                .then(html => {
                    console.log('Received HTML length:', html.length);
                    listContainer.innerHTML = html;
                    listContainer.style.opacity = '1';
                    
                    // Update browser URL (remove ajax param for history)
                    const historyUrl = new URL(urlObj);
                    historyUrl.searchParams.delete('ajax');
                    window.history.pushState({}, '', historyUrl);
                })
                .catch(err => {
                    console.error('Error fetching teams:', err);
                    listContainer.style.opacity = '1';
                });
            }
        });
    </script>
{% endblock %}


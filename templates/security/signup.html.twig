{% extends 'base.html.twig' %}

{% block title %}Sign Up - TEAMCRAFT{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}

    <section class="position-relative flex-grow-1 d-flex align-items-center py-5" style="min-height: calc(100vh - 80px); background: linear-gradient(rgba(15,15,18,0.88) 0%, rgba(15,15,18,0.82) 100%), url('{{ asset('images/home-page-background.jpeg') }}') center/cover no-repeat;">
        <div class="container position-relative z-1">
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="card card-tc p-4 p-md-5">
                        <h2 class="text-center fw-bold mb-4">Sign Up</h2>
                        <form method="post" class="form-tc" action="{{ path('app_signup') }}">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email Address</label>
                                <input type="email" name="email" id="email" class="form-control" placeholder="you@example.com" required>
                            </div>
                            <div class="mb-3">
                                <label for="username" class="form-label">Username</label>
                                <input type="text" name="username" id="username" class="form-control" placeholder="Choose a username" required>
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" name="password" id="password" class="form-control" placeholder="••••••••" required>
                            </div>
                            <div class="mb-3">
                                <label for="confirm_password" class="form-label">Confirm Password</label>
                                <input type="password" name="confirm_password" id="confirm_password" class="form-control" placeholder="••••••••" required>
                            </div>
                            <div class="mb-4">
                                <label for="role" class="form-label">Role</label>
                                <select name="role" id="role" class="form-select">
                                    <option value="">Select your role</option>
                                    <option value="player">Player</option>
                                    <option value="team">Team / Scout</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-tc-primary w-100 py-3">Sign Up</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {% include 'partials/_footer.html.twig' %}
{% endblock %}
